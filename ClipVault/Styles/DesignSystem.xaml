    <SolidColorBrush x:Key="SegmentedActiveBorderBrush" Color="#363640"/>
    <SolidColorBrush x:Key="CodeKeyBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="CodeStrBrush" Color="#FB923C"/>
    <SolidColorBrush x:Key="CodeBraceBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="CodeNumBrush" Color="#A78BFA"/>

