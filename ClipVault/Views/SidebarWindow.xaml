                                    </RadioButton>
                                    <RadioButton x:Name="RadioThemeSunset2" GroupName="SideTheme" Checked="ThemeRadio_Checked" Tag="Sunset" Margin="2" Style="{StaticResource ThemeCardRadioStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#F97316" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="TxtThemeSunsetShort2" Text="暮色" FontSize="11"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="RadioThemeOcean2" GroupName="SideTheme" Checked="ThemeRadio_Checked" Tag="Ocean" Margin="2" Style="{StaticResource ThemeCardRadioStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#0EA5E9" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="TxtThemeOceanShort2" Text="深海" FontSize="11"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="RadioThemeCustom2" GroupName="SideTheme" Checked="ThemeRadio_Checked" Tag="CustomImage" Margin="2" Style="{StaticResource ThemeCardRadioStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#8B5CF6" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="TxtThemeCustomShort2" Text="壁纸" FontSize="11"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>

                                <!-- 自定义壁纸选项 -->
