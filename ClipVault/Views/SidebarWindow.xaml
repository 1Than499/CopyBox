                                            <Ellipse Width="8" Height="8" Fill="#F5F5F7" Stroke="#A1A1AA" StrokeThickness="1" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="TxtThemeLightShort2" Text="浅色" FontSize="11"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="RadioThemeAurora2" GroupName="SideTheme" Checked="ThemeRadio_Checked" Tag="Aurora" Margin="2" Style="{StaticResource ThemeCardRadioStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="TxtThemeAuroraShort2" Text="极光" FontSize="11"/>
