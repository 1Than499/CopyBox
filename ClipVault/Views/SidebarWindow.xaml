                                        <TextBlock x:Name="TxtCustomBgPath" Text="内置壁纸" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
