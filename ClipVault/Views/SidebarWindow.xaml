                                        </Grid>
                                        <DockPanel Margin="0,2,0,2">
                                            <TextBlock x:Name="TxtBgOverlayOpacityVal" DockPanel.Dock="Right" Text="75%" FontSize="10.5" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="遮罩" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Slider x:Name="SliderBgOverlayOpacity" Style="{StaticResource ModernFluentSliderStyle}" Minimum="30" Maximum="95" Value="75" SmallChange="5" LargeChange="10" ValueChanged="SliderBgOverlayOpacity_ValueChanged"/>
