<Window x:Class="ClipVault.Views.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:ClipVault.Helpers"
        mc:Ignorable="d"
        Title="CopyBox"
        Width="372"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 初始中性炭黑色板（由 ThemePalette.Apply 实时接管） -->
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#F0111114"/>
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#27272E"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#F4141418"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#18181C"/>
        <SolidColorBrush x:Key="CardHoverBgBrush" Color="#232329"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#27272E"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E96"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TileBgBrush" Color="#18181C"/>
        <SolidColorBrush x:Key="TileHoverBgBrush" Color="#232329"/>
        <SolidColorBrush x:Key="TabContainerBgBrush" Color="#151519"/>
        <SolidColorBrush x:Key="CodeBoxBgBrush" Color="#121216"/>
        <SolidColorBrush x:Key="CodeTextBrush" Color="#A1E3CB"/>
        <SolidColorBrush x:Key="SliderTrackBgBrush" Color="#32323A"/>
        <SolidColorBrush x:Key="ScratchpadInputBgBrush" Color="#121216"/>
        <SolidColorBrush x:Key="ScratchpadInputBorderBrush" Color="#27272E"/>
        <SolidColorBrush x:Key="QueueBarBgBrush" Color="#232329"/>
        <SolidColorBrush x:Key="MenuBgBrush" Color="#FA18181C"/>
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#27272E"/>
        <SolidColorBrush x:Key="MenuTextBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="SelectedBorderBrush" Color="#3F3F48"/>
        <SolidColorBrush x:Key="HoverBgBrush" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="PressedBgBrush" Color="#24FFFFFF"/>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource SidebarBorderBrush}"
            BorderThickness="1,0,0,0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="DrawerTranslate" X="0" Y="0"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 自定义壁纸背景层 -->
            <Grid x:Name="BgImageContainer" Grid.RowSpan="3" Visibility="Collapsed">
                <Border x:Name="BdCustomBgClip" CornerRadius="14,0,0,14" ClipToBounds="True">
                    <Image x:Name="ImgCustomBg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="BdCustomBgOverlay" CornerRadius="14,0,0,14" Background="#0E0E12" Opacity="0.75"/>
            </Grid>

            <!-- ================= 顶栏 ================= -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="14,11,12,10">
                <StackPanel>
                    <!-- 常态顶栏 -->
                    <Grid x:Name="HeaderNormalBar" Margin="0,0,0,9">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource CardHoverBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconClipboard}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CopyBox" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAppVersion" Text="v3.9.0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.55" Margin="7,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnLanSync" Style="{StaticResource SidebarTopIconBtn}" Click="BtnLanSync_Click" ToolTip="局域网快传">
                                <Path Data="{StaticResource IconPhone}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                            <Button x:Name="BtnPin" Style="{StaticResource SidebarTopIconBtn}" Click="BtnPin_Click" ToolTip="固定窗口">
                                <TextBlock x:Name="TxtPinIcon" Text="&#xE840;" FontFamily="Segoe MDL2 Assets" FontSize="11.5"/>
                            </Button>
                            <Button x:Name="BtnSettings" Style="{StaticResource SidebarTopIconBtn}" Click="BtnSettings_Click" ToolTip="设置">
                                <Path Data="{StaticResource IconSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Stretch="Uniform" Width="12.5" Height="12.5"/>
                            </Button>
                            <Button x:Name="BtnClose" Style="{StaticResource SidebarTopIconBtn}" Click="BtnClose_Click" ToolTip="收起">
                                <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Width="10" Height="10"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 设置顶栏 -->
                    <Grid x:Name="HeaderSettingsBar" Margin="0,0,0,2" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnBackFromSettings" Style="{StaticResource SidebarTopIconBtn}" Click="BtnBackFromSettings_Click" Margin="0,0,6,0" ToolTip="返回">
                                <Path Data="{StaticResource IconBack}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform" Width="10" Height="10"/>
                            </Button>
                            <TextBlock x:Name="TxtSettingsHeaderTitle" Text="设置" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource SidebarTopIconBtn}" HorizontalAlignment="Right" Click="BtnBackFromSettings_Click" ToolTip="完成">
                            <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Width="10" Height="10"/>
                        </Button>
                    </Grid>

                    <!-- 分段切换栏 (Segmented Control) -->
                    <Border x:Name="TabSwitcherRow" Height="30" CornerRadius="7" Background="{DynamicResource TabContainerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="TabBtnClipboard" Grid.Column="0" Click="TabBtnClipboard_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TabHitArea" Background="Transparent" CornerRadius="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabHitArea" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid Background="Transparent">
                                    <Border x:Name="TabIndicatorClipboard" CornerRadius="5" Background="{DynamicResource SegmentedActiveBgBrush}" BorderBrush="{DynamicResource SegmentedActiveBorderBrush}" BorderThickness="1" IsHitTestVisible="False"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Path Data="{StaticResource IconClipboard}" Stroke="{Binding Foreground, ElementName=TxtTabBtnClipboard}" StrokeThickness="1.35" Stretch="Uniform" Width="11" Height="11" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtTabBtnClipboard" Text="剪贴板" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button x:Name="TabBtnSystem" Grid.Column="1" Click="TabBtnSystem_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TabHitArea" Background="Transparent" CornerRadius="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabHitArea" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid Background="Transparent">
                                    <Border x:Name="TabIndicatorSystem" CornerRadius="5" Background="{DynamicResource SegmentedActiveBgBrush}" BorderBrush="{DynamicResource SegmentedActiveBorderBrush}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Path Data="{StaticResource IconGrid}" Stroke="{Binding Foreground, ElementName=TxtTabBtnSystem}" StrokeThickness="1.35" Stretch="Uniform" Width="11" Height="11" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtTabBtnSystem" Text="快捷" FontSize="11.5" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ================= 核心内容区 ================= -->
            <Grid Grid.Row="1">

                <!-- 视图 1：剪贴板 -->
                <Grid x:Name="ClipboardViewPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="12,10,12,4">
                        <!-- 极简搜索框 -->
                        <Border Background="{DynamicResource TabContainerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Height="32">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" Stretch="Uniform" Width="12" Height="12" Margin="10,0,7,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtSearch" Grid.Column="1" Style="{x:Null}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         FontSize="12" VerticalContentAlignment="Center" Padding="0"
                                         TextChanged="TxtSearch_TextChanged" PreviewMouseDown="TxtSearch_PreviewMouseDown">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="Transparent" BorderThickness="0">
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                            </Border>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="搜索..." Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button x:Name="BtnClearSearch" Grid.Column="2" Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="22" Margin="0,0,4,0" Click="BtnClearSearch_Click" Visibility="Collapsed">
                                    <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Width="8.5" Height="8.5"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 分类筛选条 -->
                        <ScrollViewer x:Name="CategoryScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0" PreviewMouseWheel="CategoryScrollViewer_PreviewMouseWheel">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="RadioAll" Content="全部" IsChecked="True" Checked="Filter_Checked" Tag="all" GroupName="SidebarCategoryFilter" Style="{StaticResource FilterPillStyle}"/>
                                <RadioButton x:Name="RadioText" Content="文本" Checked="Filter_Checked" Tag="text" GroupName="SidebarCategoryFilter" Style="{StaticResource FilterPillStyle}"/>
                                <RadioButton x:Name="RadioImages" Content="图片" Checked="Filter_Checked" Tag="image" GroupName="SidebarCategoryFilter" Style="{StaticResource FilterPillStyle}"/>
                                <RadioButton x:Name="RadioCode" Content="代码" Checked="Filter_Checked" Tag="code" GroupName="SidebarCategoryFilter" Style="{StaticResource FilterPillStyle}"/>
                                <RadioButton x:Name="RadioPinned" Content="置顶" Checked="Filter_Checked" Tag="pinned" GroupName="SidebarCategoryFilter" Style="{StaticResource FilterPillStyle}"/>
                                <StackPanel x:Name="CustomTagsPillPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                <Button x:Name="BtnAddCustomTag" Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="22" Margin="2,0,0,0" Click="BtnAddCustomTag_Click" ToolTip="新建分组">
                                    <Path Data="{StaticResource IconPlus}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform" Width="10" Height="10"/>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 折叠极简 1 行便签入口（去外框） -->
                        <Border x:Name="ScratchpadCard" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,7,0,2" Padding="2,6,2,2">
                            <StackPanel>
                                <DockPanel Background="Transparent" LastChildFill="True" Cursor="Hand" MouseLeftButtonUp="ScratchpadHeader_Click">
                                    <Path Data="{StaticResource IconNote}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.35" Stretch="Uniform" Width="11" Height="11" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtScratchpadTitle" Text="便签" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button x:Name="BtnScratchpadCopy" Style="{StaticResource SidebarTopIconBtn}" Width="20" Height="20" ToolTip="复制" Click="BtnScratchpadCopy_Click">
                                            <Path Data="{StaticResource IconCopy}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10"/>
                                        </Button>
                                        <Button x:Name="BtnScratchpadClear" Style="{StaticResource SidebarTopIconBtn}" Width="20" Height="20" ToolTip="清空" Click="BtnScratchpadClear_Click">
                                            <Path Data="{StaticResource IconTrash}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10"/>
                                        </Button>
                                        <TextBlock x:Name="IconScratchpadToggle" Text="▸" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border x:Name="BdScratchpadInput" Visibility="Collapsed" Background="{DynamicResource ScratchpadInputBgBrush}" BorderBrush="{DynamicResource ScratchpadInputBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,6,0,2" Padding="7,5">
                                    <TextBox x:Name="TxtScratchpad" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             FontSize="11.5" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="120"
                                             VerticalScrollBarVisibility="Auto" PreviewMouseDown="TxtScratchpad_PreviewMouseDown" TextChanged="TxtScratchpad_TextChanged">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="Transparent" BorderThickness="0">
                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto"/>
                                                </Border>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 连续粘贴队列条 -->
                        <Border x:Name="PasteQueueBar" Visibility="Collapsed" Background="{DynamicResource QueueBarBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Margin="0,4,0,2" Padding="9,5">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="TxtQueueInfo" Text="队列 · 0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button x:Name="BtnPasteNextInQueue" Content="下一条" Style="{StaticResource PrimaryBtnStyle}" Padding="8,2.5" FontSize="10.5" Margin="0,0,4,0" Click="BtnPasteNextInQueue_Click"/>
                                    <Button x:Name="BtnClearQueue" Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="22" Click="BtnClearQueue_Click" ToolTip="清空">
                                        <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Width="9" Height="9"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- 卡片流（常态零按钮，Hover 浮现单色微操作） -->
                    <ListBox x:Name="CardsListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             Padding="12,2,12,8"
                             PreviewMouseLeftButtonDown="CardsListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="CardsListBox_PreviewMouseMove"
                             MouseDoubleClick="CardsListBox_MouseDoubleClick"
                             KeyDown="CardsListBox_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown"/>
                                <EventSetter Event="MouseRightButtonUp" Handler="ListBoxItem_MouseRightButtonUp"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardItemBorder"
                                                    Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,9"
                                                    Cursor="Hand"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardItemBorder" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                                    <Setter TargetName="CardItemBorder" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardItemBorder" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                                    <Setter TargetName="CardItemBorder" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 主体内容（第一视觉焦点） -->
                                    <Grid Grid.Row="1" Margin="0,0,0,6">
                                        <!-- 普通文本 + 可选色块 -->
                                        <DockPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" LastChildFill="True">
                                            <Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="3" Margin="0,2,7,0" VerticalAlignment="Top"
                                                    Background="{Binding ColorSwatchBrush}" BorderBrush="#44FFFFFF" BorderThickness="0.8"
                                                    Visibility="{Binding HasColorSwatch, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding DisplayContent}" FontSize="12.5" LineHeight="18" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>

                                        <!-- 代码块 -->
                                        <Border Background="{DynamicResource CodeBoxBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6"
                                                Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}" ClipToBounds="True">
                                            <TextBlock Text="{Binding DisplayContent}" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11" LineHeight="16"
                                                       Foreground="{DynamicResource CodeTextBrush}" TextWrapping="Wrap" MaxHeight="66" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <!-- 图片缩略图 -->
                                        <Border MaxHeight="92" CornerRadius="6" Background="{DynamicResource CodeBoxBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="3"
                                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" ClipToBounds="True">
                                            <Image Source="{Binding ImagePreview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>

                                    <!-- 极简底栏：常态只显来源/标签/时间与序号；Hover 显现操作图标 -->
                                    <Grid Grid.Row="2" MinHeight="20">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBlueBrush}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding SourceApp}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="115" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Text=" · " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" FontSize="10.5" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" VerticalAlignment="Center"/>

                                            <!-- 极克制单色次级标识（不刺眼、无彩框） -->
                                            <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasCustomTag, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding CustomTagBadgeText}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="4" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding ShowSensitiveBadge, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding SensitiveTypeTag}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="4" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsOcrKeywordMatched, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding OcrMatchedBadgeText}" FontSize="9.5" Foreground="{DynamicResource AccentBlueBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="4" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasTemplateMacro, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding TemplateMacroBadgeText}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- 常态右侧：安静的序号角标 -->
                                        <TextBlock x:Name="RestingBadge" Text="{Binding DisplayBadge}" FontSize="10" FontFamily="Cascadia Mono, Consolas"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.45"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 悬停右侧：干净的单色线性微操作栏 -->
                                        <StackPanel x:Name="HoverActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" Click="BtnToggleMask_Click" ToolTip="{Binding MaskToggleTooltip}"
                                                    Visibility="{Binding ShowSensitiveBadge, Converter={StaticResource BoolToVis}}">
                                                <Path Data="{StaticResource IconEye}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Stretch="Uniform" Width="11" Height="11"/>
                                            </Button>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" Click="BtnCardExtractOcr_Click" ToolTip="提取文字"
                                                    Visibility="{Binding HasOcrText, Converter={StaticResource BoolToVis}}">
                                                <Path Data="{StaticResource IconOcr}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Stretch="Uniform" Width="11" Height="11"/>
                                            </Button>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" Click="BtnCardPinScreen_Click" ToolTip="钉在屏幕上"
                                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                                <Path Data="{StaticResource IconPinScreen}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Stretch="Uniform" Width="11" Height="11"/>
                                            </Button>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" Click="BtnCardOpenUrl_Click" ToolTip="打开链接"
                                                    Visibility="{Binding IsUrl, Converter={StaticResource BoolToVis}}">
                                                <Path Data="{StaticResource IconLink}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Stretch="Uniform" Width="11" Height="11"/>
                                            </Button>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" Click="BtnCardCopy_Click" ToolTip="复制">
                                                <Path Data="{StaticResource IconCopy}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Stretch="Uniform" Width="10.5" Height="10.5"/>
                                            </Button>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" Click="BtnCardPin_Click" ToolTip="置顶">
                                                <Path Data="{StaticResource IconPin}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Stretch="Uniform" Width="10.5" Height="10.5"/>
                                            </Button>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" Click="BtnCardTag_Click" ToolTip="分组">
                                                <Path Data="{StaticResource IconTag}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Stretch="Uniform" Width="10.5" Height="10.5"/>
                                            </Button>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" Tag="{Binding Id}" Click="BtnCardMenu_Click" ToolTip="更多">
                                                <Path Data="{StaticResource IconMore}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform" Width="11" Height="11"/>
                                            </Button>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" Click="BtnCardDelete_Click" ToolTip="删除">
                                                <Path Data="{StaticResource IconTrash}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Stretch="Uniform" Width="10.5" Height="10.5"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 极简空状态 -->
                    <StackPanel x:Name="EmptyCardsStatePanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="TxtEmptyCategoryTip" Text="暂无内容" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 视图 2：快捷面板 -->
                <ScrollViewer x:Name="SystemActionsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,10,12,14">
                        <!-- 媒体控制卡（极简，无推广文案） -->
                        <Border x:Name="BdMediaCard" Style="{StaticResource SettingsGroupBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="7" Background="{DynamicResource TabContainerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="ImgMediaThumb" Stretch="UniformToFill" Visibility="Collapsed"/>
                                        <TextBlock x:Name="TxtMediaIconPlaceholder" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                    <DockPanel LastChildFill="True">
                                        <Border x:Name="BdMediaStatusTag" DockPanel.Dock="Right" Background="{DynamicResource HoverBgBrush}" CornerRadius="4" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtMediaStatusTag" Text="空闲" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <TextBlock x:Name="TxtMediaTitle" Text="媒体" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtMediaArtist" Text="未在播放" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnMediaPrev" Style="{StaticResource MediaCircleIconBtn}" Click="BtnMediaPrev_Click">
                                        <Path Data="M 3,3 L 5,3 L 5,13 L 3,13 Z M 13,3 L 5.5,8 L 13,13 Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="9.5" Height="9.5"/>
                                    </Button>
                                    <Button x:Name="BtnMediaPlayPause" Style="{StaticResource MediaCircleIconBtn}" Margin="2,0" Click="BtnMediaPlayPause_Click">
                                        <Grid>
                                            <Path x:Name="IconPlay" Data="M 4,2.5 L 13.5,8 L 4,13.5 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="10" Height="10" Margin="1,0,0,0"/>
                                            <Path x:Name="IconPause" Data="M 3,2.5 L 6,2.5 L 6,13.5 L 3,13.5 Z M 10,2.5 L 13,2.5 L 13,13.5 L 10,13.5 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="9.5" Height="9.5" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="BtnMediaNext" Style="{StaticResource MediaCircleIconBtn}" Click="BtnMediaNext_Click">
                                        <Path Data="M 13,3 L 11,3 L 11,13 L 13,13 Z M 3,3 L 10.5,8 L 3,13 Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="9.5" Height="9.5"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 系统快捷 -->
                        <TextBlock x:Name="TxtSectionCoreShortcuts" Text="系统" Style="{StaticResource SettingsSectionLabelStyle}"/>
                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,6">
                            <Button Style="{StaticResource ActionCenterTileStyle}" Margin="0,0,3,6" Click="TileWifi_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTileWifi" Text="网络" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TileBluetooth" Style="{StaticResource ActionCenterTileStyle}" Margin="3,0,0,6" Click="TileBluetooth_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTileBluetooth" Text="蓝牙" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionCenterTileStyle}" Margin="0,0,3,0" Click="TileSystemSettings_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTileSettings" Text="系统设置" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionCenterTileStyle}" Margin="3,0,0,0" Click="TileScreenClip_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTileScreenClip" Text="截图" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Button Style="{StaticResource ActionCenterTileStyle}" Height="46" Margin="0,0,3,0" Click="TileWinTheme_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTileWinTheme" Text="系统外观" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionCenterTileStyle}" Height="46" Margin="3,0,3,0" Click="TileMicMute_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTileMicIcon" Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTileMicMute" Text="麦克风" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionCenterTileStyle}" Height="46" Margin="3,0,0,0" Click="TileClearClipboard_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTileClearClip" Text="清空剪贴板" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- 自定义动作 -->
                        <DockPanel Margin="2,0,2,5">
                            <TextBlock x:Name="TxtSectionCustomActions" Text="动作" Style="{StaticResource SettingsSectionLabelStyle}" Margin="0"/>
                            <TextBlock x:Name="TxtTipRightClickDelete" Text="" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <WrapPanel x:Name="CustomActionsPanel" Margin="-3,0,-3,12">
                            <Button x:Name="BtnAddNewAction" Width="80" Height="56" Margin="3" Style="{StaticResource ActionCenterTileStyle}" Click="BtnAddNewAction_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBtnAddAction" Text="添加" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- 亮度与音量 -->
                        <Border Style="{StaticResource SettingsGroupBorderStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtBrightnessValue" DockPanel.Dock="Right" Text="--" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" PreviewMouseLeftButtonUp="TxtBrightnessIcon_Click">
                                        <TextBlock x:Name="TxtBrightnessIcon" Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBrightnessTitle" Text="亮度" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                                <Slider x:Name="SliderBrightness" Style="{StaticResource ModernFluentSliderStyle}" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" ValueChanged="SliderBrightness_ValueChanged" PreviewMouseWheel="SliderBrightness_MouseWheel"/>

                                <Border Style="{StaticResource SettingsHairlineStyle}"/>

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtVolumeValue" DockPanel.Dock="Right" Text="--" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" PreviewMouseLeftButtonUp="TxtVolumeIcon_Click">
                                        <TextBlock x:Name="TxtVolumeIcon" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtVolumeTitle" Text="音量" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                                <Slider x:Name="SliderVolume" Style="{StaticResource ModernFluentSliderStyle}" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" ValueChanged="SliderVolume_ValueChanged" PreviewMouseWheel="SliderVolume_MouseWheel"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 视图 3：极简分组设置（Apple Notes × Win11 ToggleSwitch） -->
                <ScrollViewer x:Name="SettingsViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,10,12,16">

                        <!-- 通用 -->
                        <TextBlock x:Name="TxtSetModeTitle" Text="通用" Style="{StaticResource SettingsSectionLabelStyle}"/>
                        <Border Style="{StaticResource SettingsGroupBorderStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadioModeSidebar2" Content="侧边栏" IsChecked="True" GroupName="SideWindowMode" Style="{StaticResource SegmentedRadioStyle}" Checked="WindowModeRadio_Checked"/>
                                            <RadioButton x:Name="RadioModeCentered2" Content="居中" GroupName="SideWindowMode" Style="{StaticResource SegmentedRadioStyle}" Checked="WindowModeRadio_Checked"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="形态" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsHairlineStyle}"/>

                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadioLangZh2" Content="中文" IsChecked="True" GroupName="SideLang" Tag="zh-CN" Style="{StaticResource SegmentedRadioStyle}" Checked="LangRadio_Checked"/>
                                            <RadioButton x:Name="RadioLangEn2" Content="English" GroupName="SideLang" Tag="en-US" Style="{StaticResource SegmentedRadioStyle}" Checked="LangRadio_Checked"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtSetLangTitle" Text="语言" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsHairlineStyle}"/>

                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadioDockLeft2" Content="左侧" GroupName="SideDockEdge" Tag="Left" Style="{StaticResource SegmentedRadioStyle}" Checked="DockEdgeRadio_Checked"/>
                                            <RadioButton x:Name="RadioDockRight2" Content="右侧" IsChecked="True" GroupName="SideDockEdge" Tag="Right" Style="{StaticResource SegmentedRadioStyle}" Checked="DockEdgeRadio_Checked"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtSetDockEdgeLabel" Text="贴边方向" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsHairlineStyle}"/>

                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadioMonitorCursor2" Content="跟随鼠标" IsChecked="True" GroupName="SideMonitorStrategy" Tag="FollowCursor" Style="{StaticResource SegmentedRadioStyle}" Checked="MonitorStrategyRadio_Checked"/>
                                            <RadioButton x:Name="RadioMonitorPrimary2" Content="主屏幕" GroupName="SideMonitorStrategy" Tag="Primary" Style="{StaticResource SegmentedRadioStyle}" Checked="MonitorStrategyRadio_Checked"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtSetMonitorStrategyLabel" Text="屏幕位置" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="TxtSetDockAndMonitorTitle" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- 外观 -->
                        <TextBlock x:Name="TxtSetThemeTitle" Text="外观" Style="{StaticResource SettingsSectionLabelStyle}"/>
                        <Border Style="{StaticResource SettingsGroupBorderStyle}">
                            <StackPanel>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <RadioButton x:Name="RadioThemeDark2" GroupName="SideTheme" IsChecked="True" Checked="ThemeRadio_Checked" Tag="Dark" Margin="2" Style="{StaticResource ThemeCardRadioStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#18181C" Stroke="#52525B" StrokeThickness="1" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="TxtThemeDarkShort2" Text="深色" FontSize="11"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="RadioThemeLight2" GroupName="SideTheme" Checked="ThemeRadio_Checked" Tag="Light" Margin="2" Style="{StaticResource ThemeCardRadioStyle}">
