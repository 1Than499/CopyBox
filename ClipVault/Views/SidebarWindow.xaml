<Window x:Class="ClipVault.Views.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:ClipVault.Helpers"
        mc:Ignorable="d"
        Title="CopyBox 侧边栏"
        Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 动态色板与毛玻璃材质 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#F2141722"/>
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#2E3A4E"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#F50F121A"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1C2230"/>
        <SolidColorBrush x:Key="CardHoverBgBrush" Color="#283246"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2D394D"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#0078D7"/>
        <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="#1E88E5"/>
        <SolidColorBrush x:Key="TileBgBrush" Color="#1B2230"/>
        <SolidColorBrush x:Key="TileHoverBgBrush" Color="#283348"/>

        <!-- 细线极简滚动条 -->
        <Style x:Key="MinimalScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Rectangle Fill="#475569" RadiusX="2" RadiusY="2" Width="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource MinimalScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶栏图标按钮通用样式 (带平滑悬停与点击反馈) -->
        <Style x:Key="SidebarTopIconBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 仿生快捷磁贴样式 (鼠标移动至每个地方均有精致高亮反馈) -->
        <Style x:Key="ActionCenterTileStyle" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Background" Value="{StaticResource TileBgBrush}"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tileBd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tileBd" Property="Background" Value="{StaticResource TileHoverBgBrush}"/>
                                <Setter TargetName="tileBd" Property="BorderBrush" Value="#800078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tileBd" Property="Background" Value="#32425E"/>
                                <Setter TargetName="tileBd" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 侧边栏外层主体 -->
    <Border x:Name="RootBorder" 
            Background="{StaticResource SidebarBgBrush}" 
            BorderBrush="{StaticResource SidebarBorderBrush}" 
            BorderThickness="1,0,0,0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 顶栏与双模切换 Tab -->
                <RowDefinition Height="*"/>    <!-- 核心视图区域 (剪贴板 / 快捷看板 / 侧边栏内置设置) -->
                <RowDefinition Height="Auto"/> <!-- 底部状态栏 -->
            </Grid.RowDefinitions>

            <!-- ================= 第一行：顶栏与双模切换药丸 ================= -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="14,12,14,10">
                <StackPanel>
                    <!-- 常态顶栏：标题与控制图标 -->
                    <Grid x:Name="HeaderNormalBar" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource AccentBlueBrush}" Margin="0,0,7,0">
                                <TextBlock Text="📋" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CopyBox" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Margin="7,0,0,0" Padding="5,1.5" CornerRadius="4" Background="#1E0078D7" VerticalAlignment="Center">
                                <TextBlock Text="v2.0" FontSize="9.5" Foreground="#60A5FA" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- 右侧按钮：图钉锁定、设置、收起 (具有明确高亮交互) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnPin" Style="{StaticResource SidebarTopIconBtn}" Click="BtnPin_Click" ToolTip="切换贴边自隐藏 / 图钉锁定常驻">
                                <TextBlock x:Name="TxtPinIcon" Text="📌" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnSettings" Style="{StaticResource SidebarTopIconBtn}" Click="BtnSettings_Click" ToolTip="打开侧边栏偏好设置">
                                <TextBlock Text="⚙" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnClose" Style="{StaticResource SidebarTopIconBtn}" Click="BtnClose_Click" ToolTip="收起侧边栏">
                                <TextBlock Text="✕" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 设置模式顶栏：带返回按钮 (进入设置时显现) -->
                    <Grid x:Name="HeaderSettingsBar" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnBackFromSettings" Style="{StaticResource SidebarTopIconBtn}" Click="BtnBackFromSettings_Click" ToolTip="返回上一视图" Margin="0,0,6,0">
                                <TextBlock Text="←" FontSize="14" FontWeight="Bold"/>
                            </Button>
                            <TextBlock Text="偏好设置" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource SidebarTopIconBtn}" HorizontalAlignment="Right" Click="BtnBackFromSettings_Click" ToolTip="完成并返回">
                            <TextBlock Text="✕" FontSize="11"/>
                        </Button>
                    </Grid>

                    <!-- 双模切换药丸 (两边绝对居中对齐，鼠标移到每个地方均有丰富 Hover/Click 交互) -->
                    <Border x:Name="TabSwitcherBorder" Background="#151B26" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="3" Height="36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tab 1: 剪贴板中心 (左侧严格水平垂直居中) -->
                            <Button x:Name="TabBtnClipboard" Grid.Column="0" Click="TabBtnClipboard_Click"
                                    Background="{StaticResource AccentBlueBrush}" Foreground="#FFFFFF"
                                    BorderThickness="0" Cursor="Hand" Margin="1,1,2,1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tabBd" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="tabIcon" Text="📋" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="tabText" Text="剪贴板中心" FontSize="12" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tabBd" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="tabBd" Property="Opacity" Value="0.75"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Tab 2: 系统快捷看板 (右侧严格水平垂直居中) -->
                            <Button x:Name="TabBtnSystem" Grid.Column="1" Click="TabBtnSystem_Click"
                                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand" Margin="2,1,1,1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tabBd" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="tabIcon" Text="⚡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="tabText" Text="快捷看板" FontSize="12" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter TargetName="tabBd" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="tabBd" Property="Background" Value="#35FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ================= 第二行：核心内容区域 ================= -->
            <Grid Grid.Row="1">
                
                <!-- 【视图 1：CopyBox 剪贴板中心】 -->
                <Grid x:Name="ClipboardViewPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 搜索框与分类胶囊 -->
                        <RowDefinition Height="*"/>    <!-- 卡片瀑布流 -->
                    </Grid.RowDefinitions>

                    <!-- 搜索栏与分类筛选胶囊 -->
                    <StackPanel Grid.Row="0" Margin="14,10,14,6">
                        <!-- 搜索框 -->
                        <Border Background="#121620" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="6" Height="32">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" VerticalContentAlignment="Center"
                                         TextChanged="TxtSearch_TextChanged"/>
                                <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="搜索历史记录或按数字秒贴..." 
                                           Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Width="20" Height="20" Background="Transparent"
                                        BorderThickness="0" Foreground="#64748B" Cursor="Hand" Click="BtnClearSearch_Click" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- 分类筛选胶囊 -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadioAll" Content="全部" IsChecked="True" Checked="Filter_Checked" Tag="all"
                                             Style="{StaticResource {x:Type ToggleButton}}" Margin="0,0,4,0"/>
                                <RadioButton x:Name="RadioText" Content="文本" Checked="Filter_Checked" Tag="text"
                                             Style="{StaticResource {x:Type ToggleButton}}" Margin="0,0,4,0"/>
                                <RadioButton x:Name="RadioImages" Content="图片" Checked="Filter_Checked" Tag="image"
                                             Style="{StaticResource {x:Type ToggleButton}}" Margin="0,0,4,0"/>
                                <RadioButton x:Name="RadioCode" Content="代码" Checked="Filter_Checked" Tag="code"
                                             Style="{StaticResource {x:Type ToggleButton}}" Margin="0,0,4,0"/>
                                <RadioButton x:Name="RadioPinned" Content="置顶" Checked="Filter_Checked" Tag="pinned"
                                             Style="{StaticResource {x:Type ToggleButton}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- 历史卡片列表 -->
                    <ListBox x:Name="CardsListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Padding="10,0,10,6"
                             PreviewMouseLeftButtonDown="CardsListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="CardsListBox_PreviewMouseMove"
                             MouseDoubleClick="CardsListBox_MouseDoubleClick"
                             KeyDown="CardsListBox_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,7"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder" Background="{StaticResource CardBgBrush}" 
                                        BorderBrush="{StaticResource CardBorderBrush}" 
                                        BorderThickness="1" CornerRadius="8" Padding="10,8" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource CardHoverBgBrush}"/>
                                                    <Setter Property="BorderBrush" Value="#800078D7"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <!-- 卡片顶栏：快捷贴数字徽标、时间与应用源 -->
                                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                            <Border DockPanel.Dock="Left" Background="#260078D7" CornerRadius="4" Padding="5,1" Margin="0,0,6,0"
                                                    Visibility="{Binding DisplayBadge, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding DisplayBadge}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                                            </Border>
                                            <TextBlock Text="{Binding SourceApp}" FontSize="10" Foreground="#64748B" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        </DockPanel>

                                        <!-- 1. 普通文本内容预览 -->
                                        <TextBlock Text="{Binding Content}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" 
                                                   TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" LineHeight="16"
                                                   Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>

                                        <!-- 2. 代码高亮块 -->
                                        <Border Background="#11141C" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="5" Padding="6"
                                                Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Content}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" 
                                                       Foreground="#38BDF8" TextWrapping="Wrap" MaxHeight="70" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <!-- 3. 图片缩略图 -->
                                        <Border Height="64" CornerRadius="5" Background="#11141C" 
                                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{Binding ImagePreview}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- 卡片底栏操作小按钮 (置顶/复制/删除，带悬浮高亮) -->
                                        <Grid Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Summary}" FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="📌" Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" FontSize="10" Click="BtnCardPin_Click" ToolTip="切换置顶"/>
                                                <Button Content="📋" Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" FontSize="10" Click="BtnCardCopy_Click" ToolTip="复制到剪贴板"/>
                                                <Button Content="🗑" Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" FontSize="10" Click="BtnCardDelete_Click" ToolTip="删除记录"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- 【视图 2：系统快捷看板 (当前播放音源 + 4大关键控制 + 用户自定义扩展 + 统一真实亮度调节)】 -->
                <ScrollViewer x:Name="SystemActionsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,10,14,14">
                        
                        <!-- 1. 正在播放音源卡片 (双引擎驱动：支持网易云、QQ音乐、抖音、Spotify、浏览器等) -->
                        <Border x:Name="BdMediaCard" Background="#161E2C" BorderBrush="#350078D7" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 专辑封面或音乐唱片图标 -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#111622" BorderBrush="#25FFFFFF" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="ImgMediaThumb" Stretch="UniformToFill" Visibility="Collapsed"/>
                                        <TextBlock x:Name="TxtMediaIconPlaceholder" Text="🎵" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- 媒体信息与控制按钮 -->
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <!-- 歌曲/标题与状态 -->
                                    <DockPanel LastChildFill="True">
                                        <Border x:Name="BdMediaStatusTag" DockPanel.Dock="Right" Background="#1AFFFFFF" CornerRadius="3" Padding="5,1.5" Margin="4,0,0,0">
                                            <TextBlock x:Name="TxtMediaStatusTag" Text="待机中" FontSize="9.5" Foreground="#64748B"/>
                                        </Border>
                                        <TextBlock x:Name="TxtMediaTitle" Text="未检测到播放中的音源" FontWeight="Bold" FontSize="12.5" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>

                                    <!-- 歌手/应用名 -->
                                    <TextBlock x:Name="TxtMediaArtist" Text="支持网易云/QQ音乐/抖音/Spotify/Edge等" FontSize="11" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6" TextTrimming="CharacterEllipsis"/>

                                    <!-- 播控按钮栏 (带明确交互反馈) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnMediaPrev" Style="{StaticResource SidebarTopIconBtn}" Width="28" Height="28" Click="BtnMediaPrev_Click" ToolTip="上一曲">
                                            <TextBlock Text="⏮" FontSize="12"/>
                                        </Button>
                                        <Button x:Name="BtnMediaPlayPause" Width="32" Height="32" Content="▶" FontSize="13"
                                                Background="{StaticResource AccentBlueBrush}" Foreground="#FFFFFF" 
                                                BorderThickness="0" Cursor="Hand" Margin="6,0,6,0" Click="BtnMediaPlayPause_Click" ToolTip="播放 / 暂停">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="playBd" Background="{TemplateBinding Background}" CornerRadius="16">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="playBd" Property="Background" Value="{StaticResource AccentBlueHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="playBd" Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button x:Name="BtnMediaNext" Style="{StaticResource SidebarTopIconBtn}" Width="28" Height="28" Click="BtnMediaNext_Click" ToolTip="下一曲">
                                            <TextBlock Text="⏭" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. 四大核心关键功能 (WiFi、蓝牙、系统设置、屏幕截图) -->
                        <TextBlock Text="核心系统快捷" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,12">
                            <!-- 磁贴 1: WiFi 可用网络 -->
                            <Button Style="{StaticResource ActionCenterTileStyle}" Margin="3" Click="TileWifi_Click" ToolTip="呼出 Windows 原生 WiFi 与网络连接面板">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🛜" FontSize="17" HorizontalAlignment="Center"/>
                                    <TextBlock Text="WLAN / 网络" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 磁贴 2: 蓝牙 -->
                            <Button x:Name="TileBluetooth" Style="{StaticResource ActionCenterTileStyle}" Margin="3" Click="TileBluetooth_Click" ToolTip="呼出 Windows 蓝牙设备管理">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🔵" FontSize="17" HorizontalAlignment="Center"/>
                                    <TextBlock Text="蓝牙设备" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 磁贴 3: Windows 系统设置 -->
                            <Button Style="{StaticResource ActionCenterTileStyle}" Margin="3" Click="TileSystemSettings_Click" ToolTip="打开 Windows 核心设置中心">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⚙️" FontSize="17" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Windows 设置" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 磁贴 4: 屏幕截图 -->
                            <Button Style="{StaticResource ActionCenterTileStyle}" Margin="3" Click="TileScreenClip_Click" ToolTip="呼出 Windows 剪贴板截图工具">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="✂️" FontSize="17" HorizontalAlignment="Center"/>
                                    <TextBlock Text="屏幕截图" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- 3. 自定义快捷动作网格 (用户可自行添加和管理) -->
                        <DockPanel Margin="2,0,2,6">
                            <TextBlock Text="自定义快捷动作" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="右键可删除" FontSize="10" Foreground="#64748B" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- 动态自定义磁贴列表 + 常驻【➕ 添加】按钮 -->
                        <WrapPanel x:Name="CustomActionsPanel" Margin="0,0,0,12">
                            <!-- 常驻添加磁贴 (带精致 Hover 交互) -->
                            <Button x:Name="BtnAddNewAction" Width="80" Height="58" Margin="3" Background="#161B26" BorderBrush="#35FFFFFF" 
                                    BorderThickness="1" Cursor="Hand" Click="BtnAddNewAction_Click" ToolTip="添加新的自定义软件、网站或命令动作">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="addBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="➕" FontSize="15" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                                                <TextBlock Text="添加动作" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="addBd" Property="Background" Value="#222B3D"/>
                                                <Setter TargetName="addBd" Property="BorderBrush" Value="#800078D7"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="addBd" Property="Background" Value="#2E3C56"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </WrapPanel>

                        <!-- 4. 统一的系统屏幕真实亮度调节 (两边实时保持一致，范围 0~100) -->
                        <Border Background="#161D2A" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="🔅 屏幕亮度 (系统双向同步)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtBrightnessValue" DockPanel.Dock="Right" Text="100%" FontSize="11.5" FontWeight="Bold" Foreground="#60A5FA"/>
                                </DockPanel>
                                <Slider x:Name="SliderBrightness" Minimum="0" Maximum="100" Value="100" SmallChange="5" LargeChange="10"
                                        ValueChanged="SliderBrightness_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- 5. 系统音量快捷调节 -->
                        <Border Background="#161D2A" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <DockPanel>
                                <TextBlock Text="🔊 系统主音量" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="🔉 减小" Style="{StaticResource ActionCenterTileStyle}" Height="30" Padding="10,2" Margin="2,0" FontSize="11" Click="BtnVolDown_Click"/>
                                    <Button Content="🔇 静音" Style="{StaticResource ActionCenterTileStyle}" Height="30" Padding="10,2" Margin="2,0" FontSize="11" Click="BtnVolMute_Click"/>
                                    <Button Content="🔊 增大" Style="{StaticResource ActionCenterTileStyle}" Height="30" Padding="10,2" Margin="2,0" FontSize="11" Click="BtnVolUp_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 【视图 3：侧边栏独立偏好设置页 (完全解耦 1.0 居中卡片)】 -->
                <ScrollViewer x:Name="SettingsViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,12,14,16">
                        
                        <!-- 1. 软件形态与模式切换 -->
                        <Border Background="#182030" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🖥️ 软件交互形态" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="可根据使用习惯自由选择经典悬浮卡片或侧边栏模式：" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <RadioButton x:Name="RadioModeSidebar2" Content="📑 2.0 贴边抽屉模式 (现代化看板+毛玻璃侧边栏)" IsChecked="True" GroupName="SideWindowMode" Margin="0,0,0,6" Checked="WindowModeRadio_Checked"/>
                                <RadioButton x:Name="RadioModeCentered2" Content="🗂️ 1.0 屏幕居中模式 (原版经典悬浮极速卡片)" GroupName="SideWindowMode" Checked="WindowModeRadio_Checked"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. 界面显示语言 -->
                        <Border Background="#182030" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🌐 界面语言" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RadioLangZh2" Content="🇨🇳 简体中文" IsChecked="True" GroupName="SideLang" Margin="0,0,18,0" Checked="LangRadio_Checked" Tag="zh-CN"/>
                                    <RadioButton x:Name="RadioLangEn2" Content="🇺🇸 English" GroupName="SideLang" Checked="LangRadio_Checked" Tag="en-US"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. 外观模式与透明度 (范围 0~100%，实时应用) -->
                        <Border Background="#182030" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🎨 外观与主题" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="RadioThemeDark2" Content="🌙 深色暗黑" IsChecked="True" GroupName="SideTheme" Margin="0,0,18,0" Checked="ThemeRadio_Checked" Tag="Dark"/>
                                    <RadioButton x:Name="RadioThemeLight2" Content="☀️ 明亮白天" GroupName="SideTheme" Checked="ThemeRadio_Checked" Tag="Light"/>
                                </StackPanel>
                                <DockPanel Margin="0,4,0,4">
                                    <TextBlock Text="抽屉毛玻璃透明度" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtSideOpacityVal" DockPanel.Dock="Right" Text="92%" FontSize="11" Foreground="#60A5FA"/>
                                </DockPanel>
                                <Slider x:Name="SliderSideOpacity" Minimum="0" Maximum="100" Value="92" SmallChange="5" LargeChange="10" ValueChanged="SliderSideOpacity_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- 4. 本地数据存储目录 -->
                        <Border Background="#182030" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="📁 本地数据存储路径" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtSideStoragePath" Text="C:\Users\...\Data" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                <Button Content="📂 更改目录并迁移数据" Background="#1F293D" Foreground="#60A5FA" BorderThickness="0" 
                                        Padding="10,5" FontSize="11" Cursor="Hand" Click="BtnBrowseStorage_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 5. 交互偏好 -->
                        <Border Background="#182030" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="⚡ 交互细节" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkHideOnDeactivate2" Content="点击窗口外部时自动收起" Margin="0,0,0,6" Checked="ChkHideOnDeactivate_Changed" Unchecked="ChkHideOnDeactivate_Changed"/>
                                <CheckBox x:Name="ChkPasteOnDblClick" Content="双击直接模拟粘贴并收起" Checked="ChkPasteOnDblClick_Changed" Unchecked="ChkPasteOnDblClick_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- 6. 清空与退出按钮 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="🗑️ 清空历史" Background="#261A22" Foreground="#F87171" BorderThickness="0" 
                                    Margin="0,0,4,0" Padding="8,7" FontSize="11.5" Cursor="Hand" Click="BtnClearHistory_Click"/>
                            <Button Grid.Column="1" Content="🛑 彻底退出" Background="#2E1C22" Foreground="#EF4444" BorderThickness="0" 
                                    Margin="4,0,0,0" Padding="8,7" FontSize="11.5" Cursor="Hand" Click="BtnExitApp_Click"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- 【浮层：添加自定义快捷动作弹窗】 -->
                <Grid x:Name="AddActionOverlay" Visibility="Collapsed" Background="#D0080B12">
                    <Border Width="310" Background="#1A2232" BorderBrush="#400078D7" BorderThickness="1" CornerRadius="10" Padding="16" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="➕ 添加自定义快捷动作" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            
                            <!-- 动作名称 -->
                            <TextBlock Text="名称 (如: 微信 / 计算器 / 哔哩哔哩)" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNewActionName" Background="#121622" Foreground="#FFFFFF" BorderBrush="#25FFFFFF" Padding="6,4" FontSize="11.5" Margin="0,0,0,8"/>

                            <!-- 图标 Emoji -->
                            <TextBlock Text="图标 (Emoji)" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNewActionIcon" Text="🚀" Background="#121622" Foreground="#FFFFFF" BorderBrush="#25FFFFFF" Padding="6,4" FontSize="12" Margin="0,0,0,8"/>

                            <!-- 执行目标 -->
                            <TextBlock Text="执行目标 (程序路径 / 网址 / 命令)" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewActionCommand" Grid.Column="0" Background="#121622" Foreground="#FFFFFF" BorderBrush="#25FFFFFF" Padding="6,4" FontSize="11.5"/>
                                <Button Grid.Column="1" Content="浏览..." Background="#253248" Foreground="#60A5FA" BorderThickness="0" Padding="8,4" Margin="4,0,0,0" Cursor="Hand" Click="BtnBrowseActionFile_Click"/>
                            </Grid>

                            <!-- 操作按钮 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="取消" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Padding="10,4" Margin="0,0,6,0" Cursor="Hand" Click="BtnCancelAddAction_Click"/>
                                <Button Content="保存并添加" Background="{StaticResource AccentBlueBrush}" Foreground="#FFFFFF" BorderThickness="0" Padding="12,5" Cursor="Hand" Click="BtnConfirmAddAction_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- ================= 第三行：底部状态栏 ================= -->
            <Border Grid.Row="2" Background="{StaticResource HeaderBgBrush}" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="14,7">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="TxtStatusLeft" Text="共 0 条历史记录" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="按 Alt+V 秒收" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>
    </Border>
</Window>
