<Window x:Class="ClipVault.Views.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:ClipVault.Helpers"
        mc:Ignorable="d"
        Title="CopyBox 侧边栏"
        Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 动态色板与毛玻璃材质 (使用 DynamicResource 确保白天/深色主题毫秒级无缝热切换) -->
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#F2141722"/>
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#2E3A4E"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#F50F121A"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1C2230"/>
        <SolidColorBrush x:Key="CardHoverBgBrush" Color="#283246"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2D394D"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#0078D7"/>
        <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="#1E88E5"/>
        <SolidColorBrush x:Key="TileBgBrush" Color="#1B2230"/>
        <SolidColorBrush x:Key="TileHoverBgBrush" Color="#283348"/>
        <SolidColorBrush x:Key="TabContainerBgBrush" Color="#151B26"/>
        <SolidColorBrush x:Key="CodeBoxBgBrush" Color="#11141C"/>
        <SolidColorBrush x:Key="CodeTextBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="SliderTrackBgBrush" Color="#334155"/>
        <SolidColorBrush x:Key="ScratchpadInputBgBrush" Color="#11151F"/>
        <SolidColorBrush x:Key="ScratchpadInputBorderBrush" Color="#232C3D"/>
        <SolidColorBrush x:Key="QueueBarBgBrush" Color="#1E2A42"/>

        <!-- 细线极简滚动条 -->
        <Style x:Key="MinimalScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Rectangle Fill="#475569" RadiusX="2" RadiusY="2" Width="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource MinimalScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶栏图标按钮通用样式 (带平滑悬停与点击反馈) -->
        <Style x:Key="SidebarTopIconBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2578A4E8"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4078A4E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 仿生快捷磁贴样式 (鼠标移动至每个地方均有精致高亮反馈) -->
        <Style x:Key="ActionCenterTileStyle" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Background" Value="{DynamicResource TileBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tileBd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tileBd" Property="Background" Value="{DynamicResource TileHoverBgBrush}"/>
                                <Setter TargetName="tileBd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tileBd" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="tileBd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分类筛选胶囊样式 (兼容深色/浅色自适应) -->
        <Style x:Key="FilterPillStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="pillBd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBd" Property="Background" Value="#1A78A4E8"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBd" Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 播放器圆形控制按钮样式 (平滑悬浮与微光反馈) -->
        <Style x:Key="MediaCircleIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2578A4E8"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化 Fluent 屏幕亮度与透明度滑动条样式 (保证白天明亮与暗夜深色模式下轨道与进度条均 100% 清晰可见) -->
        <Style x:Key="ModernFluentSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 底层未填充完整轨道 (白天模式为浅灰 slate-300，黑夜为深灰 slate-700，绝不丢失) -->
                            <Border Height="4" CornerRadius="2" 
                                    Background="{DynamicResource SliderTrackBgBrush}" 
                                    BorderThickness="0" Margin="5,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4" CornerRadius="2,0,0,2" 
                                                        Background="{DynamicResource AccentBlueBrush}" 
                                                        Margin="5,0,0,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Grid Width="16" Height="16">
                                                    <Ellipse x:Name="thumbOuter" Fill="{DynamicResource AccentBlueBrush}" Width="16" Height="16">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#0078D7" BlurRadius="5" ShadowDepth="1" Opacity="0.35"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse x:Name="thumbInner" Fill="#FFFFFF" Width="6" Height="6"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbOuter" Property="Fill" Value="{DynamicResource AccentBlueHoverBrush}"/>
                                                        <Setter TargetName="thumbOuter" Property="Width" Value="18"/>
                                                        <Setter TargetName="thumbOuter" Property="Height" Value="18"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbOuter" Property="Fill" Value="{DynamicResource AccentBlueBrush}"/>
                                                        <Setter TargetName="thumbInner" Property="Width" Value="8"/>
                                                        <Setter TargetName="thumbInner" Property="Height" Value="8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化主题切换卡片单选框样式 -->
        <Style x:Key="ThemeCardRadioStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="bd" Background="{DynamicResource TileBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化 Fluent 右键菜单与弹出层样式 (1:1 传承 1.0 质感，深浅色自适应) -->
        <SolidColorBrush x:Key="MenuBgBrush" Color="#F21A202C"/>
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#334155"/>
        <SolidColorBrush x:Key="MenuTextBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SelectedBorderBrush" Color="#0078D7"/>

        <Style x:Key="ModernContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Padding="6" Background="Transparent" SnapsToDevicePixels="True">
                            <Border Background="{DynamicResource MenuBgBrush}" 
                                    BorderBrush="{DynamicResource MenuBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="10" 
                                    Padding="4,5"
                                    MinWidth="160"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.30" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="8,0" 
                                Margin="1,1" 
                                SnapsToDevicePixels="True">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="6,0,8,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernMenuSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Background="{DynamicResource CardBorderBrush}" Height="1" Margin="6,3" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 侧边栏外层主体 -->
    <Border x:Name="RootBorder" 
            Background="{DynamicResource SidebarBgBrush}" 
            BorderBrush="{DynamicResource SidebarBorderBrush}" 
            BorderThickness="1,0,0,0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 顶栏与双模切换 Tab -->
                <RowDefinition Height="*"/>    <!-- 核心视图区域 (剪贴板 / 快捷看板 / 侧边栏内置设置) -->
                <RowDefinition Height="Auto"/> <!-- 底部状态栏 -->
            </Grid.RowDefinitions>

            <!-- 自定义图片背景层 (铺满全高 3 行，圆角裁剪 + 半透明高级磨砂遮罩) -->
            <Grid x:Name="BgImageContainer" Grid.RowSpan="3" Visibility="Collapsed">
                <Border CornerRadius="16,0,0,16" ClipToBounds="True">
                    <Image x:Name="ImgCustomBg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="BdCustomBgOverlay" CornerRadius="16,0,0,16" Background="#0F172A" Opacity="0.75"/>
            </Grid>

            <!-- ================= 第一行：顶栏与双模切换药丸 ================= -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="14,12,14,10">
                <StackPanel>
                    <!-- 常态顶栏：标题与控制图标 -->
                    <Grid x:Name="HeaderNormalBar" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource AccentBlueBrush}" Margin="0,0,7,0">
                                <TextBlock Text="📋" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CopyBox" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Margin="7,0,0,0" Padding="5,1.5" CornerRadius="4" Background="#1E0078D7" VerticalAlignment="Center">
                                <TextBlock Text="v2.0" FontSize="9.5" Foreground="#60A5FA" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- 右侧按钮：图钉锁定、设置、收起 (具有明确高亮交互) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnPin" Style="{StaticResource SidebarTopIconBtn}" Click="BtnPin_Click" ToolTip="切换贴边自隐藏 / 图钉锁定常驻">
                                <TextBlock x:Name="TxtPinIcon" Text="📌" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnSettings" Style="{StaticResource SidebarTopIconBtn}" Click="BtnSettings_Click" ToolTip="打开侧边栏偏好设置">
                                <TextBlock Text="⚙" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnClose" Style="{StaticResource SidebarTopIconBtn}" Click="BtnClose_Click" ToolTip="收起侧边栏">
                                <TextBlock Text="✕" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 设置模式顶栏：带返回按钮 (进入设置时显现) -->
                    <Grid x:Name="HeaderSettingsBar" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnBackFromSettings" Style="{StaticResource SidebarTopIconBtn}" Click="BtnBackFromSettings_Click" ToolTip="返回上一视图" Margin="0,0,6,0">
                                <TextBlock Text="←" FontSize="14" FontWeight="Bold"/>
                            </Button>
                            <TextBlock x:Name="TxtSettingsHeaderTitle" Text="偏好设置" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource SidebarTopIconBtn}" HorizontalAlignment="Right" Click="BtnBackFromSettings_Click" ToolTip="完成并返回">
                            <TextBlock Text="✕" FontSize="11"/>
                        </Button>
                    </Grid>

                    <!-- 双模视图切换栏 (去胶囊包裹，各自半块绝对居中，全区域点击跳转，鼠标悬浮交互) -->
                    <Grid x:Name="TabSwitcherRow" Height="36" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tab 1: 剪贴板中心 (左侧 50% 区域，整块可点，内容绝对水平垂直居中) -->
                        <Button x:Name="TabBtnClipboard" Grid.Column="0" Click="TabBtnClipboard_Click"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="tabBd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,0">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tabBd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="tabBd" Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTabBtnClipboard" Text="剪贴板中心" FontSize="12" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- 激活状态下优雅的 Fluent 下划指示线 -->
                                <Border x:Name="TabIndicatorClipboard" Height="2.5" Width="48" CornerRadius="1.25"
                                        Background="{DynamicResource AccentBlueBrush}" 
                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Tab 2: 系统快捷看板 (右侧 50% 区域，整块可点，内容绝对水平垂直居中) -->
                        <Button x:Name="TabBtnSystem" Grid.Column="1" Click="TabBtnSystem_Click"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="tabBd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,0">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tabBd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="tabBd" Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTabBtnSystem" Text="快捷看板" FontSize="12" FontWeight="Normal" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- 激活状态下优雅的 Fluent 下划指示线 -->
                                <Border x:Name="TabIndicatorSystem" Height="2.5" Width="48" CornerRadius="1.25"
                                        Background="{DynamicResource AccentBlueBrush}" 
                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= 第二行：核心内容区域 ================= -->
            <Grid Grid.Row="1">
                
                <!-- 【视图 1：CopyBox 剪贴板中心】 -->
                <Grid x:Name="ClipboardViewPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 搜索框与分类胶囊 -->
                        <RowDefinition Height="*"/>    <!-- 卡片瀑布流 -->
                    </Grid.RowDefinitions>

                    <!-- 搜索栏与分类筛选胶囊 -->
                    <StackPanel Grid.Row="0" Margin="14,10,14,6">
                        <!-- 搜索框 (浅色模式下为柔和浅灰底，深色模式为深灰底) -->
                        <Border Background="{DynamicResource TabContainerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Height="32">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <TextBox x:Name="TxtSearch" Grid.Column="1" Style="{x:Null}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         FontSize="11.5" VerticalContentAlignment="Center"
                                         Padding="2,0" TextChanged="TxtSearch_TextChanged"
                                         PreviewMouseDown="TxtSearch_PreviewMouseDown">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="Transparent" BorderThickness="0">
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" 
                                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                            </Border>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="搜索历史记录或按数字秒贴..." 
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Width="20" Height="20" Background="Transparent"
                                        BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" Click="BtnClearSearch_Click" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- 分类筛选胶囊 (浅色/深色自适应样式) -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadioAll" Content="全部" IsChecked="True" Checked="Filter_Checked" Tag="all" GroupName="SidebarCategoryFilter"
                                             Style="{StaticResource FilterPillStyle}"/>
                                <RadioButton x:Name="RadioText" Content="文本" Checked="Filter_Checked" Tag="text" GroupName="SidebarCategoryFilter"
                                             Style="{StaticResource FilterPillStyle}"/>
                                <RadioButton x:Name="RadioImages" Content="图片" Checked="Filter_Checked" Tag="image" GroupName="SidebarCategoryFilter"
                                             Style="{StaticResource FilterPillStyle}"/>
                                <RadioButton x:Name="RadioCode" Content="代码" Checked="Filter_Checked" Tag="code" GroupName="SidebarCategoryFilter"
                                             Style="{StaticResource FilterPillStyle}"/>
                                <RadioButton x:Name="RadioPinned" Content="置顶" Checked="Filter_Checked" Tag="pinned" GroupName="SidebarCategoryFilter"
                                             Style="{StaticResource FilterPillStyle}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 顶部随手记轻量便签 (Scratchpad，杀手级功能 4) -->
                        <Border x:Name="ScratchpadCard" Background="{DynamicResource TabContainerBgBrush}" 
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                                CornerRadius="8" Margin="0,6,0,2" Padding="8,6">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Cursor="Hand" MouseLeftButtonUp="ScratchpadHeader_Click">
                                    <TextBlock Text="📝" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtScratchpadTitle" Text="随手记便签" FontSize="11" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button x:Name="BtnScratchpadCopy" Content="📋" ToolTip="复制便签" 
                                                Style="{StaticResource SidebarTopIconBtn}" Width="20" Height="20" FontSize="10" 
                                                Click="BtnScratchpadCopy_Click"/>
                                        <Button x:Name="BtnScratchpadClear" Content="🗑" ToolTip="清空便签" 
                                                Style="{StaticResource SidebarTopIconBtn}" Width="20" Height="20" FontSize="10" 
                                                Click="BtnScratchpadClear_Click"/>
                                        <TextBlock x:Name="IconScratchpadToggle" Text="▾" FontSize="10" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <!-- 便签编辑区域 (圆角底盒 + 完全消除系统黑块与底线，白天/深色完美同步) -->
                                <Border x:Name="BdScratchpadInput" Visibility="Collapsed"
                                        Background="{DynamicResource ScratchpadInputBgBrush}"
                                        BorderBrush="{DynamicResource ScratchpadInputBorderBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Margin="0,6,0,0" Padding="6,4">
                                    <TextBox x:Name="TxtScratchpad" Style="{x:Null}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             FontSize="11.5" FontFamily="Segoe UI, Microsoft YaHei"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="56" MaxHeight="130"
                                             VerticalScrollBarVisibility="Auto"
                                             PreviewMouseDown="TxtScratchpad_PreviewMouseDown"
                                             TextChanged="TxtScratchpad_TextChanged">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="Transparent" BorderThickness="0">
                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" 
                                                                  HorizontalScrollBarVisibility="Hidden" 
                                                                  VerticalScrollBarVisibility="Auto"/>
                                                </Border>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 连续粘贴队列状态指示条 (杀手级功能 3：顺序连续流) -->
                        <Border x:Name="PasteQueueBar" Visibility="Collapsed" 
                                Background="{DynamicResource QueueBarBgBrush}" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1" 
                                CornerRadius="8" Margin="0,4,0,2" Padding="10,6">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="⮑" FontSize="12" Foreground="#60A5FA" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtQueueInfo" Text="连续粘贴队列 (已排队 0 项)" FontSize="11" FontWeight="SemiBold" 
                                               Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button x:Name="BtnPasteNextInQueue" Content="粘贴下一项" 
                                            Background="{DynamicResource AccentBlueBrush}" Foreground="#FFFFFF" BorderThickness="0" 
                                            FontSize="10.5" FontWeight="SemiBold" Padding="8,3" Cursor="Hand" Margin="0,0,6,0" 
                                            Click="BtnPasteNextInQueue_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="BtnClearQueue" Content="✕" ToolTip="清空队列" 
                                            Style="{StaticResource SidebarTopIconBtn}" Width="20" Height="20" FontSize="10" 
                                            Click="BtnClearQueue_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- 历史卡片列表 -->
                    <ListBox x:Name="CardsListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Padding="10,0,10,6"
                             PreviewMouseLeftButtonDown="CardsListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="CardsListBox_PreviewMouseMove"
                             MouseDoubleClick="CardsListBox_MouseDoubleClick"
                             KeyDown="CardsListBox_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,7"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown"/>
                                <EventSetter Event="MouseRightButtonUp" Handler="ListBoxItem_MouseRightButtonUp"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardItemBorder" 
                                                    Background="{DynamicResource CardBgBrush}" 
                                                    BorderBrush="{DynamicResource CardBorderBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="10,8" 
                                                    Cursor="Hand"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardItemBorder" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                                    <Setter TargetName="CardItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardItemBorder" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                                    <Setter TargetName="CardItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                                    <Setter TargetName="CardItemBorder" Property="BorderThickness" Value="1.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- 顶栏：类型/来源/星号/三点菜单 -->
                                        <RowDefinition Height="*"/>    <!-- 内容：文本/代码/图片 -->
                                        <RowDefinition Height="Auto"/> <!-- 底栏：摘要与快捷操作 -->
                                    </Grid.RowDefinitions>

                                    <!-- 卡片顶栏 (1:1 像 1.0 一样精致，右侧三点菜单 ··· 与置顶金星 ★) -->
                                    <Grid Grid.Row="0" Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 左侧类型徽标与数字秒贴徽标 -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 数字快捷徽标 -->
                                            <Border Background="#260078D7" CornerRadius="4" Padding="5,1" Margin="0,0,6,0"
                                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding DisplayBadge}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                                            </Border>
                                            <!-- 代码专属金黄花括号 -->
                                            <TextBlock Text="{}{" Foreground="#F59E0B" FontWeight="Bold" FontSize="12" FontFamily="Cascadia Code, Consolas"
                                                       Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <!-- 图片专属相框图标 -->
                                            <TextBlock Text="🖼" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" 
                                                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <!-- 文本专属双引号 -->
                                            <TextBlock Text="❝" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" 
                                                       Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" Margin="0,-2,4,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- 中间来源应用名称 -->
                                        <TextBlock Grid.Column="1" Text="{Binding SourceApp}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <!-- 右侧：置顶金星角标 ★ + 时间 + 三点菜单按钮 ··· (1:1 还原 1.0) -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 置顶高雅实心金星 ★ -->
                                            <TextBlock Text="★" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                                            <!-- 复制时间 -->
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <!-- 1.0 经典三点交互按钮 ··· -->
                                            <Button Content="···" Tag="{Binding Id}" Click="BtnCardMenu_Click" 
                                                    Background="Transparent" BorderThickness="0" 
                                                    Foreground="{DynamicResource TextSecondaryBrush}" 
                                                    FontSize="12" FontWeight="Bold" Cursor="Hand" Padding="2,0" 
                                                    ToolTip="更多选项 (右键菜单)"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 卡片主体内容 (文本/代码/图片严格物理隔离与尺寸限制，彻底杜绝重叠穿透) -->
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <!-- 1. 普通文本内容预览 (严格限制在 IsText 时显现，最大高度截断并带省略号) -->
                                        <Border Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" ClipToBounds="True">
                                            <TextBlock Text="{Binding Content}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                       TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <!-- 2. 代码高亮块 (主题色自适应，严格在 IsCode 时显现) -->
                                        <Border Background="{DynamicResource CodeBoxBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                                                BorderThickness="1" CornerRadius="5" Padding="6,4"
                                                Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}" ClipToBounds="True">
                                            <TextBlock Text="{Binding Content}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" 
                                                       Foreground="{DynamicResource CodeTextBrush}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <!-- 3. 图片缩略图 (严格在 IsImage 时显现，高清平滑渲染) -->
                                        <Border MaxHeight="85" CornerRadius="6" Background="{DynamicResource CodeBoxBgBrush}" 
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="4"
                                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" ClipToBounds="True">
                                            <Image Source="{Binding ImagePreview}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>

                                    <!-- 卡片底栏操作小按钮 (置顶/进队列/复制/删除，独立排版，绝对不与内容冲突) -->
                                    <DockPanel Grid.Row="2" LastChildFill="True" MinHeight="22" VerticalAlignment="Center">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="📌" Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" FontSize="10" Click="BtnCardPin_Click" ToolTip="切换置顶"/>
                                            <Button Content="⮑" Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" FontSize="10" Click="BtnCardEnqueue_Click" ToolTip="加入连续粘贴队列"/>
                                            <Button Content="📋" Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" FontSize="10" Click="BtnCardCopy_Click" ToolTip="复制到剪贴板"/>
                                            <Button Content="🗑" Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="20" FontSize="10" Click="BtnCardDelete_Click" ToolTip="删除记录"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" 
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 列表空状态提示 (分类无数据或搜索无结果时自适应居中显示) -->
                    <StackPanel x:Name="EmptyCardsStatePanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,40,0,0" IsHitTestVisible="False">
                        <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.7"/>
                        <TextBlock x:Name="TxtEmptyCategoryTip" Text="当前分类暂无记录" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="按 Ctrl+C 复制内容将自动归类于此" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.8"/>
                    </StackPanel>
                </Grid>

                <!-- 【视图 2：系统快捷看板 (当前播放音源 + 4大关键控制 + 用户自定义扩展 + 统一真实亮度调节)】 -->
                <ScrollViewer x:Name="SystemActionsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,10,14,14">
                        
                        <!-- 1. 正在播放音源卡片 (双引擎驱动 + 原生高清封面/应用Logo) -->
                        <Border x:Name="BdMediaCard" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 专辑封面或应用官方高清 Logo -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="{DynamicResource TabContainerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="ImgMediaThumb" Stretch="UniformToFill" Visibility="Collapsed"/>
                                        <TextBlock x:Name="TxtMediaIconPlaceholder" Text="🎵" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- 媒体信息与控制按钮 -->
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <!-- 歌曲/标题与状态 -->
                                    <DockPanel LastChildFill="True">
                                        <Border x:Name="BdMediaStatusTag" DockPanel.Dock="Right" Background="#1A78A4E8" CornerRadius="3" Padding="5,1.5" Margin="4,0,0,0">
                                            <TextBlock x:Name="TxtMediaStatusTag" Text="待机中" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <TextBlock x:Name="TxtMediaTitle" Text="未检测到播放中的音源" FontWeight="Bold" FontSize="12.5" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>

                                    <!-- 歌手/应用名 -->
                                    <TextBlock x:Name="TxtMediaArtist" Text="支持网易云/QQ音乐/抖音/Spotify/Edge等" FontSize="11" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,6" TextTrimming="CharacterEllipsis"/>

                                    <!-- 播控按钮栏 (全新现代化 Fluent 矢量图标与精致悬停微光) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- 上一曲 -->
                                        <Button x:Name="BtnMediaPrev" Style="{StaticResource MediaCircleIconBtn}" Width="28" Height="28" Click="BtnMediaPrev_Click" ToolTip="上一曲">
                                            <Path Data="M 3,3 L 5,3 L 5,13 L 3,13 Z M 13,3 L 5.5,8 L 13,13 Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="10.5" Height="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- 播放 / 暂停 (高亮强调圆形主控，带柔和微光) -->
                                        <Button x:Name="BtnMediaPlayPause" Width="32" Height="32"
                                                Background="{DynamicResource AccentBlueBrush}" 
                                                BorderThickness="0" Cursor="Hand" Margin="7,0,7,0" Click="BtnMediaPlayPause_Click" ToolTip="播放 / 暂停">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="playBd" Background="{TemplateBinding Background}" CornerRadius="16">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#0078D7" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="playBd" Property="Background" Value="{DynamicResource AccentBlueHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="playBd" Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path x:Name="IconPlay" Data="M 4,2.5 L 13.5,8 L 4,13.5 Z" Fill="#FFFFFF" Stretch="Uniform" Width="11" Height="11" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1.5,0,0,0"/>
                                                <Path x:Name="IconPause" Data="M 3,2.5 L 6,2.5 L 6,13.5 L 3,13.5 Z M 10,2.5 L 13,2.5 L 13,13.5 L 10,13.5 Z" Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </Button>

                                        <!-- 下一曲 -->
                                        <Button x:Name="BtnMediaNext" Style="{StaticResource MediaCircleIconBtn}" Width="28" Height="28" Click="BtnMediaNext_Click" ToolTip="下一曲">
                                            <Path Data="M 13,3 L 11,3 L 11,13 L 13,13 Z M 3,3 L 10.5,8 L 3,13 Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="10.5" Height="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. 四大核心关键功能 (WLAN网络、蓝牙、系统设置、屏幕截图) - 采用 100% 绝对兼容无乱码的 Windows 原生 Fluent 矢量图标 -->
                        <TextBlock x:Name="TxtSectionCoreShortcuts" Text="核心系统快捷" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,12">
                            <!-- 磁贴 1: WLAN / 网络 (使用 Segoe MDL2 Assets 官方 Wi-Fi 矢量图标 &#xE701;，彻底杜绝方框乱码！) -->
                            <Button Style="{StaticResource ActionCenterTileStyle}" Margin="3" Click="TileWifi_Click" ToolTip="呼出 Windows 原生 WiFi 与网络连接面板">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="18" Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTileWifi" Text="WLAN / 网络" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 磁贴 2: 蓝牙 -->
                            <Button x:Name="TileBluetooth" Style="{StaticResource ActionCenterTileStyle}" Margin="3" Click="TileBluetooth_Click" ToolTip="呼出 Windows 蓝牙设备管理">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="18" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTileBluetooth" Text="蓝牙设备" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 磁贴 3: Windows 系统设置 -->
                            <Button Style="{StaticResource ActionCenterTileStyle}" Margin="3" Click="TileSystemSettings_Click" ToolTip="打开 Windows 核心设置中心">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTileSettings" Text="Windows 设置" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 磁贴 4: 屏幕截图 -->
                            <Button Style="{StaticResource ActionCenterTileStyle}" Margin="3" Click="TileScreenClip_Click" ToolTip="呼出 Windows 剪贴板截图工具">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE77A;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="18" Foreground="#F472B6" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTileScreenClip" Text="屏幕截图" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- 3. 自定义快捷动作网格 (用户可自行添加和管理) -->
                        <DockPanel Margin="2,0,2,6">
                            <TextBlock x:Name="TxtSectionCustomActions" Text="自定义快捷动作" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtTipRightClickDelete" Text="右键可删除" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- 动态自定义磁贴列表 + 常驻【➕ 添加】按钮 -->
                        <WrapPanel x:Name="CustomActionsPanel" Margin="0,0,0,12">
                            <!-- 常驻添加磁贴 (带精致 Hover 交互) -->
                            <Button x:Name="BtnAddNewAction" Width="80" Height="58" Margin="3" Background="{DynamicResource TileBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                                    BorderThickness="1" Cursor="Hand" Click="BtnAddNewAction_Click" ToolTip="添加新的自定义软件、网站或命令动作">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="addBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="addBd" Property="Background" Value="{DynamicResource TileHoverBgBrush}"/>
                                                <Setter TargetName="addBd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="addBd" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="➕" FontSize="15" Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBtnAddAction" Text="添加动作" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- 4. 系统核心控制孪生面板：屏幕亮度 & 系统主音量 (双向毫秒级同步，完全统一视觉与交互规范) -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- (1) 屏幕亮度 -->
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource TileBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0.6" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="点击快捷切换 50% / 100% 亮度" PreviewMouseLeftButtonUp="TxtBrightnessIcon_Click">
                                            <TextBlock x:Name="TxtBrightnessIcon" Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="TxtBrightnessTitle" Text="屏幕亮度" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtBrightnessValue" DockPanel.Dock="Right" Text="--" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBlueBrush}" Margin="6,0,0,0"/>
                                </DockPanel>
                                <Slider x:Name="SliderBrightness" Style="{StaticResource ModernFluentSliderStyle}" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10"
                                        ValueChanged="SliderBrightness_ValueChanged" PreviewMouseWheel="SliderBrightness_MouseWheel" Margin="0,0,0,10"/>

                                <!-- 分割微线 -->
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,10" Opacity="0.6"/>

                                <!-- (2) 系统主音量 -->
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource TileBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0.6" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="点击切换静音" PreviewMouseLeftButtonUp="TxtVolumeIcon_Click">
                                            <TextBlock x:Name="TxtVolumeIcon" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="TxtVolumeTitle" Text="系统主音量" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtVolumeValue" DockPanel.Dock="Right" Text="--" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBlueBrush}" Margin="6,0,0,0"/>
                                </DockPanel>
                                <Slider x:Name="SliderVolume" Style="{StaticResource ModernFluentSliderStyle}" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10"
                                        ValueChanged="SliderVolume_ValueChanged" PreviewMouseWheel="SliderVolume_MouseWheel"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 【视图 3：侧边栏独立偏好设置页 (完全解耦 1.0 居中卡片)】 -->
                <ScrollViewer x:Name="SettingsViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,12,14,16">
                        
                        <!-- 1. 软件形态与模式切换 -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="TxtSetModeTitle" Text="🖥️ 软件交互形态" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtSetModeDesc" Text="可根据使用习惯自由选择经典悬浮卡片或侧边栏模式：" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <RadioButton x:Name="RadioModeSidebar2" Content="📑 2.0 贴边抽屉模式 (现代化看板+毛玻璃侧边栏)" IsChecked="True" GroupName="SideWindowMode" Margin="0,0,0,6" Checked="WindowModeRadio_Checked" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <RadioButton x:Name="RadioModeCentered2" Content="🗂️ 1.0 屏幕居中模式 (原版经典悬浮极速卡片)" GroupName="SideWindowMode" Checked="WindowModeRadio_Checked" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. 界面显示语言 -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="TxtSetLangTitle" Text="🌐 界面语言" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RadioLangZh2" Content="🇨🇳 简体中文" IsChecked="True" GroupName="SideLang" Margin="0,0,18,0" Checked="LangRadio_Checked" Tag="zh-CN" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <RadioButton x:Name="RadioLangEn2" Content="🇺🇸 English" GroupName="SideLang" Checked="LangRadio_Checked" Tag="en-US" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. 外观模式、自定义主题与壁纸设置 (支持 6 大主题与本地图片上传) -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="TxtSetThemeTitle" Text="🎨 预设主题与个性化壁纸" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                
                                <!-- 主题卡片网格 (3列 x 2行) -->
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <!-- 1. 暗夜深色 -->
                                    <RadioButton x:Name="RadioThemeDark2" GroupName="SideTheme" Checked="ThemeRadio_Checked" Tag="Dark" Margin="2"
                                                 Style="{StaticResource ThemeCardRadioStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="11" Height="11" CornerRadius="5.5" Background="#141722" BorderBrush="#38BDF8" BorderThickness="1.5" Margin="0,0,4,0"/>
                                            <TextBlock Text="🌙 深色" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- 2. 纯净明亮 -->
                                    <RadioButton x:Name="RadioThemeLight2" GroupName="SideTheme" Checked="ThemeRadio_Checked" Tag="Light" Margin="2"
                                                 Style="{StaticResource ThemeCardRadioStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="11" Height="11" CornerRadius="5.5" Background="#F8FAFC" BorderBrush="#0078D4" BorderThickness="1.5" Margin="0,0,4,0"/>
                                            <TextBlock Text="☀️ 明亮" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- 3. 极光夜幕 -->
                                    <RadioButton x:Name="RadioThemeAurora2" GroupName="SideTheme" Checked="ThemeRadio_Checked" Tag="Aurora" Margin="2"
                                                 Style="{StaticResource ThemeCardRadioStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="11" Height="11" CornerRadius="5.5" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1.5" Margin="0,0,4,0"/>
                                            <TextBlock Text="🌌 极光" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- 4. 暮色紫霞 -->
                                    <RadioButton x:Name="RadioThemeSunset2" GroupName="SideTheme" Checked="ThemeRadio_Checked" Tag="Sunset" Margin="2"
                                                 Style="{StaticResource ThemeCardRadioStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="11" Height="11" CornerRadius="5.5" Background="#2E1065" BorderBrush="#A855F7" BorderThickness="1.5" Margin="0,0,4,0"/>
                                            <TextBlock Text="🌆 暮色" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- 5. 深海湛蓝 -->
                                    <RadioButton x:Name="RadioThemeOcean2" GroupName="SideTheme" Checked="ThemeRadio_Checked" Tag="Ocean" Margin="2"
                                                 Style="{StaticResource ThemeCardRadioStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="11" Height="11" CornerRadius="5.5" Background="#0C4A6E" BorderBrush="#0EA5E9" BorderThickness="1.5" Margin="0,0,4,0"/>
                                            <TextBlock Text="🌊 深海" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- 6. 自定义壁纸 -->
                                    <RadioButton x:Name="RadioThemeCustom2" GroupName="SideTheme" Checked="ThemeRadio_Checked" Tag="CustomImage" Margin="2"
                                                 Style="{StaticResource ThemeCardRadioStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="11" Height="11" CornerRadius="5.5" Background="#3B82F6" BorderBrush="#60A5FA" BorderThickness="1.5" Margin="0,0,4,0"/>
                                            <TextBlock Text="🖼️ 壁纸" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>

                                <!-- 自定义壁纸图片管理区 (仅在选中 CustomImage 时展开) -->
                                <Border x:Name="BdCustomImageSettings" Background="{DynamicResource TileBgBrush}" CornerRadius="6" Padding="9,8" Margin="0,2,0,8" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="🖼️ 自定义壁纸图片管理" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtCustomBgPath" Text="未选择本地图片 (当前使用内置极光壁纸)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnUploadCustomBg" Content="📁 上传本地图片..." Background="{DynamicResource AccentBlueBrush}" Foreground="#FFFFFF" BorderThickness="0" Padding="8,4" FontSize="10.5" Cursor="Hand" Click="BtnUploadCustomBg_Click"/>
                                            <Button x:Name="BtnResetCustomBg" Grid.Column="1" Content="🔄 内置壁纸" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Padding="6,4" FontSize="10.5" Cursor="Hand" Margin="6,0,0,0" Click="BtnResetCustomBg_Click"/>
                                        </Grid>
                                        <!-- 遮罩深浅度调节 -->
                                        <DockPanel Margin="0,2,0,2">
                                            <TextBlock Text="壁纸磨砂遮罩浓度" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TxtBgOverlayOpacityVal" DockPanel.Dock="Right" Text="75%" FontSize="10" Foreground="{DynamicResource AccentBlueBrush}"/>
                                        </DockPanel>
                                        <Slider x:Name="SliderBgOverlayOpacity" Style="{StaticResource ModernFluentSliderStyle}" Minimum="30" Maximum="95" Value="75" SmallChange="5" LargeChange="10" ValueChanged="SliderBgOverlayOpacity_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <DockPanel Margin="0,4,0,4">
                                    <TextBlock x:Name="TxtSetOpacityTitle" Text="抽屉毛玻璃透明度" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtSideOpacityVal" DockPanel.Dock="Right" Text="92%" FontSize="11" Foreground="{DynamicResource AccentBlueBrush}"/>
                                </DockPanel>
                                <Slider x:Name="SliderSideOpacity" Style="{StaticResource ModernFluentSliderStyle}" Minimum="0" Maximum="100" Value="92" SmallChange="5" LargeChange="10" ValueChanged="SliderSideOpacity_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- 4. 本地数据存储目录 -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="TxtSetStorageTitle" Text="📁 本地数据存储路径" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtSideStoragePath" Text="C:\Users\...\Data" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                <Button x:Name="BtnBrowseStorage" Content="📂 更改目录并迁移数据" Background="{DynamicResource TileBgBrush}" Foreground="{DynamicResource AccentBlueBrush}" BorderThickness="0" 
                                        Padding="10,5" FontSize="11" Cursor="Hand" Click="BtnBrowseStorage_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 5. 交互细节 -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="TxtSetInteractionTitle" Text="⚡ 交互细节" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkHideOnDeactivate2" Content="📌 图钉锁定常驻 (点击外部不自动收起)" Margin="0,0,0,6" Checked="ChkHideOnDeactivate_Changed" Unchecked="ChkHideOnDeactivate_Changed" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="勾选：图钉锁定常驻，外部操作不收起；未勾选：失焦自动贴边收起"/>
                                <CheckBox x:Name="ChkPasteOnDblClick" Content="双击直接模拟粘贴并收起" Checked="ChkPasteOnDblClick_Changed" Unchecked="ChkPasteOnDblClick_Changed" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- 6. 清空与退出按钮 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnClearHistory" Grid.Column="0" Content="🗑️ 清空历史" Background="#261A22" Foreground="#F87171" BorderThickness="0" 
                                    Margin="0,0,4,0" Padding="8,7" FontSize="11.5" Cursor="Hand" Click="BtnClearHistory_Click"/>
                            <Button x:Name="BtnExitApp" Grid.Column="1" Content="🛑 彻底退出" Background="#2E1C22" Foreground="#EF4444" BorderThickness="0" 
                                    Margin="4,0,0,0" Padding="8,7" FontSize="11.5" Cursor="Hand" Click="BtnExitApp_Click"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- 【浮层：添加自定义快捷动作弹窗】 -->
                <Grid x:Name="AddActionOverlay" Visibility="Collapsed" Background="#D0080B12">
                    <Border Width="310" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1" CornerRadius="10" Padding="16" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="➕ 添加自定义快捷动作" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            
                            <!-- 动作名称 -->
                            <TextBlock Text="名称 (如: 微信 / 计算器 / 哔哩哔哩)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNewActionName" Background="{DynamicResource TabContainerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="6,4" FontSize="11.5" Margin="0,0,0,8"/>

                            <!-- 图标 Emoji -->
                            <TextBlock Text="图标 (Emoji)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNewActionIcon" Text="🚀" Background="{DynamicResource TabContainerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="6,4" FontSize="12" Margin="0,0,0,8"/>

                            <!-- 执行目标 -->
                            <TextBlock Text="执行目标 (程序路径 / 网址 / 命令)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewActionCommand" Grid.Column="0" Background="{DynamicResource TabContainerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="6,4" FontSize="11.5"/>
                                <Button Grid.Column="1" Content="浏览..." Background="{DynamicResource TileBgBrush}" Foreground="{DynamicResource AccentBlueBrush}" BorderThickness="0" Padding="8,4" Margin="4,0,0,0" Cursor="Hand" Click="BtnBrowseActionFile_Click"/>
                            </Grid>

                            <!-- 操作按钮 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="取消" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Padding="10,4" Margin="0,0,6,0" Cursor="Hand" Click="BtnCancelAddAction_Click"/>
                                <Button Content="保存并添加" Background="{DynamicResource AccentBlueBrush}" Foreground="#FFFFFF" BorderThickness="0" Padding="12,5" Cursor="Hand" Click="BtnConfirmAddAction_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- ================= 第三行：底部状态栏 ================= -->
            <Border Grid.Row="2" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="14,7">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="TxtStatusLeft" Text="共 0 条历史记录" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock x:Name="TxtStatusRightTip" Text="按 Alt+V 秒收" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>
    </Border>
</Window>
