                                    <TextBlock x:Name="TxtSetOpacityTitle" Text="透明度" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Slider x:Name="SliderSideOpacity" Style="{StaticResource ModernFluentSliderStyle}" Minimum="0" Maximum="85" Value="8" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderSideOpacity_ValueChanged"/>

                                <Border Style="{StaticResource SettingsHairlineStyle}"/>

                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadioBackdropDefault2" GroupName="SideBackdropGroup" Tag="Default" Content="默认" Style="{StaticResource SegmentedRadioStyle}" Checked="BackdropRadio_Checked"/>
                                            <RadioButton x:Name="RadioBackdropMica2" GroupName="SideBackdropGroup" Tag="Mica" Content="云母" Style="{StaticResource SegmentedRadioStyle}" Checked="BackdropRadio_Checked"/>
                                            <RadioButton x:Name="RadioBackdropAcrylic2" GroupName="SideBackdropGroup" Tag="Acrylic" Content="亚克力" Style="{StaticResource SegmentedRadioStyle}" Checked="BackdropRadio_Checked"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtSetBackdropLabel" Text="窗口材质" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="TxtSetBackdropAndAudioTitle" Visibility="Collapsed"/>

                                <Border Style="{StaticResource SettingsHairlineStyle}"/>

                                <CheckBox x:Name="ChkSoundEffects2" Content="交互提示音" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Checked="ChkSoundEffects_Changed" Unchecked="ChkSoundEffects_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- 隐私与免打扰 -->
                        <TextBlock x:Name="TxtSetSmartGuardTitle" Text="隐私与免打扰" Style="{StaticResource SettingsSectionLabelStyle}"/>
                        <Border Style="{StaticResource SettingsGroupBorderStyle}">
                            <StackPanel>
                                <CheckBox x:Name="ChkFullscreenDnd2" Content="全屏自动免打扰" IsChecked="True" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Checked="ChkSmartGuard_Changed" Unchecked="ChkSmartGuard_Changed"/>
                                <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                <CheckBox x:Name="ChkManualDnd2" Content="暂停贴边呼出" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Checked="ChkSmartGuard_Changed" Unchecked="ChkSmartGuard_Changed"/>
                                <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                <CheckBox x:Name="ChkAutoMaskSensitive2" Content="敏感信息遮罩" IsChecked="True" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Checked="ChkSmartGuard_Changed" Unchecked="ChkSmartGuard_Changed"/>
                                <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                <CheckBox x:Name="ChkIgnorePasswordManagers2" Content="忽略密码工具" IsChecked="True" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Checked="ChkSmartGuard_Changed" Unchecked="ChkSmartGuard_Changed"/>
                                <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                <DockPanel>
                                    <TextBlock x:Name="TxtSetPrivacyBlacklistLabel" Text="排除进程" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="TxtPrivacyBlacklist2" Background="{DynamicResource TabContainerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                             Padding="7,4" FontSize="11" LostFocus="TxtPrivacyBlacklist_LostFocus"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 存储与历史 -->
                        <TextBlock x:Name="TxtSetStorageTitle" Text="存储" Style="{StaticResource SettingsSectionLabelStyle}"/>
                        <Border Style="{StaticResource SettingsGroupBorderStyle}">
                            <StackPanel>
                                <CheckBox x:Name="ChkFollowAppDir2" Content="随程序目录" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Checked="ChkFollowAppDir_Changed" Unchecked="ChkFollowAppDir_Changed"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="BdSideStoragePath" Grid.Column="0" Background="{DynamicResource TabContainerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="8,5">
                                        <TextBlock x:Name="TxtSideStoragePath" Text="" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    </Border>
                                    <Button x:Name="BtnBrowseStorage" Grid.Column="1" Content="更改" Style="{StaticResource SubtleBtnStyle}" Click="BtnBrowseStorage_Click"/>
                                </Grid>
                                <TextBlock x:Name="TxtSideStorageStatusInfo" Text="0 条记录 · 0 置顶 · 0 图片" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="2,6,0,0"/>

                                <Border Style="{StaticResource SettingsHairlineStyle}"/>

                                <CheckBox x:Name="ChkDeduplicateOnCopy2" Content="合并重复复制" IsChecked="True" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Checked="ChkDeduplicateOnCopy_Changed" Unchecked="ChkDeduplicateOnCopy_Changed"/>

                                <Border Style="{StaticResource SettingsHairlineStyle}"/>

                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadioMaxHist200" Content="200" Tag="200" GroupName="SideMaxHist" Style="{StaticResource SegmentedRadioStyle}" Padding="6,3" FontSize="10" Checked="MaxHistoryRadio_Checked"/>
                                            <RadioButton x:Name="RadioMaxHist500" Content="500" Tag="500" GroupName="SideMaxHist" Style="{StaticResource SegmentedRadioStyle}" Padding="6,3" FontSize="10" Checked="MaxHistoryRadio_Checked"/>
                                            <RadioButton x:Name="RadioMaxHist1000" Content="1000" Tag="1000" GroupName="SideMaxHist" IsChecked="True" Style="{StaticResource SegmentedRadioStyle}" Padding="6,3" FontSize="10" Checked="MaxHistoryRadio_Checked"/>
                                            <RadioButton x:Name="RadioMaxHist2000" Content="2000" Tag="2000" GroupName="SideMaxHist" Style="{StaticResource SegmentedRadioStyle}" Padding="6,3" FontSize="10" Checked="MaxHistoryRadio_Checked"/>
                                            <RadioButton x:Name="RadioMaxHist0" Content="不限" Tag="0" GroupName="SideMaxHist" Style="{StaticResource SegmentedRadioStyle}" Padding="6,3" FontSize="10" Checked="MaxHistoryRadio_Checked"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtSetMaxHistoryLabel" Text="保留上限" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsHairlineStyle}"/>

                                <Button x:Name="BtnBackfillOcr2" Content="旧图 OCR 索引" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,0,6" Click="BtnBackfillOcr_Click"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnExportBackup2" Grid.Column="0" Content="导出配置" Style="{StaticResource SubtleBtnStyle}" Click="BtnExportBackup_Click"/>
                                    <Button x:Name="BtnImportBackup2" Grid.Column="2" Content="导入配置" Style="{StaticResource SubtleBtnStyle}" Click="BtnImportBackup_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 交互 -->
                        <TextBlock x:Name="TxtSetInteractionTitle" Text="交互" Style="{StaticResource SettingsSectionLabelStyle}"/>
                        <Border Style="{StaticResource SettingsGroupBorderStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadioSideDoubleClickCopy" Content="复制" GroupName="SideDoubleClickGroup" Style="{StaticResource SegmentedRadioStyle}" Checked="SideDoubleClickRadio_Changed"/>
                                            <RadioButton x:Name="RadioSideDoubleClickPaste" Content="贴入并收起" GroupName="SideDoubleClickGroup" Style="{StaticResource SegmentedRadioStyle}" Checked="SideDoubleClickRadio_Changed"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="双击卡片" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsHairlineStyle}"/>

                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadioSideCloseMinimize" Content="收起至托盘" GroupName="SideCloseActionGroup" Style="{StaticResource SegmentedRadioStyle}" Checked="SideCloseActionRadio_Changed"/>
                                            <RadioButton x:Name="RadioSideCloseExit" Content="退出程序" GroupName="SideCloseActionGroup" Style="{StaticResource SegmentedRadioStyle}" Checked="SideCloseActionRadio_Changed"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtSideCloseActionTitle" Text="关闭行为" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsHairlineStyle}"/>

                                <CheckBox x:Name="ChkHideOnDeactivate2" Content="窗口常驻" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" Checked="ChkHideOnDeactivate_Changed" Unchecked="ChkHideOnDeactivate_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- 底部危险操作 -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnClearHistory" Grid.Column="0" Content="清空历史" Style="{StaticResource SubtleBtnStyle}" Foreground="#F87171" Click="BtnClearHistory_Click"/>
                            <Button x:Name="BtnExitApp" Grid.Column="2" Content="退出" Style="{StaticResource SubtleBtnStyle}" Foreground="#EF4444" Click="BtnExitApp_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 浮层：添加快捷动作 -->
                <Grid x:Name="AddActionOverlay" Visibility="Collapsed" Background="#CC09090B">
                    <Border Width="330" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="添加动作" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                            <TextBlock Text="目标" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewActionCommand" Grid.Column="0" Background="{DynamicResource TabContainerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="7,5" FontSize="11.5" TextChanged="TxtNewActionCommand_TextChanged"/>
                                <Button Grid.Column="1" Content="浏览" Style="{StaticResource SubtleBtnStyle}" Margin="6,0,0,0" Click="BtnBrowseActionFile_Click"/>
                            </Grid>

                            <TextBlock Text="名称" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNewActionName" Background="{DynamicResource TabContainerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="7,5" FontSize="11.5" Margin="0,0,0,10"/>

                            <TextBlock Text="图标" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="30" Height="28" CornerRadius="6" Background="{DynamicResource TabContainerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image x:Name="ImgNewActionIconPreview" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="TxtNewActionIconPreview" Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                </Border>
                                <TextBox x:Name="TxtNewActionIcon" Grid.Column="1" Text="" Background="{DynamicResource TabContainerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="7,4" FontSize="11.5" VerticalContentAlignment="Center" TextChanged="TxtNewActionIcon_TextChanged"/>
                            </Grid>

                            <TextBlock Text="快捷键" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewActionHotkey" Grid.Column="0" Text="" IsReadOnly="True" Background="{DynamicResource TabContainerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="7,5" FontSize="11" PreviewKeyDown="TxtNewActionHotkey_PreviewKeyDown"/>
                                <Button Grid.Column="1" Content="清除" Style="{StaticResource SubtleBtnStyle}" Margin="6,0,0,0" Click="BtnClearNewActionHotkey_Click"/>
                            </Grid>

                            <CheckBox x:Name="ChkNewActionActivateExisting" IsChecked="True" Content="唤醒已有窗口" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,2,0,14"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="取消" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,6,0" Click="BtnCancelAddAction_Click"/>
                                <Button Content="保存" Style="{StaticResource PrimaryBtnStyle}" Click="BtnConfirmAddAction_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 浮层：新建分组与模板 -->
                <Grid x:Name="AddTagOverlay" Visibility="Collapsed" Background="#CC09090B">
                    <Border Width="330" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="TxtAddTagDialogTitle" Text="新建分组" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtAddTagIconLabel" Text="符号" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtNewTagIcon" Text="#" MaxLength="4" TextAlignment="Center" Background="{DynamicResource TabContainerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="4,5" FontSize="12" PreviewMouseDown="TxtSearch_PreviewMouseDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TxtAddTagNameLabel" Text="名称" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtNewTagName" MaxLength="20" Background="{DynamicResource TabContainerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="7,5" FontSize="12" PreviewMouseDown="TxtSearch_PreviewMouseDown"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TxtAddTagTemplateLabel" Text="模板内容（可选）" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNewTagTemplateContent" Background="{DynamicResource TabContainerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="7,6" FontSize="11.5" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" PreviewMouseDown="TxtSearch_PreviewMouseDown"/>

                            <TextBlock x:Name="TxtAddTagMacroTip" Text="变量" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="{}{{date}}" Tag="{}{{date}}" Click="BtnInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" Padding="6,2.5" Margin="0,0,4,4" FontSize="10" FontFamily="Cascadia Mono, Consolas"/>
                                <Button Content="{}{{time}}" Tag="{}{{time}}" Click="BtnInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" Padding="6,2.5" Margin="0,0,4,4" FontSize="10" FontFamily="Cascadia Mono, Consolas"/>
                                <Button Content="{}{{datetime}}" Tag="{}{{datetime}}" Click="BtnInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" Padding="6,2.5" Margin="0,0,4,4" FontSize="10" FontFamily="Cascadia Mono, Consolas"/>
                                <Button Content="{}{{weekday}}" Tag="{}{{weekday}}" Click="BtnInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" Padding="6,2.5" Margin="0,0,4,4" FontSize="10" FontFamily="Cascadia Mono, Consolas"/>
                                <Button Content="{}{{clipboard}}" Tag="{}{{clipboard}}" Click="BtnInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" Padding="6,2.5" Margin="0,0,4,4" FontSize="10" FontFamily="Cascadia Mono, Consolas"/>
                                <Button Content="{}{{guid}}" Tag="{}{{guid}}" Click="BtnInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" Padding="6,2.5" Margin="0,0,4,4" FontSize="10" FontFamily="Cascadia Mono, Consolas"/>
                                <Button Content="{}{{input:名称}}" Tag="{}{{input:名称}}" Click="BtnInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" Padding="6,2.5" Margin="0,0,4,4" FontSize="10" FontFamily="Cascadia Mono, Consolas"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnCancelAddTag" Content="取消" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,6,0" Click="BtnCancelAddTag_Click"/>
                                <Button x:Name="BtnConfirmAddTag" Content="保存" Style="{StaticResource PrimaryBtnStyle}" Click="BtnConfirmAddTag_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 浮层：局域网快传 -->
                <Grid x:Name="LanSyncOverlay" Visibility="Collapsed" Background="#CC09090B">
                    <Border Width="320" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" VerticalAlignment="Center">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SidebarTopIconBtn}" Width="22" Height="22" Click="BtnHideLanSyncOverlay_Click">
                                    <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Width="9" Height="9"/>
                                </Button>
                                <TextBlock x:Name="TxtLanSyncTitle" Text="局域网快传" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="TxtLanSyncSubTitle" Text="同局域网扫码收发" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                            <Border Width="188" Height="188" CornerRadius="8" Background="#FFFFFF" Padding="6" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Image x:Name="ImgLanQrCode" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>

                            <Border Background="{DynamicResource TabContainerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="复制" Style="{StaticResource PrimaryBtnStyle}" FontSize="10" Padding="8,2" Margin="6,0,0,0" Click="BtnCopyLanUrl_Click"/>
                                    <TextBlock x:Name="TxtLanSyncUrl" Text="" FontSize="10.5" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>

                            <TextBlock x:Name="TxtLanSyncLiveStatus" Text="" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="隐藏" Style="{StaticResource SubtleBtnStyle}" Click="BtnHideLanSyncOverlay_Click"/>
                                <Button x:Name="BtnStopLanSync" Grid.Column="2" Content="停止服务" Style="{StaticResource SubtleBtnStyle}" Foreground="#F87171" Click="BtnStopLanSync_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- ================= 底栏 ================= -->
            <Border Grid.Row="2" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusLeft" Text="0 条" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="·" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.45" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtMemoryUsage" Text="-- MB" FontSize="10" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.72" Cursor="Hand" VerticalAlignment="Center" ToolTip="实时内存占用（点击整理）"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSidebarToast" Text="" FontSize="10.5" Foreground="{DynamicResource AccentBlueBrush}" Margin="0,0,10,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatusRightTip" Text="Alt+V" FontSize="10" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.65" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
