<Window x:Class="ClipVault.Views.QuickPasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="ClipVault Quick Paste"
        Width="680" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- 主悬浮卡片容器 (亚克力毛玻璃质感) -->
    <Border Background="#E61C1C24" 
            BorderBrush="#2EFFFFFF" 
            BorderThickness="1" 
            CornerRadius="16" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 搜索栏 -->
                <RowDefinition Height="Auto"/> <!-- 分类标签 -->
                <RowDefinition Height="*"/>    <!-- 列表内容 -->
                <RowDefinition Height="Auto"/> <!-- 底部状态提示 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶部搜索框 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <ui:TextBox x:Name="SearchBox" 
                            PlaceholderText="搜索剪贴板历史、代码、文本... (支持 1~9 数字键秒贴)"
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            TextChanged="SearchBox_TextChanged"
                            KeyDown="SearchBox_KeyDown"
                            FontSize="13"
                            Padding="8,6"/>
            </Grid>

            <!-- 2. 分类筛选 Pills -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:Button x:Name="BtnCatAll" Content="全部" Tag="all" Click="Category_Click" Margin="0,0,6,0" Padding="12,5" CornerRadius="8" Background="#FF0078D4" Foreground="White" BorderThickness="0"/>
                <ui:Button x:Name="BtnCatText" Content="纯文本" Tag="Text" Click="Category_Click" Margin="0,0,6,0" Padding="12,5" CornerRadius="8" Background="#22FFFFFF" Foreground="#DDD" BorderThickness="0"/>
                <ui:Button x:Name="BtnCatCode" Content="&lt;/&gt; 代码片段" Tag="Code" Click="Category_Click" Margin="0,0,6,0" Padding="12,5" CornerRadius="8" Background="#22FFFFFF" Foreground="#DDD" BorderThickness="0"/>
                <ui:Button x:Name="BtnCatImage" Content="🖼️ 截图/图片" Tag="Image" Click="Category_Click" Margin="0,0,6,0" Padding="12,5" CornerRadius="8" Background="#22FFFFFF" Foreground="#DDD" BorderThickness="0"/>
                <ui:Button x:Name="BtnCatPinned" Content="⭐ 已置顶常用" Tag="pinned" Click="Category_Click" Margin="0,0,6,0" Padding="12,5" CornerRadius="8" Background="#22FFFFFF" Foreground="#DDD" BorderThickness="0"/>
            </StackPanel>

            <!-- 3. 剪贴板卡片列表 -->
            <ListBox Grid.Row="2" 
                     x:Name="ItemsListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionMode="Single"
                     MouseDoubleClick="ItemsListBox_MouseDoubleClick"
                     KeyDown="ItemsListBox_KeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" 
                                            Background="#1F242C" 
                                            BorderBrush="#25FFFFFF" 
                                            BorderThickness="1" 
                                            CornerRadius="10" 
                                            Padding="12,10"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF0078D4"/>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2D3545"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#660078D4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- 数字快捷键徽章 -->
                                <ColumnDefinition Width="*"/>    <!-- 内容预览 -->
                                <ColumnDefinition Width="Auto"/> <!-- 置顶与操作 -->
                            </Grid.ColumnDefinitions>

                            <!-- 数字快捷键徽标 -->
                            <Border Grid.Column="0" 
                                    Width="26" Height="26" 
                                    CornerRadius="6" 
                                    Background="#263040" 
                                    BorderBrush="#33FFFFFF" 
                                    BorderThickness="1" 
                                    Margin="0,0,10,0" 
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding DisplayBadge}" 
                                           Foreground="#85B7EB" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- 内容与预览区域 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <!-- 顶部来源与类型 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding SourceApp}" Foreground="#888" FontSize="11" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding FormattedTime}" Foreground="#666" FontSize="11"/>
                                </StackPanel>

                                <!-- 文本模式展示 -->
                                <TextBlock Text="{Binding Content}" 
                                           Foreground="#EDEDED" 
                                           FontSize="13" 
                                           TextTrimming="CharacterEllipsis" 
                                           MaxHeight="40"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"/>

                                <!-- 代码模式展示 -->
                                <Border Background="#14181F" CornerRadius="6" Padding="8,5" Margin="0,2,0,0"
                                        Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Content}" 
                                               FontFamily="Consolas, Cascadia Code, Courier New" 
                                               Foreground="#4EC9B0" 
                                               FontSize="12" 
                                               TextTrimming="CharacterEllipsis" 
                                               MaxHeight="60"/>
                                </Border>

                                <!-- 图片模式展示 -->
                                <Border Background="#14181F" CornerRadius="6" Padding="4" Margin="0,2,0,0" HorizontalAlignment="Left"
                                        Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding FullImagePath}" MaxHeight="80" MaxWidth="160" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Summary}" Foreground="#AAA" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 右侧操作按钮组 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button Content="⭐" 
                                        Tag="{Binding Id}" 
                                        Click="PinButton_Click" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        FontSize="14" 
                                        ToolTip="置顶/取消置顶"
                                        Cursor="Hand"/>
                                <Button Content="🗑️" 
                                        Tag="{Binding Id}" 
                                        Click="DeleteButton_Click" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        FontSize="12" 
                                        Opacity="0.6" 
                                        ToolTip="删除此条"
                                        Cursor="Hand" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 4. 底部快捷键指南 -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="[1~9] 数字秒贴  •  [Enter] 贴入  •  [P] 置顶  •  [Del] 删除  •  [Esc] 隐藏" 
                               Foreground="#777" FontSize="11"/>
                </StackPanel>
                <TextBlock x:Name="StatusToast" Text="✓ 已贴入" Foreground="#4ADE80" FontSize="11" HorizontalAlignment="Right" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
