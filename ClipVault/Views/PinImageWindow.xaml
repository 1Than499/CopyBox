<Window x:Class="ClipVault.Views.PinImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CopyBox 屏幕贴图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown"
        MouseWheel="Window_MouseWheel"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Grid Margin="6">
        <Border x:Name="FrameBorder"
                CornerRadius="8"
                BorderBrush="#6638BDF8"
                BorderThickness="1.5"
                Background="#01000000"
                MouseLeftButtonDown="FrameBorder_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.45"/>
            </Border.Effect>
            <Grid>
                <Border CornerRadius="7" ClipToBounds="True">
                    <Image x:Name="PinImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- 悬停顶部极简浮层控制条 -->
                <Border x:Name="HoverBar"
                        Visibility="Collapsed"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Margin="6"
                        Padding="6,3"
                        CornerRadius="6"
                        Background="#CC0F172A"
                        BorderBrush="#5538BDF8"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtScaleBadge" Text="100%" FontSize="10" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="📋" ToolTip="复制图片到剪贴板" Click="BtnCopy_Click" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" FontSize="11" Padding="3,0" Margin="0,0,4,0" Cursor="Hand"/>
                        <Button Content="✕" ToolTip="关闭贴图 (双击图片 / Esc)" Click="BtnClose_Click" Background="Transparent" Foreground="#F87171" BorderThickness="0" FontSize="11" FontWeight="Bold" Padding="3,0" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
