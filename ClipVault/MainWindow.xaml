<Window x:Class="ClipVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:ClipVault.Helpers"
        mc:Ignorable="d"
        Title="CopyBox"
        Width="600" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MouseDown="Window_MouseDown"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 初始中性炭黑色板（由 ThemePalette.Apply 统一覆盖） -->
        <SolidColorBrush x:Key="CardBgBrush" Color="#18181C"/>
        <SolidColorBrush x:Key="CardHoverBgBrush" Color="#232329"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#27272E"/>
        <SolidColorBrush x:Key="CardTextBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E96"/>
        <SolidColorBrush x:Key="CodeBgBrush" Color="#121216"/>
        <SolidColorBrush x:Key="CodeBoxBgBrush" Color="#121216"/>
        <SolidColorBrush x:Key="CodeTextBrush" Color="#A1E3CB"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#8E8E96"/>
        <SolidColorBrush x:Key="TitleTextBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#27272E"/>
        <SolidColorBrush x:Key="SearchBgBrush" Color="#151519"/>
        <SolidColorBrush x:Key="SearchBorderBrush" Color="#27272E"/>
        <SolidColorBrush x:Key="TabContainerBgBrush" Color="#151519"/>
        <SolidColorBrush x:Key="TileBgBrush" Color="#18181C"/>
        <SolidColorBrush x:Key="TileHoverBgBrush" Color="#232329"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="SliderTrackBgBrush" Color="#32323A"/>
        <SolidColorBrush x:Key="HoverBgBrush" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="PressedBgBrush" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="InfoBgBrush" Color="#151519"/>
        <SolidColorBrush x:Key="InfoBorderBrush" Color="#27272E"/>
        <SolidColorBrush x:Key="InfoTextBrush" Color="#8E8E96"/>
        <SolidColorBrush x:Key="TopPillBgBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TopPillBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TopButtonFgBrush" Color="#8E8E96"/>
        <SolidColorBrush x:Key="TabPillBgBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TabPillBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TabPillFgBrush" Color="#8E8E96"/>
        <SolidColorBrush x:Key="SelectedBorderBrush" Color="#3F3F48"/>
        <SolidColorBrush x:Key="MenuBgBrush" Color="#FA18181C"/>
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#27272E"/>
        <SolidColorBrush x:Key="MenuTextBrush" Color="#F4F4F5"/>
    </Window.Resources>

    <Border x:Name="MainBorder"
            Background="#F0111114"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.22" Color="Black"/>
        </Border.Effect>

        <Grid>
            <!-- 自定义背景壁纸 -->
            <Border x:Name="MainBgImageContainer" CornerRadius="14" ClipToBounds="True" Visibility="Collapsed">
                <Grid>
                    <Image x:Name="ImgMainCustomBg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border x:Name="BdMainCustomBgOverlay" Background="#990E0E12"/>
                </Grid>
            </Border>

            <Grid x:Name="MainRootGrid" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 极简顶栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Rectangle Fill="Transparent"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource CardHoverBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconClipboard}" Stroke="{DynamicResource TitleTextBrush}" StrokeThickness="1.4" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CopyBox" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TitleTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtMainAppVersion" Text="v3.9.0" FontSize="10" Foreground="{DynamicResource SubTextBrush}" Opacity="0.55" Margin="7,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnMainLanSync" Style="{StaticResource TopIconButtonStyle}" Click="BtnMainLanSync_Click" ToolTip="局域网快传">
                            <Path Data="{StaticResource IconPhone}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="BtnQuickTheme" Content="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Style="{StaticResource TopIconButtonStyle}" Click="BtnQuickTheme_Click" ToolTip="切换明暗"/>
                        <Button x:Name="BtnToggleSettings" Style="{StaticResource TopIconButtonStyle}" Click="BtnToggleSettings_Click" ToolTip="设置">
                            <Path Data="{StaticResource IconSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Stretch="Uniform" Width="12.5" Height="12.5"/>
                        </Button>
                        <Button x:Name="BtnMinimizeWindow" Style="{StaticResource TopIconButtonStyle}" Click="BtnMinimizeWindow_Click" ToolTip="最小化">
                            <Path Data="{StaticResource IconMinimize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Width="10" Height="10"/>
                        </Button>
                        <Button x:Name="BtnCloseWindow" Style="{StaticResource CloseIconButtonStyle}" Click="BtnCloseWindow_Click" ToolTip="收起">
                            <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Width="10" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 居中命令搜索栏 -->
                <Border x:Name="SearchBorder" Grid.Row="1" Background="{DynamicResource SearchBgBrush}" BorderBrush="{DynamicResource SearchBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Height="38" Padding="12,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.4" Stretch="Uniform" Width="13" Height="13" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchInputBox" Grid.Column="1" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TitleTextBrush}" CaretBrush="{DynamicResource TitleTextBrush}"
                                 FontSize="13" VerticalAlignment="Center" Padding="0,2"
                                 TextChanged="SearchInputBox_TextChanged" KeyDown="SearchInputBox_KeyDown">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="Transparent" BorderThickness="0">
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索..." Grid.Column="1" Foreground="{DynamicResource SubTextBrush}" Opacity="0.7" FontSize="13" IsHitTestVisible="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 简洁分类条 -->
                <ScrollViewer x:Name="MainCategoryScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10" PreviewMouseWheel="MainCategoryScrollViewer_PreviewMouseWheel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="TabAll" Content="全部" Tag="all" Click="TabCategory_Click" Margin="0,0,4,0" Padding="10,4" Background="{DynamicResource CardHoverBgBrush}" Foreground="{DynamicResource TitleTextBrush}" BorderThickness="0" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="TabText" Content="文本" Tag="Text" Click="TabCategory_Click" Margin="0,0,4,0" Padding="10,4" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" FontSize="11.5" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="TabImages" Content="图片" Tag="Image" Click="TabCategory_Click" Margin="0,0,4,0" Padding="10,4" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" FontSize="11.5" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="TabCode" Content="代码" Tag="Code" Click="TabCategory_Click" Margin="0,0,4,0" Padding="10,4" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" FontSize="11.5" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="TabStarred" Content="置顶" Tag="pinned" Click="TabCategory_Click" Margin="0,0,4,0" Padding="10,4" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" FontSize="11.5" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <StackPanel x:Name="MainCustomTagsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <Button x:Name="BtnMainAddTag" Style="{StaticResource TopIconButtonStyle}" Width="24" Height="24" Margin="2,0,0,0" Click="BtnMainAddTag_Click" ToolTip="新建分组">
                            <Path Data="{StaticResource IconPlus}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform" Width="10" Height="10"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 双列卡片列表（常态极简，Hover 显现操作） -->
                <Grid Grid.Row="3">
                    <ListBox x:Name="CardsListBox" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single"
                             MouseDoubleClick="CardsListBox_MouseDoubleClick"
                             KeyDown="CardsListBox_KeyDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,8,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="MainCard_PreviewMouseLeftButtonDown"/>
                                <EventSetter Event="PreviewMouseMove" Handler="MainCard_PreviewMouseMove"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown"/>
                                <EventSetter Event="MouseRightButtonUp" Handler="ListBoxItem_MouseRightButtonUp"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBorder"
                                                    Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,10"
                                                    MinHeight="132"
                                                    MaxHeight="158"
                                                    Cursor="Hand"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 卡片内容 -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6"
                                                Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock helpers:CodeHighlighter.HighlightCode="{Binding DisplayContent}"
                                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                                       Foreground="{DynamicResource CodeTextBrush}"
                                                       FontSize="11" LineHeight="16" MaxHeight="90" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{Binding ImagePreview}" MaxHeight="88" MaxWidth="220" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <DockPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" LastChildFill="True">
                                            <Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="3" Margin="0,3,7,0" VerticalAlignment="Top"
                                                    Background="{Binding ColorSwatchBrush}" BorderBrush="#44FFFFFF" BorderThickness="0.8"
                                                    Visibility="{Binding HasColorSwatch, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding DisplayContent}" Foreground="{DynamicResource CardTextBrush}"
                                                       FontSize="12" MaxHeight="92" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" LineHeight="17.5"/>
                                        </DockPanel>
                                    </Grid>

                                    <!-- 极简底栏：常态显示来源+序号，Hover 显现操作 -->
                                    <Grid Grid.Row="1" MinHeight="20">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBlueBrush}" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding SourceApp}" Foreground="{DynamicResource SubTextBrush}" FontSize="10" MaxWidth="95" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasCustomTag, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding CustomTagBadgeText}" Foreground="{DynamicResource SubTextBrush}" FontSize="9"/>
                                            </Border>
                                            <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="4" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsOcrKeywordMatched, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding OcrMatchedBadgeText}" Foreground="{DynamicResource AccentBlueBrush}" FontSize="9"/>
                                            </Border>
                                            <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="4" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding ShowSensitiveBadge, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding SensitiveTypeTag}" Foreground="{DynamicResource SubTextBrush}" FontSize="9"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding DisplayBadge}" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource SubTextBrush}" Opacity="0.45" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="20" Height="18" Click="BtnMainToggleMask_Click" ToolTip="{Binding MaskToggleTooltip}"
                                                    Visibility="{Binding ShowSensitiveBadge, Converter={StaticResource BoolToVis}}">
                                                <Path Data="{StaticResource IconEye}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10"/>
                                            </Button>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="20" Height="18" Click="BtnMainExtractOcr_Click" ToolTip="提取文字"
                                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                                <Path Data="{StaticResource IconOcr}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10"/>
                                            </Button>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="20" Height="18" Click="BtnMainPinScreen_Click" ToolTip="钉在屏幕上"
                                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                                <Path Data="{StaticResource IconPinScreen}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10"/>
                                            </Button>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="20" Height="18" Click="BtnMainOpenUrl_Click" ToolTip="打开链接"
                                                    Visibility="{Binding IsUrl, Converter={StaticResource BoolToVis}}">
                                                <Path Data="{StaticResource IconLink}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10"/>
                                            </Button>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="20" Height="18" Click="BtnMainCardAssignTag_Click" ToolTip="分组">
                                                <Path Data="{StaticResource IconTag}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10"/>
                                            </Button>
                                            <Button Style="{StaticResource SidebarTopIconBtn}" Width="20" Height="18" Tag="{Binding Id}" Click="ItemMenu_Click" ToolTip="更多">
                                                <Path Data="{StaticResource IconMore}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Width="10" Height="10"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- 极简底栏 -->
                <Border Grid.Row="4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="2,7,2,1">
                    <Grid>
                        <TextBlock x:Name="TxtBottomTips" Text="Enter 贴入 · Shift+Enter 纯文本 · 1–9 速贴 · Esc 收起" Foreground="{DynamicResource SubTextBrush}" Opacity="0.65" FontSize="10" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ToastText" Text="" Foreground="{DynamicResource AccentBlueBrush}" FontSize="10.5" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtMainMemoryUsage" Text="-- MB" Foreground="{DynamicResource SubTextBrush}" Opacity="0.68" FontSize="10" FontFamily="Cascadia Mono, Consolas" Cursor="Hand" VerticalAlignment="Center" ToolTip="实时内存占用（点击整理）"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 浮层设置面板 -->
                <Grid x:Name="SettingsOverlayHost" Grid.Row="0" Grid.RowSpan="5" Visibility="Collapsed" Width="430" MaxHeight="470" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SettingsTransform" X="0" Y="0"/>
                    </Grid.RenderTransform>

                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Margin="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.4" Color="Black"/>
                        </Border.Effect>
                    </Border>

                    <Border x:Name="SettingsOverlayCard" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="SettingsDragBar" Grid.Row="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10" Cursor="SizeAll" MouseLeftButtonDown="SettingsDragBar_MouseDown" MouseMove="SettingsDragBar_MouseMove" MouseLeftButtonUp="SettingsDragBar_MouseUp">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSettingsTitle" Text="设置" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TitleTextBrush}"/>
                                        <TextBlock x:Name="TxtSettingsDragTip" Text="" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource CloseIconButtonStyle}" Width="24" Height="22" Click="BtnCloseSettingsOverlay_Click">
                                        <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Width="9.5" Height="9.5"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10,12,8">
                                <StackPanel>
                                    <!-- 通用 -->
                                    <TextBlock x:Name="TxtWindowModeTitle" Text="通用" Style="{StaticResource SettingsSectionLabelStyle}"/>
                                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadioModeSidebar" GroupName="WindowModeGroup" Content="侧边栏" Style="{StaticResource SegmentedRadioStyle}" Checked="WindowMode_Changed"/>
                                                        <RadioButton x:Name="RadioModeCentered" GroupName="WindowModeGroup" Content="居中" Style="{StaticResource SegmentedRadioStyle}" Checked="WindowMode_Changed"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="形态" FontSize="11.5" Foreground="{DynamicResource CardTextBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadioLangZh" GroupName="LanguageGroup" Content="中文" Style="{StaticResource SegmentedRadioStyle}" Checked="LangRadio_Changed"/>
                                                        <RadioButton x:Name="RadioLangEn" GroupName="LanguageGroup" Content="English" Style="{StaticResource SegmentedRadioStyle}" Checked="LangRadio_Changed"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock x:Name="TxtLanguageTitle" Text="语言" FontSize="11.5" Foreground="{DynamicResource CardTextBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadioMainDockLeft" GroupName="MainDockEdgeGroup" Content="左侧" Style="{StaticResource SegmentedRadioStyle}" Checked="MainDockEdgeRadio_Changed"/>
                                                        <RadioButton x:Name="RadioMainDockRight" GroupName="MainDockEdgeGroup" Content="右侧" Style="{StaticResource SegmentedRadioStyle}" Checked="MainDockEdgeRadio_Changed"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock x:Name="TxtMainDockEdgeLabel" Text="贴边方向" FontSize="11.5" Foreground="{DynamicResource CardTextBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadioMainMonitorCursor" GroupName="MainMonitorStrategyGroup" Content="跟随鼠标" Style="{StaticResource SegmentedRadioStyle}" Checked="MainMonitorStrategyRadio_Changed"/>
                                                        <RadioButton x:Name="RadioMainMonitorPrimary" GroupName="MainMonitorStrategyGroup" Content="主屏幕" Style="{StaticResource SegmentedRadioStyle}" Checked="MainMonitorStrategyRadio_Changed"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock x:Name="TxtMainMonitorStrategyLabel" Text="屏幕位置" FontSize="11.5" Foreground="{DynamicResource CardTextBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock x:Name="TxtMainDockAndMonitorTitle" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 外观 -->
                                    <TextBlock x:Name="TxtAppearanceTitle" Text="外观" Style="{StaticResource SettingsSectionLabelStyle}"/>
                                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                                        <StackPanel>
                                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                                <RadioButton x:Name="RadioThemeDark" Style="{StaticResource ThemeCardRadioStyle}" GroupName="ThemeGroup" Content="深色" FontSize="11" Margin="2" Checked="ThemeRadio_Changed"/>
                                                <RadioButton x:Name="RadioThemeLight" Style="{StaticResource ThemeCardRadioStyle}" GroupName="ThemeGroup" Content="浅色" FontSize="11" Margin="2" Checked="ThemeRadio_Changed"/>
                                                <RadioButton x:Name="RadioThemeAurora" Style="{StaticResource ThemeCardRadioStyle}" GroupName="ThemeGroup" Content="极光" FontSize="11" Margin="2" Checked="ThemeRadio_Changed"/>
                                                <RadioButton x:Name="RadioThemeSunset" Style="{StaticResource ThemeCardRadioStyle}" GroupName="ThemeGroup" Content="暮色" FontSize="11" Margin="2" Checked="ThemeRadio_Changed"/>
                                                <RadioButton x:Name="RadioThemeOcean" Style="{StaticResource ThemeCardRadioStyle}" GroupName="ThemeGroup" Content="深海" FontSize="11" Margin="2" Checked="ThemeRadio_Changed"/>
                                                <RadioButton x:Name="RadioThemeCustom" Style="{StaticResource ThemeCardRadioStyle}" GroupName="ThemeGroup" Content="壁纸" FontSize="11" Margin="2" Checked="ThemeRadio_Changed"/>
                                            </UniformGrid>

                                            <Border x:Name="BdMainCustomImageSettings" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="8,7" Margin="0,0,0,8" Visibility="Collapsed">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="TxtMainCustomBgPath" Grid.Column="0" Text="内置壁纸" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                                        <Button x:Name="BtnMainUploadBg" Grid.Column="1" Content="选择图片" Click="BtnMainUploadBg_Click" Style="{StaticResource SubtleBtnStyle}" Padding="8,3" Margin="0,0,4,0"/>
                                                        <Button x:Name="BtnMainResetBg" Grid.Column="2" Content="重置" Click="BtnMainResetBg_Click" Style="{StaticResource SubtleBtnStyle}" Padding="8,3"/>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="TxtMainBgOverlayLabel" Grid.Column="0" Text="遮罩" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <Slider x:Name="SliderMainBgOverlay" Style="{StaticResource ModernFluentSliderStyle}" Grid.Column="1" Minimum="0.10" Maximum="0.90" Value="0.55" ValueChanged="SliderMainBgOverlay_ValueChanged" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtMainBgOverlayValue" Grid.Column="2" Text="55%" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" FontFamily="Cascadia Mono, Consolas" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TxtOpacityLabel" Grid.Column="0" Text="透明度" Foreground="{DynamicResource CardTextBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Slider x:Name="SliderOpacity" Style="{StaticResource ModernFluentSliderStyle}" Grid.Column="1" Minimum="0" Maximum="85" Value="8" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderOpacity_ValueChanged" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtOpacityValue" Grid.Column="2" Text="8%" Foreground="{DynamicResource SubTextBrush}" FontSize="11" FontFamily="Cascadia Mono, Consolas" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>

                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadioMainBackdropDefault" GroupName="MainBackdropGroup" Tag="Default" Content="默认" Style="{StaticResource SegmentedRadioStyle}" Checked="MainBackdropRadio_Changed"/>
                                                        <RadioButton x:Name="RadioMainBackdropMica" GroupName="MainBackdropGroup" Tag="Mica" Content="云母" Style="{StaticResource SegmentedRadioStyle}" Checked="MainBackdropRadio_Changed"/>
                                                        <RadioButton x:Name="RadioMainBackdropAcrylic" GroupName="MainBackdropGroup" Tag="Acrylic" Content="亚克力" Style="{StaticResource SegmentedRadioStyle}" Checked="MainBackdropRadio_Changed"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock x:Name="TxtMainBackdropLabel" Text="窗口材质" FontSize="11.5" Foreground="{DynamicResource CardTextBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock x:Name="TxtMainBackdropAndAudioTitle" Visibility="Collapsed"/>
                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                            <CheckBox x:Name="ChkMainSoundEffects" Content="交互提示音" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource CardTextBrush}" FontSize="11.5" Click="ChkMainSoundEffects_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 隐私 -->
                                    <TextBlock x:Name="TxtMainSmartGuardTitle" Text="隐私" Style="{StaticResource SettingsSectionLabelStyle}"/>
                                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkMainFullscreenDnd" Content="全屏自动免打扰" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource CardTextBrush}" FontSize="11.5" Click="ChkMainSmartGuard_Click"/>
                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                            <CheckBox x:Name="ChkMainManualDnd" Content="暂停贴边呼出" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource CardTextBrush}" FontSize="11.5" Click="ChkMainSmartGuard_Click"/>
                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                            <CheckBox x:Name="ChkMainAutoMaskSensitive" Content="敏感信息遮罩" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource CardTextBrush}" FontSize="11.5" Click="ChkMainSmartGuard_Click"/>
                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                            <CheckBox x:Name="ChkMainIgnorePasswordManagers" Content="忽略密码工具" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource CardTextBrush}" FontSize="11.5" Click="ChkMainSmartGuard_Click"/>
                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                            <DockPanel>
                                                <TextBlock x:Name="TxtMainPrivacyBlacklistLabel" Text="排除进程" Foreground="{DynamicResource CardTextBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox x:Name="TxtMainPrivacyBlacklist" Background="{DynamicResource TabContainerBgBrush}" Foreground="{DynamicResource CardTextBrush}" CaretBrush="{DynamicResource CardTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="7,4" FontSize="11" LostFocus="TxtMainPrivacyBlacklist_LostFocus"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 存储 -->
                                    <TextBlock x:Name="TxtStoragePathTitle" Text="存储" Style="{StaticResource SettingsSectionLabelStyle}"/>
                                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkMainFollowAppDir" Content="随程序目录" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource CardTextBrush}" FontSize="11.5" Checked="ChkMainFollowAppDir_Changed" Unchecked="ChkMainFollowAppDir_Changed"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="BdMainStoragePath" Grid.Column="0" Background="{DynamicResource TabContainerBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0">
                                                    <TextBox x:Name="TxtSettingsStoragePath" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" Padding="8,4" FontSize="10.5"/>
                                                </Border>
                                                <Button x:Name="BtnBrowseStorage" Grid.Column="1" Content="更改" Click="BtnBrowseStorage_Click" Style="{StaticResource SubtleBtnStyle}"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtStorageStatusInfo" Text="0 条记录 · 0 置顶 · 0 图片" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" Margin="2,6,0,0"/>

                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                            <CheckBox x:Name="ChkMainDeduplicateOnCopy" Content="合并重复复制" IsChecked="True" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource CardTextBrush}" FontSize="11.5" Click="ChkMainDeduplicateOnCopy_Click"/>
                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>

                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadioMainMaxHist200" Content="200" Tag="200" GroupName="MainMaxHist" Style="{StaticResource SegmentedRadioStyle}" Padding="6,3" FontSize="10" Checked="MainMaxHistoryRadio_Changed"/>
                                                        <RadioButton x:Name="RadioMainMaxHist500" Content="500" Tag="500" GroupName="MainMaxHist" Style="{StaticResource SegmentedRadioStyle}" Padding="6,3" FontSize="10" Checked="MainMaxHistoryRadio_Changed"/>
                                                        <RadioButton x:Name="RadioMainMaxHist1000" Content="1000" Tag="1000" GroupName="MainMaxHist" IsChecked="True" Style="{StaticResource SegmentedRadioStyle}" Padding="6,3" FontSize="10" Checked="MainMaxHistoryRadio_Changed"/>
                                                        <RadioButton x:Name="RadioMainMaxHist2000" Content="2000" Tag="2000" GroupName="MainMaxHist" Style="{StaticResource SegmentedRadioStyle}" Padding="6,3" FontSize="10" Checked="MainMaxHistoryRadio_Changed"/>
                                                        <RadioButton x:Name="RadioMainMaxHist0" Content="不限" Tag="0" GroupName="MainMaxHist" Style="{StaticResource SegmentedRadioStyle}" Padding="6,3" FontSize="10" Checked="MainMaxHistoryRadio_Changed"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock x:Name="TxtMainMaxHistoryLabel" Text="保留上限" Foreground="{DynamicResource CardTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                            <Button x:Name="BtnMainBackfillOcr" Content="旧图 OCR 索引" Click="BtnMainBackfillOcr_Click" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnMainExportBackup" Grid.Column="0" Content="导出配置" Click="BtnMainExportBackup_Click" Style="{StaticResource SubtleBtnStyle}"/>
                                                <Button x:Name="BtnMainImportBackup" Grid.Column="2" Content="导入配置" Click="BtnMainImportBackup_Click" Style="{StaticResource SubtleBtnStyle}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 交互 -->
                                    <TextBlock x:Name="TxtDoubleClickTitle" Text="交互" Style="{StaticResource SettingsSectionLabelStyle}"/>
                                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadioDoubleClickCopy" GroupName="DoubleClickGroup" Content="复制" Style="{StaticResource SegmentedRadioStyle}" Checked="DoubleClickRadio_Changed"/>
                                                        <RadioButton x:Name="RadioDoubleClickPaste" GroupName="DoubleClickGroup" Content="贴入并收起" Style="{StaticResource SegmentedRadioStyle}" Checked="DoubleClickRadio_Changed"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="双击卡片" FontSize="11.5" Foreground="{DynamicResource CardTextBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="6" Padding="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RadioCloseMinimize" GroupName="CloseActionGroup" Content="收起至托盘" Style="{StaticResource SegmentedRadioStyle}" Checked="CloseActionRadio_Changed"/>
                                                        <RadioButton x:Name="RadioCloseExit" GroupName="CloseActionGroup" Content="退出程序" Style="{StaticResource SegmentedRadioStyle}" Checked="CloseActionRadio_Changed"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock x:Name="TxtCloseActionTitle" Text="关闭行为" FontSize="11.5" Foreground="{DynamicResource CardTextBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Border Style="{StaticResource SettingsHairlineStyle}"/>
                                            <CheckBox x:Name="ChkHideOnDeactivate" Content="点击外部隐藏" Style="{StaticResource FluentToggleSwitchStyle}" Foreground="{DynamicResource CardTextBrush}" FontSize="11.5" Click="ChkHideOnDeactivate_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button x:Name="BtnMainClearHistory" Content="清空历史" Click="BtnMainClearHistory_Click" Background="Transparent" Foreground="#F87171" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="0,0,12,0"/>
                                        <Button x:Name="BtnDirectExit" Content="退出" Click="BtnDirectExit_Click" Background="Transparent" Foreground="#EF4444" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                                    </StackPanel>
                                    <Button x:Name="BtnCloseSettingsOverlay" Content="完成" Click="BtnCloseSettingsOverlay_Click" Style="{StaticResource PrimaryBtnStyle}" HorizontalAlignment="Right" Padding="16,4.5"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 浮层：新建分组与模板 -->
                <Border x:Name="MainAddTagOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#CC09090B" CornerRadius="14" Visibility="Collapsed" Panel.ZIndex="100">
                    <Border Width="350" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="TxtMainAddTagDialogTitle" Text="新建分组" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TitleTextBrush}" Margin="0,0,0,12"/>
                            <TextBlock x:Name="TxtMainAddTagDialogSub" Visibility="Collapsed"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtMainAddTagIconLabel" Text="符号" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtMainNewTagIcon" Text="#" MaxLength="4" FontSize="12.5" HorizontalContentAlignment="Center" Padding="4,5" Background="{DynamicResource SearchBgBrush}" Foreground="{DynamicResource TitleTextBrush}" CaretBrush="{DynamicResource TitleTextBrush}" BorderBrush="{DynamicResource SearchBorderBrush}" BorderThickness="1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TxtMainAddTagNameLabel" Text="名称" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtMainNewTagName" MaxLength="14" FontSize="12.5" Padding="8,5" Background="{DynamicResource SearchBgBrush}" Foreground="{DynamicResource TitleTextBrush}" CaretBrush="{DynamicResource TitleTextBrush}" BorderBrush="{DynamicResource SearchBorderBrush}" BorderThickness="1" KeyDown="TxtMainNewTagName_KeyDown"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TxtMainAddTagTemplateLabel" Text="模板内容（可选）" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtMainNewTagTemplateContent" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="11.5" Padding="8,6" Margin="0,0,0,8" Background="{DynamicResource SearchBgBrush}" Foreground="{DynamicResource TitleTextBrush}" CaretBrush="{DynamicResource TitleTextBrush}" BorderBrush="{DynamicResource SearchBorderBrush}" BorderThickness="1"/>

                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="{}{{date}}" Tag="{}{{date}}" Click="BtnMainInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" FontSize="10" FontFamily="Cascadia Mono, Consolas" Padding="6,2" Margin="0,0,4,4"/>
                                <Button Content="{}{{time}}" Tag="{}{{time}}" Click="BtnMainInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" FontSize="10" FontFamily="Cascadia Mono, Consolas" Padding="6,2" Margin="0,0,4,4"/>
                                <Button Content="{}{{datetime}}" Tag="{}{{datetime}}" Click="BtnMainInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" FontSize="10" FontFamily="Cascadia Mono, Consolas" Padding="6,2" Margin="0,0,4,4"/>
                                <Button Content="{}{{weekday}}" Tag="{}{{weekday}}" Click="BtnMainInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" FontSize="10" FontFamily="Cascadia Mono, Consolas" Padding="6,2" Margin="0,0,4,4"/>
                                <Button Content="{}{{clipboard}}" Tag="{}{{clipboard}}" Click="BtnMainInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" FontSize="10" FontFamily="Cascadia Mono, Consolas" Padding="6,2" Margin="0,0,4,4"/>
                                <Button Content="{}{{guid}}" Tag="{}{{guid}}" Click="BtnMainInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" FontSize="10" FontFamily="Cascadia Mono, Consolas" Padding="6,2" Margin="0,0,4,4"/>
                                <Button Content="{}{{input:名称}}" Tag="{}{{input:名称}}" Click="BtnMainInsertMacroToken_Click" Style="{StaticResource SubtleBtnStyle}" FontSize="10" FontFamily="Cascadia Mono, Consolas" Padding="6,2" Margin="0,0,4,4"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnMainCancelAddTag" Content="取消" Click="BtnMainCancelAddTag_Click" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,6,0"/>
                                <Button x:Name="BtnMainConfirmAddTag" Content="保存" Click="BtnMainConfirmAddTag_Click" Style="{StaticResource PrimaryBtnStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- 浮层：局域网快传 -->
                <Border x:Name="MainLanSyncOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#CC09090B" CornerRadius="14" Visibility="Collapsed" Panel.ZIndex="105">
                    <Border Width="340" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource TopIconButtonStyle}" Width="22" Height="22" Click="BtnMainHideLanSyncOverlay_Click">
                                    <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Width="9" Height="9"/>
                                </Button>
                                <TextBlock x:Name="TxtMainLanSyncTitle" Text="局域网快传" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TitleTextBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="TxtMainLanSyncSubTitle" Text="同局域网扫码收发" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,12"/>

                            <Border Width="188" Height="188" Background="White" CornerRadius="8" Padding="6" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Image x:Name="ImgMainLanQrCode" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>

                            <Border Background="{DynamicResource SearchBgBrush}" BorderBrush="{DynamicResource SearchBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8">
                                <DockPanel>
                                    <Button x:Name="BtnMainCopyLanUrl" DockPanel.Dock="Right" Content="复制" Click="BtnMainCopyLanUrl_Click" Style="{StaticResource PrimaryBtnStyle}" FontSize="10" Padding="8,2" Margin="6,0,0,0"/>
                                    <TextBlock x:Name="TxtMainLanSyncUrl" Text="" FontSize="10.5" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>

                            <TextBlock x:Name="TxtMainLanSyncLiveStatus" Text="" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnMainKeepLanSyncRunning" Grid.Column="0" Content="隐藏" Click="BtnMainHideLanSyncOverlay_Click" Style="{StaticResource SubtleBtnStyle}"/>
                                <Button x:Name="BtnMainStopLanSync" Grid.Column="2" Content="停止服务" Click="BtnMainStopLanSync_Click" Style="{StaticResource SubtleBtnStyle}" Foreground="#F87171"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
