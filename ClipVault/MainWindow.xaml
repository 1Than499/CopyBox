<Window x:Class="ClipVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="ClipVault"
        Width="780" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- 动态主题色板初始资源（深色/浅色模式动态覆盖） -->
        <SolidColorBrush x:Key="CardBgBrush" Color="#181C25"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#283242"/>
        <SolidColorBrush x:Key="CardTextBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CodeBgBrush" Color="#11141B"/>
        <SolidColorBrush x:Key="CodeTextBrush" Color="#34D399"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#718096"/>
        <SolidColorBrush x:Key="TitleTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#334050"/>
        <SolidColorBrush x:Key="SearchBgBrush" Color="#13161F"/>
        <SolidColorBrush x:Key="SearchBorderBrush" Color="#283242"/>
        <SolidColorBrush x:Key="HoverBgBrush" Color="#20FFFFFF"/>
        <SolidColorBrush x:Key="PressedBgBrush" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="InfoBgBrush" Color="#162234"/>
        <SolidColorBrush x:Key="InfoBorderBrush" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="InfoTextBrush" Color="#60A5FA"/>

        <!-- 顶栏极简图标按钮样式 (自适应白天/夜间透明底色，消除深浅色冲突) -->
        <Style x:Key="TopIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶栏关闭按钮专属样式 (悬浮平滑变红) -->
        <Style x:Key="CloseIconButtonStyle" TargetType="Button" BasedOn="{StaticResource TopIconButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C4101E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主窗口毛玻璃圆角容器 (支持自选背景透明度) -->
    <Border x:Name="MainBorder"
            Background="#E6161922" 
            BorderBrush="{DynamicResource WindowBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="18" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 顶栏标题与窗口控制按钮 -->
                <RowDefinition Height="Auto"/> <!-- 搜索框 -->
                <RowDefinition Height="Auto"/> <!-- 胶囊分类选择器 -->
                <RowDefinition Height="*"/>    <!-- 双列卡片网格列表 -->
                <RowDefinition Height="Auto"/> <!-- 底部状态提示 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶栏：软件标志 + 精简现代 Fluent 控制组 -->
            <Grid Grid.Row="0" Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：图标与标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="#FF0078D4" Margin="0,0,8,0">
                        <TextBlock Text="📋" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ClipVault" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TitleTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#250078D4" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="Alt + V 随时唤醒" FontSize="10" Foreground="#0078D4" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- 右侧：精简 Fluent 控制组 (彻底消除按钮冲突与黑块违和感) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 白天/黑夜模式快捷切换 -->
                    <Button x:Name="BtnQuickTheme" 
                            Content="🌙" 
                            Style="{StaticResource TopIconButtonStyle}"
                            Click="BtnQuickTheme_Click" 
                            ToolTip="切换白天明亮 / 夜间暗黑主题"
                            Margin="0,0,2,0"/>

                    <!-- 偏好设置 -->
                    <Button x:Name="BtnToggleSettings" 
                            Content="⚙️" 
                            Style="{StaticResource TopIconButtonStyle}"
                            Click="BtnToggleSettings_Click" 
                            ToolTip="偏好设置与本地存储路径"
                            Margin="0,0,6,0"/>

                    <!-- 纵向分割细线 -->
                    <Rectangle Width="1" Height="14" Fill="{DynamicResource WindowBorderBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                    <!-- 最小化窗口 (缩小界面) -->
                    <Button x:Name="BtnMinimizeWindow" 
                            Content="─" 
                            Style="{StaticResource TopIconButtonStyle}"
                            Click="BtnMinimizeWindow_Click" 
                            ToolTip="最小化窗口到任务栏 (缩小界面)"
                            Margin="0,0,2,0"/>

                    <!-- 关闭窗口按钮 (极简符号，悬浮红底，默认收起到后台托盘) -->
                    <Button x:Name="BtnCloseWindow" 
                            Content="✕" 
                            Style="{StaticResource CloseIconButtonStyle}"
                            Click="BtnCloseWindow_Click" 
                            ToolTip="关闭窗口 (默认收起到后台系统托盘，Alt+V 随时唤起)"/>
                </StackPanel>
            </Grid>

            <!-- 2. 居中流线型搜索框 (还原设计图) -->
            <Border x:Name="SearchBorder"
                    Grid.Row="1" 
                    Background="{DynamicResource SearchBgBrush}" 
                    BorderBrush="{DynamicResource SearchBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="14" 
                    Margin="0,0,0,12" 
                    Padding="12,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchInputBox" 
                             Grid.Column="0" 
                             Style="{x:Null}"
                             Background="Transparent" 
                             BorderThickness="0" 
                             Foreground="{DynamicResource TitleTextBrush}" 
                             CaretBrush="{DynamicResource TitleTextBrush}"
                             FontSize="13" 
                             VerticalAlignment="Center"
                             Padding="0,2"
                             TextChanged="SearchInputBox_TextChanged"
                             KeyDown="SearchInputBox_KeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="Transparent" BorderThickness="0">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Search history... (Alt + 1~9 秒贴，支持关键字搜索)" 
                               Grid.Column="0" 
                               Foreground="{DynamicResource SubTextBrush}" 
                               FontSize="13" 
                               IsHitTestVisible="False" 
                               VerticalAlignment="Center" 
                               Margin="2,0,0,0"/>

                    <TextBlock Grid.Column="1" Text="🔍" FontSize="13" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="6,0,2,0"/>
                </Grid>
            </Border>

            <!-- 3. 胶囊分类选择器 (All, Text, Images, Code, Starred) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="TabAll" Content="📋 All" Tag="all" Click="TabCategory_Click" Margin="0,0,6,0" Padding="14,6" Background="#FF0078D4" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabText" Content="📝 Text" Tag="Text" Click="TabCategory_Click" Margin="0,0,6,0" Padding="14,6" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource SubTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabImages" Content="🖼️ Images" Tag="Image" Click="TabCategory_Click" Margin="0,0,6,0" Padding="14,6" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource SubTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabCode" Content="&lt;/&gt; Code" Tag="Code" Click="TabCategory_Click" Margin="0,0,6,0" Padding="14,6" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource SubTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabStarred" Content="⭐ Starred" Tag="pinned" Click="TabCategory_Click" Margin="0,0,6,0" Padding="14,6" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource SubTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
            </StackPanel>

            <!-- 4. 双列卡片瀑布流网格 (还原概念图中的双列卡片布局) -->
            <Grid Grid.Row="3">
                <ListBox x:Name="CardsListBox" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single"
                         MouseDoubleClick="CardsListBox_MouseDoubleClick"
                         KeyDown="CardsListBox_KeyDown">
                    
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardBorder" 
                                                Background="{DynamicResource CardBgBrush}" 
                                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="12" 
                                                Padding="12"
                                                MinHeight="130"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0078D4"/>
                                                <Setter TargetName="CardBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#0078D4" Opacity="0.4"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0078D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 卡片顶栏 -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 数字快捷键徽章 [1], [2]... -->
                                    <Border Grid.Column="0" 
                                            Background="#250078D4" 
                                            BorderBrush="#400078D4" 
                                            BorderThickness="1" 
                                            CornerRadius="5" 
                                            Padding="6,1" 
                                            Margin="0,0,6,0">
                                        <TextBlock Text="{Binding DisplayBadge}" Foreground="#0078D4" FontWeight="Bold" FontSize="10"/>
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding SourceApp}" Foreground="{DynamicResource SubTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="⭐" Tag="{Binding Id}" Click="PinItem_Click" Background="Transparent" BorderThickness="0" FontSize="12" Margin="0,0,2,0" Cursor="Hand" ToolTip="置顶/取消置顶"/>
                                        <Button Content="🗑️" Tag="{Binding Id}" Click="DeleteItem_Click" Background="Transparent" BorderThickness="0" FontSize="11" Opacity="0.6" Cursor="Hand" ToolTip="删除"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 卡片主体 -->
                                <Grid Grid.Row="1" Margin="0,2,0,6">
                                    <!-- 1. 代码卡片：编辑器语法风格 -->
                                    <Border Background="{DynamicResource CodeBgBrush}" CornerRadius="8" Padding="8,6" 
                                            Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Content}" 
                                                   FontFamily="Consolas, Cascadia Code, Courier New" 
                                                   Foreground="{DynamicResource CodeTextBrush}" 
                                                   FontSize="11" 
                                                   MaxHeight="70"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <!-- 2. 图片卡片：圆角截图缩略图预览 (无锁加载) -->
                                    <Border Background="{DynamicResource CodeBgBrush}" CornerRadius="8" Padding="3" HorizontalAlignment="Center"
                                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{Binding ImagePreview}" MaxHeight="75" MaxWidth="280" Stretch="Uniform"/>
                                    </Border>

                                    <!-- 3. 纯文本卡片：引语/摘要风格 -->
                                    <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="“" Foreground="{DynamicResource SubTextBrush}" FontSize="18" LineHeight="12" Margin="0,-4,0,0"/>
                                        <TextBlock Text="{Binding Content}" 
                                                   Foreground="{DynamicResource CardTextBrush}" 
                                                   FontSize="12" 
                                                   MaxHeight="60"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   LineHeight="16"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 卡片底栏 -->
                                <Grid Grid.Row="2" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding FormattedTime}" Foreground="{DynamicResource SubTextBrush}" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="Enter 粘贴 ↵" Foreground="#0078D4" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 5. 浮层设置面板 (还原设计图右下角，加入主题与透明度滑块) -->
                <Border x:Name="SettingsOverlayCard" 
                        Visibility="Collapsed" 
                        Background="{DynamicResource CardBgBrush}" 
                        BorderBrush="{DynamicResource WindowBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="14" 
                        Width="450" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Bottom" 
                        Margin="0,0,10,10" 
                        Padding="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- 顶栏与关闭设置 -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="⚙️ Settings (本地存储与外观控制)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TitleTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="✕" Click="BtnCloseSettingsOverlay_Click" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" FontSize="12" HorizontalAlignment="Right" Cursor="Hand"/>
                        </Grid>

                        <!-- 自选存储路径 -->
                        <TextBlock Text="Local Storage Path (本地存储路径):" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0">
                                <TextBox x:Name="TxtSettingsStoragePath" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource CardTextBrush}" BorderThickness="0" Padding="6,4" FontSize="11"/>
                            </Border>
                            <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseStorage_Click" Background="#FF0078D4" Foreground="White" BorderThickness="0" Padding="10,4" FontSize="11" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>

                        <!-- 主题与透明度调节 (新增功能) -->
                        <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🎨 界面主题与透明度调节：" Foreground="#0078D4" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RadioThemeDark" Grid.Column="0" GroupName="ThemeGroup" Content="🌙 暗黑夜间模式" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="ThemeRadio_Changed"/>
                                    <RadioButton x:Name="RadioThemeLight" Grid.Column="1" GroupName="ThemeGroup" Content="☀️ 白天明亮模式" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="ThemeRadio_Changed"/>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="透明度:" Foreground="{DynamicResource SubTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider x:Name="SliderOpacity" Grid.Column="1" Minimum="0.55" Maximum="1.00" Value="0.92" SmallChange="0.05" LargeChange="0.10" ValueChanged="SliderOpacity_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtOpacityValue" Grid.Column="2" Text="92%" Foreground="{DynamicResource CardTextBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 窗口关闭动作偏好 -->
                        <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="点击窗口右上角 [✕ 关闭] 时的动作：" Foreground="#0078D4" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                <RadioButton x:Name="RadioCloseMinimize" GroupName="CloseActionGroup" Content="最小化到系统托盘 (继续在后台常驻监听)" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Margin="0,0,0,4" Checked="CloseActionRadio_Changed"/>
                                <RadioButton x:Name="RadioCloseExit" GroupName="CloseActionGroup" Content="直接彻底退出 ClipVault 程序" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="CloseActionRadio_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- 本地状态提示卡片 (还原设计图，自适应白天/黑夜主题) -->
                        <Border Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtStorageStatusInfo" 
                                       Text="ℹ Local SQLite status is active, 100% offline and stored at your local disk." 
                                       Foreground="{DynamicResource InfoTextBrush}" 
                                       FontSize="11" 
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- 底部维护按钮 -->
                        <Grid>
                            <Button Content="🛑 彻底退出程序" Click="BtnDirectExit_Click" Background="Transparent" Foreground="#F87171" BorderThickness="0" FontSize="11" HorizontalAlignment="Left" Cursor="Hand"/>
                            <Button Content="完成" Click="BtnCloseSettingsOverlay_Click" Background="#FF0078D4" Foreground="White" BorderThickness="0" Padding="14,4" FontSize="11" HorizontalAlignment="Right" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. 底部快捷键指南 -->
            <Grid Grid.Row="4" Margin="4,8,4,0">
                <TextBlock Text="[Alt+1~9] 数字秒贴  •  [Enter] 贴入  •  [↑↓] 导航  •  [Del] 删除  •  [Esc] 隐藏" 
                           Foreground="{DynamicResource SubTextBrush}" FontSize="11"/>
                <TextBlock x:Name="ToastText" Text="✓ 已贴入光标位置" Foreground="#34D399" FontSize="11" HorizontalAlignment="Right" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
