<Window x:Class="ClipVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:ClipVault.Helpers"
        mc:Ignorable="d"
        Title="CopyBox"
        Width="580" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MouseDown="Window_MouseDown"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 动态主题色板初始资源（深色/浅色模式动态覆盖） -->
        <SolidColorBrush x:Key="CardBgBrush" Color="#181C25"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#262F3E"/>
        <SolidColorBrush x:Key="CardTextBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="CodeBgBrush" Color="#13161F"/>
        <SolidColorBrush x:Key="CodeTextBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#718096"/>
        <SolidColorBrush x:Key="TitleTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#2E384D"/>
        <SolidColorBrush x:Key="SearchBgBrush" Color="#13161F"/>
        <SolidColorBrush x:Key="SearchBorderBrush" Color="#262E3D"/>
        <SolidColorBrush x:Key="HoverBgBrush" Color="#20FFFFFF"/>
        <SolidColorBrush x:Key="PressedBgBrush" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="InfoBgBrush" Color="#141E2E"/>
        <SolidColorBrush x:Key="InfoBorderBrush" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="InfoTextBrush" Color="#60A5FA"/>

        <!-- 顶栏控制胶囊防透岛资源 (低透明度下依然清晰醒目) -->
        <SolidColorBrush x:Key="TopPillBgBrush" Color="#E61E2532"/>
        <SolidColorBrush x:Key="TopPillBorderBrush" Color="#404E63"/>
        <SolidColorBrush x:Key="TopButtonFgBrush" Color="#FFFFFF"/>

        <!-- 分类胶囊防透实体底色与边框 -->
        <SolidColorBrush x:Key="TabPillBgBrush" Color="#1E2532"/>
        <SolidColorBrush x:Key="TabPillBorderBrush" Color="#3A4659"/>
        <SolidColorBrush x:Key="TabPillFgBrush" Color="#E2E8F0"/>

        <!-- 选中卡片自适应柔和光晕与边框 (彻底消除生硬平切僵死感) -->
        <SolidColorBrush x:Key="SelectedBorderBrush" Color="#38A6FF"/>
        <DropShadowEffect x:Key="SelectedCardEffect" BlurRadius="10" ShadowDepth="0" Color="#0078D4" Opacity="0.40"/>

        <!-- 悬浮微质感菜单资源 (防止纯白压纯白导致的边框割裂) -->
        <SolidColorBrush x:Key="MenuBgBrush" Color="#1E232F"/>
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#374357"/>

        <!-- 极简 4px 现代细线胶囊滚动条 (1:1 还原概念图右侧细滚动条) -->
        <Style x:Key="MinimalScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Rectangle Fill="#525F75" RadiusX="2.5" RadiusY="2.5" Width="5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource MinimalScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶栏极简微型图标按钮样式 (高对比度防透底色) -->
        <Style x:Key="TopIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TopButtonFgBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶栏关闭按钮专属样式 (悬浮平滑变红) -->
        <Style x:Key="CloseIconButtonStyle" TargetType="Button" BasedOn="{StaticResource TopIconButtonStyle}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C4101E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代自适应卡片悬浮菜单样式 (Fluent 风格、双层抗截断阴影、精致圆角与清晰边框) -->
        <Style x:Key="ModernContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <!-- 外层透明隔离边距 (留出 12px 充分空间让 DropShadow 柔和晕染，严防任何切边割裂) -->
                        <Border Padding="10" Background="Transparent" SnapsToDevicePixels="True">
                            <!-- 实体菜单卡片：带饱满微立体柔和阴影与 10px 现代圆角 -->
                            <Border Background="{DynamicResource MenuBgBrush}" 
                                    BorderBrush="{DynamicResource MenuBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="10" 
                                    Padding="5,6"
                                    MinWidth="150"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.30" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代精细菜单项样式 (固定左列矢量纯色图标，右列清晰文字) -->
        <Style x:Key="ModernMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CardTextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="10,0" 
                                Margin="1,1" 
                                SnapsToDevicePixels="True">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="6,0,8,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Background="{DynamicResource CardBorderBrush}" Height="1" Margin="6,4" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主题色板选择胶囊样式 -->
        <Style x:Key="ThemeCardRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.2" CornerRadius="8" Padding="8,6" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{TemplateBinding Tag}" Margin="0,0,5,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2638BDF8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent 现代发光滑块样式 -->
        <Style x:Key="ModernFluentSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="22" Background="Transparent">
                            <Border Height="6" CornerRadius="3" Background="#28FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Opacity="1">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="#38BDF8" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="16" Height="16">
                                                    <Ellipse x:Name="ThumbCircle" Width="14" Height="14" Fill="#FFFFFF" Stroke="#38BDF8" StrokeThickness="2.5">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" Color="#000000"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="Width" Value="16"/>
                                                        <Setter TargetName="ThumbCircle" Property="Height" Value="16"/>
                                                        <Setter TargetName="ThumbCircle" Property="Fill" Value="#38BDF8"/>
                                                        <Setter TargetName="ThumbCircle" Property="Stroke" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主窗口毛玻璃圆角容器 (1:1 还原概念图深邃亚克力外框，彻底消除粗暴生硬黑影) -->
    <Border x:Name="MainBorder"
            Background="#EB181C24" 
            BorderBrush="{DynamicResource WindowBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="16" 
            Margin="6">
        <Border.Effect>
            <!-- 极简自然微弱微阴影：无生硬黑圈、完全在边界内柔和淡出，干净通透 -->
            <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Direction="270" Opacity="0.16" Color="Black"/>
        </Border.Effect>

        <Grid>
            <!-- 自定义背景壁纸图层 -->
            <Border x:Name="MainBgImageContainer" CornerRadius="16" ClipToBounds="True" Visibility="Collapsed">
                <Grid>
                    <Image x:Name="ImgMainCustomBg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border x:Name="BdMainCustomBgOverlay" Background="#8C0D111A"/>
                </Grid>
            </Border>

            <Grid x:Name="MainRootGrid" Margin="16,10,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 顶栏极简微型控制行 -->
                <RowDefinition Height="Auto"/> <!-- 1. 居中流线型搜索框 -->
                <RowDefinition Height="Auto"/> <!-- 2. 胶囊分类选择器 -->
                <RowDefinition Height="*"/>    <!-- 3. 双列卡片网格列表 -->
                <RowDefinition Height="Auto"/> <!-- 4. 底部快捷指南 -->
            </Grid.RowDefinitions>

            <!-- 顶栏极简微型控制行 (完全消除粗大标题，保留缩小与关闭) -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧纯净拖拽区 -->
                <Rectangle Grid.Column="0" Fill="Transparent"/>

                <!-- 右侧极小幽灵控制组 (实体胶囊岛防透底座，保证低透明度下极其醒目) -->
                <Border Grid.Column="1" 
                        Background="{DynamicResource TopPillBgBrush}" 
                        BorderBrush="{DynamicResource TopPillBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="7" 
                        Padding="3,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnQuickTheme" 
                                Content="🌙" 
                                Style="{StaticResource TopIconButtonStyle}"
                                Click="BtnQuickTheme_Click" 
                                ToolTip="切换白天明亮 / 夜间暗黑主题"
                                Margin="0,0,2,0"/>

                        <Button x:Name="BtnToggleSettings" 
                                Content="⚙" 
                                Style="{StaticResource TopIconButtonStyle}"
                                Click="BtnToggleSettings_Click" 
                                ToolTip="偏好设置与本地存储路径"
                                Margin="0,0,3,0"/>

                        <Button x:Name="BtnMinimizeWindow" 
                                Content="─" 
                                Style="{StaticResource TopIconButtonStyle}"
                                Click="BtnMinimizeWindow_Click" 
                                ToolTip="最小化窗口到任务栏 (缩小界面)"
                                Margin="0,0,2,0"/>

                        <Button x:Name="BtnCloseWindow" 
                                Content="✕" 
                                Style="{StaticResource CloseIconButtonStyle}"
                                Click="BtnCloseWindow_Click" 
                                ToolTip="关闭窗口 (收起到后台系统托盘，Alt+V 随时唤起)"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 1. 居中流线型搜索框 (1:1 还原概念图) -->
            <Border x:Name="SearchBorder"
                    Grid.Row="1" 
                    Background="{DynamicResource SearchBgBrush}" 
                    BorderBrush="{DynamicResource SearchBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Margin="0,0,0,12" 
                    Height="40"
                    Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchInputBox" 
                             Grid.Column="0" 
                             Style="{x:Null}"
                             Background="Transparent" 
                             BorderThickness="0" 
                             Foreground="{DynamicResource TitleTextBrush}" 
                             CaretBrush="{DynamicResource TitleTextBrush}"
                             FontSize="13.5" 
                             VerticalAlignment="Center"
                             Padding="0,2"
                             TextChanged="SearchInputBox_TextChanged"
                             KeyDown="SearchInputBox_KeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="Transparent" BorderThickness="0">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Search history..." 
                               Grid.Column="0" 
                               Foreground="{DynamicResource SubTextBrush}" 
                               FontSize="13.5" 
                               IsHitTestVisible="False" 
                               VerticalAlignment="Center" 
                               Margin="2,0,0,0"/>

                    <TextBlock Grid.Column="1" Text="🔍" FontSize="13" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="6,0,2,0"/>
                </Grid>
            </Border>

            <!-- 2. 胶囊分类选择器 (1:1 还原概念图 All, Text, Images, Code, Starred) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
                <Button x:Name="TabAll" Content="📋  All" Tag="all" Click="TabCategory_Click" Margin="0,0,8,0" Padding="14,5" Background="#FF0078D4" Foreground="White" BorderThickness="0" FontSize="11.5" FontWeight="SemiBold">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabText" Content="≡  Text" Tag="Text" Click="TabCategory_Click" Margin="0,0,8,0" Padding="14,5" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource SubTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11.5">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabImages" Content="🖼  Images" Tag="Image" Click="TabCategory_Click" Margin="0,0,8,0" Padding="14,5" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource SubTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11.5">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabCode" Content="&lt;/&gt;  Code" Tag="Code" Click="TabCategory_Click" Margin="0,0,8,0" Padding="14,5" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource SubTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11.5">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabStarred" Content="⭐  Starred" Tag="pinned" Click="TabCategory_Click" Margin="0,0,8,0" Padding="14,5" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource SubTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11.5">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
            </StackPanel>

            <!-- 3. 双列卡片网格列表 (1:1 还原概念图双列排版与选中高亮发光) -->
            <Grid Grid.Row="3">
                <ListBox x:Name="CardsListBox" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single"
                          MouseDoubleClick="CardsListBox_MouseDoubleClick"
                          KeyDown="CardsListBox_KeyDown">
                    
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="7,7,7,7"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown"/>
                            <EventSetter Event="MouseRightButtonUp" Handler="ListBoxItem_MouseRightButtonUp"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardBorder" 
                                                Background="{DynamicResource CardBgBrush}" 
                                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="12" 
                                                Padding="14,12" 
                                                MinHeight="140"
                                                MaxHeight="170"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- 1:1 概念图左上角第一张卡片：自适应高雅微光晕 (彻底消除平切僵硬感) -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}"/>
                                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5"/>
                                                <Setter TargetName="CardBorder" Property="Effect" Value="{DynamicResource SelectedCardEffect}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- 卡片顶栏：图标与角标 -->
                                    <RowDefinition Height="*"/>    <!-- 卡片主体：代码/图片/文本 -->
                                </Grid.RowDefinitions>

                                <!-- 卡片顶栏 (1:1 概念图：左侧类型微图标，右侧快捷序号[2]或三点菜单···) -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧类型微图标 (概念图精髓：代码{ / 图片🖼 / 文本❝ / 剪贴板📋) -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 代码卡片专属金黄色大括号 { -->
                                        <TextBlock Text="{}{" Foreground="#F59E0B" FontWeight="Bold" FontSize="14" FontFamily="Cascadia Code, Consolas"
                                                   Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}" 
                                                   Margin="0,-2,4,0"/>

                                        <!-- 图片卡片专属相框图标 🖼 -->
                                        <TextBlock Text="🖼" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" 
                                                   Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" 
                                                   Margin="0,0,4,0"/>

                                        <!-- 文本卡片专属浅灰色双引号 ❝ -->
                                        <TextBlock Text="❝" Foreground="{DynamicResource SubTextBrush}" FontSize="14" FontWeight="Bold" 
                                                   Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" 
                                                   Margin="0,-4,4,0"/>
                                    </StackPanel>

                                    <!-- 中间来源轻字提示 (低调融入) -->
                                    <TextBlock Grid.Column="1" Text="{Binding SourceApp}" Foreground="{DynamicResource SubTextBrush}" FontSize="9.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.5" Margin="4,0,0,0"/>

                                    <!-- 右侧快捷键角标 [1], [2] 与三点菜单 ··· (1:1 概念图) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 快捷角标 [2], [3] (概念图右侧同款) -->
                                        <Border Background="Transparent" Margin="0,0,5,0"
                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding DisplayBadge}" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- 概念图右上角经典三点交互 ··· -->
                                        <Button Content="···" Tag="{Binding Id}" Click="ItemMenu_Click" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" FontSize="12" Cursor="Hand" ToolTip="{Binding MenuTooltip}" Opacity="0.8"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 卡片主体 (1:1 概念图呈现) -->
                                <Grid Grid.Row="1">
                                    <!-- 1. 代码卡片：真实 JSON/代码编辑器高亮质感 (1:1 还原概念图左上角) -->
                                    <Border Background="{DynamicResource CodeBgBrush}" CornerRadius="8" Padding="10,8" 
                                            Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}">
                                        <TextBlock helpers:CodeHighlighter.HighlightCode="{Binding Content}"
                                                   FontFamily="Cascadia Code, Consolas, Courier New" 
                                                   Foreground="{DynamicResource CodeTextBrush}" 
                                                   FontSize="11" 
                                                   LineHeight="16"
                                                   MaxHeight="95"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <!-- 2. 图片卡片：居中圆角桌面截图/缩略图预览 (1:1 还原概念图右上角) -->
                                    <Border Background="{DynamicResource CodeBgBrush}" CornerRadius="8" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{Binding ImagePreview}" MaxHeight="90" MaxWidth="240" Stretch="Uniform"/>
                                    </Border>

                                    <!-- 3. 纯文本卡片：优雅多行引语段落排版 (1:1 还原概念图左下角) -->
                                    <Border Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Content}" 
                                                   Foreground="{DynamicResource CardTextBrush}" 
                                                   FontSize="11.5" 
                                                   MaxHeight="95"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   LineHeight="17"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 5. 底部快捷键指南 -->
            <Grid Grid.Row="4" Margin="2,6,2,0">
                <TextBlock x:Name="TxtBottomTips" 
                           Text="[Alt+1~9] 数字秒贴  •  [Enter] 贴入  •  [↑↓] 导航  •  [Del] 删除  •  [Esc] 隐藏" 
                           Foreground="{DynamicResource SubTextBrush}" FontSize="10.5"/>
                <TextBlock x:Name="ToastText" Text="✓ 已贴入光标位置" Foreground="#34D399" FontSize="10.5" HorizontalAlignment="Right" Visibility="Collapsed"/>
            </Grid>

            <!-- 6. 浮层设置面板 (可在主窗口内自由独立拖拽，双层防文字模糊架构) -->
            <Grid x:Name="SettingsOverlayHost" 
                  Grid.Row="0"
                  Grid.RowSpan="5"
                  Visibility="Collapsed" 
                  Width="420" 
                  MaxHeight="485"
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Center"
                  TextOptions.TextFormattingMode="Display"
                  TextOptions.TextRenderingMode="ClearType"
                  TextOptions.TextHintingMode="Fixed"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SettingsTransform" X="0" Y="0"/>
                </Grid.RenderTransform>

                <!-- 底层独立纯阴影层 (只投射柔和深邃阴影，绝不包含文字，彻底根除 WPF Effect 导致的文字模糊) -->
                <Border Background="{DynamicResource CardBgBrush}" 
                        CornerRadius="14" 
                        Margin="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black"/>
                    </Border.Effect>
                </Border>

                <!-- 顶层无特效实体内容卡片 (享有 100% 硬件加速与 ClearType 亚像素超清文字渲染) -->
                <Border x:Name="SettingsOverlayCard" 
                        Background="{DynamicResource CardBgBrush}" 
                        BorderBrush="{DynamicResource WindowBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="14" 
                        Padding="0"
                        SnapsToDevicePixels="True">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 固定可拖拽顶栏 -->
                        <RowDefinition Height="*"/>    <!-- 滚动主体内容 -->
                        <RowDefinition Height="Auto"/> <!-- 固定操作底栏 -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: 顶栏抓手区 (光标 SizeAll，按住可移动) -->
                    <Border Grid.Row="0" 
                            x:Name="SettingsDragBar" 
                            Background="{DynamicResource CardBgBrush}" 
                            CornerRadius="14,14,0,0" 
                            Cursor="SizeAll" 
                            Padding="16,12,12,10"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="SettingsDragBar_MouseDown"
                            MouseMove="SettingsDragBar_MouseMove"
                            MouseLeftButtonUp="SettingsDragBar_MouseUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSettingsTitle" Text="⚙ 偏好设置" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TitleTextBrush}"/>
                                <TextBlock x:Name="TxtSettingsDragTip" Text="· 按住可拖拽移动" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" Margin="8,2,0,0" VerticalAlignment="Center" Opacity="0.6"/>
                            </StackPanel>

                            <Button Grid.Column="1" 
                                    Content="✕" 
                                    Click="BtnCloseSettingsOverlay_Click" 
                                    Style="{StaticResource CloseIconButtonStyle}"
                                    Width="24" Height="22" FontSize="11.5"
                                    ToolTip="关闭设置"/>
                        </Grid>
                    </Border>

                    <!-- Row 1: 规范紧凑滚动主体区 -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,10,12,6">
                        <StackPanel>
                            <!-- 0. 语言选择 -->
                            <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLanguageTitle" Text="🌐 界面语言 / Language：" Foreground="#0078D4" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,7"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="RadioLangZh" Grid.Column="0" GroupName="LanguageGroup" Content="简体中文" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="LangRadio_Changed"/>
                                        <RadioButton x:Name="RadioLangEn" Grid.Column="1" GroupName="LanguageGroup" Content="English" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="LangRadio_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 0.5. 界面形态切换 (1.0 居中 vs 2.0 侧边栏) -->
                            <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="TxtWindowModeTitle" Text="🖥️ 界面展示形态偏好：" Foreground="#0078D4" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,7"/>
                                    <StackPanel>
                                        <RadioButton x:Name="RadioModeSidebar" GroupName="WindowModeGroup" Content="📱 v2.0 贴边毛玻璃双模抽屉 (吸附右侧 / 仿生操作中心)" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Margin="0,0,0,6" Checked="WindowMode_Changed"/>
                                        <RadioButton x:Name="RadioModeCentered" GroupName="WindowModeGroup" Content="🪟 v1.0 经典居中极速浮窗 (居中弹出 / 双列卡片网格)" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="WindowMode_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 1. 自选存储路径 -->
                            <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="TxtStoragePathTitle" Text="本地数据存储路径：" Foreground="#0078D4" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0">
                                            <TextBox x:Name="TxtSettingsStoragePath" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource CardTextBrush}" BorderThickness="0" Padding="8,4" FontSize="11"/>
                                        </Border>
                                        <Button x:Name="BtnBrowseStorage" Grid.Column="1" Content="浏览..." Click="BtnBrowseStorage_Click" Background="#263142" Foreground="White" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,4" FontSize="11" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                    <!-- 本地状态提示卡片 -->
                                    <Border Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                        <TextBlock x:Name="TxtStorageStatusInfo" 
                                                   Text="ℹ 本地 SQLite 状态正常：已记录 0 条 (置顶 0)，图片 0 张，数据 100% 物理留存于本地磁盘。" 
                                                   Foreground="{DynamicResource InfoTextBrush}" 
                                                   FontSize="10.5" 
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 2. 主题与透明度调节 (与 2.0 侧边栏设置 100% 同步：6大主题 + 自定义壁纸 + 真实背景透明度) -->
                            <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="TxtAppearanceTitle" Text="🎨 界面外观与背景透明度：" Foreground="#0078D4" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,7"/>
                                    
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <RadioButton x:Name="RadioThemeDark" Style="{StaticResource ThemeCardRadioStyle}" GroupName="ThemeGroup" Tag="#1E293B" Content="🌙 暗夜极客" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="ThemeRadio_Changed"/>
                                        <RadioButton x:Name="RadioThemeLight" Style="{StaticResource ThemeCardRadioStyle}" GroupName="ThemeGroup" Tag="#F8FAFC" Content="☀️ 纯净白天" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="ThemeRadio_Changed"/>
                                        <RadioButton x:Name="RadioThemeAurora" Style="{StaticResource ThemeCardRadioStyle}" GroupName="ThemeGroup" Tag="#8B5CF6" Content="🌌 极光紫霓" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="ThemeRadio_Changed"/>
                                        <RadioButton x:Name="RadioThemeSunset" Style="{StaticResource ThemeCardRadioStyle}" GroupName="ThemeGroup" Tag="#F97316" Content="🌅 落日熔金" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="ThemeRadio_Changed"/>
                                        <RadioButton x:Name="RadioThemeOcean" Style="{StaticResource ThemeCardRadioStyle}" GroupName="ThemeGroup" Tag="#06B6D4" Content="🌊 深海赛博" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="ThemeRadio_Changed"/>
                                        <RadioButton x:Name="RadioThemeCustom" Style="{StaticResource ThemeCardRadioStyle}" GroupName="ThemeGroup" Tag="#EC4899" Content="🖼️ 自定义图" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="ThemeRadio_Changed"/>
                                    </UniformGrid>

                                    <!-- 自定义壁纸图片管理区 -->
                                    <Border x:Name="BdMainCustomImageSettings" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,7" Margin="0,0,0,6" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TxtMainCustomBgPath" Grid.Column="0" Text="默认内置壁纸" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                                <Button x:Name="BtnMainUploadBg" Grid.Column="1" Content="上传壁纸" Click="BtnMainUploadBg_Click" Background="#0284C7" Foreground="White" BorderThickness="0" Padding="8,3" FontSize="10.5" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                </Button>
                                                <Button x:Name="BtnMainResetBg" Grid.Column="2" Content="重置" Click="BtnMainResetBg_Click" Background="#334155" Foreground="White" BorderThickness="0" Padding="7,3" FontSize="10.5" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                </Button>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TxtMainBgOverlayLabel" Grid.Column="0" Text="壁纸暗化遮罩:" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Slider x:Name="SliderMainBgOverlay" Style="{StaticResource ModernFluentSliderStyle}" Grid.Column="1" Minimum="0.10" Maximum="0.90" Value="0.55" ValueChanged="SliderMainBgOverlay_ValueChanged" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtMainBgOverlayValue" Grid.Column="2" Text="55%" Foreground="{DynamicResource TitleTextBrush}" FontSize="10.5" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtOpacityLabel" Grid.Column="0" Text="背景透明度:" Foreground="{DynamicResource SubTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider x:Name="SliderOpacity" Style="{StaticResource ModernFluentSliderStyle}" Grid.Column="1" Minimum="0" Maximum="85" Value="8" SmallChange="1" LargeChange="5" ValueChanged="SliderOpacity_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtOpacityValue" Grid.Column="2" Text="8%" Foreground="{DynamicResource CardTextBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. 窗口关闭动作偏好 -->
                            <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="TxtCloseActionTitle" Text="点击窗口右上角 [✕ 关闭] 时的动作：" Foreground="#0078D4" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                    <RadioButton x:Name="RadioCloseMinimize" GroupName="CloseActionGroup" Content="最小化到系统托盘 (继续在后台常驻监听)" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Margin="0,0,0,4" Checked="CloseActionRadio_Changed"/>
                                    <RadioButton x:Name="RadioCloseExit" GroupName="CloseActionGroup" Content="直接彻底退出 CopyBox 程序" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="CloseActionRadio_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- 4. 双击列表动作偏好与失焦行为 -->
                            <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock x:Name="TxtDoubleClickTitle" Text="🖱 列表与失焦交互偏好：" Foreground="#0078D4" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                    <RadioButton x:Name="RadioDoubleClickCopy" GroupName="DoubleClickGroup" Content="仅复制到剪贴板 (保持窗口打开，绝不收起)" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Margin="0,0,0,4" Checked="DoubleClickRadio_Changed"/>
                                    <RadioButton x:Name="RadioDoubleClickPaste" GroupName="DoubleClickGroup" Content="直接贴入光标处并自动收起到托盘" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Margin="0,0,0,6" Checked="DoubleClickRadio_Changed"/>
                                    <CheckBox x:Name="ChkHideOnDeactivate" 
                                              Content="点击软件区域外(失焦)时自动最小化到托盘" 
                                              Foreground="{DynamicResource CardTextBrush}" 
                                              FontSize="11" 
                                              Click="ChkHideOnDeactivate_Click"
                                              ToolTip="默认不勾选：在外部操作其他软件时保持窗口可见，方便对照查看"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Row 2: 固定底栏 (清空历史 + 退出 + 完成操作) -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource CardBgBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="0,1,0,0" 
                            CornerRadius="0,0,14,14" 
                            Padding="16,8,16,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button x:Name="BtnMainClearHistory" Content="🗑️ 清空历史" Click="BtnMainClearHistory_Click" Background="Transparent" Foreground="#F59E0B" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="0,0,14,0"/>
                                <Button x:Name="BtnDirectExit" Content="🛑 彻底退出程序" Click="BtnDirectExit_Click" Background="Transparent" Foreground="#F87171" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                            </StackPanel>
                            <Button x:Name="BtnCloseSettingsOverlay" Content="完成" Click="BtnCloseSettingsOverlay_Click" Background="#FF0078D4" Foreground="White" BorderThickness="0" Padding="18,5" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" Cursor="Hand" VerticalAlignment="Center">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Grid>
        </Grid>
    </Border>
</Window>
