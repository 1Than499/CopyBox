<Window x:Class="ClipVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:helpers="clr-namespace:ClipVault.Helpers"
        mc:Ignorable="d"
        Title="ClipVault"
        Width="580" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- 动态主题色板初始资源（深色/浅色模式动态覆盖） -->
        <SolidColorBrush x:Key="CardBgBrush" Color="#181C25"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#262F3E"/>
        <SolidColorBrush x:Key="CardTextBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="CodeBgBrush" Color="#13161F"/>
        <SolidColorBrush x:Key="CodeTextBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#718096"/>
        <SolidColorBrush x:Key="TitleTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#2E384D"/>
        <SolidColorBrush x:Key="SearchBgBrush" Color="#13161F"/>
        <SolidColorBrush x:Key="SearchBorderBrush" Color="#262E3D"/>
        <SolidColorBrush x:Key="HoverBgBrush" Color="#20FFFFFF"/>
        <SolidColorBrush x:Key="PressedBgBrush" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="InfoBgBrush" Color="#141E2E"/>
        <SolidColorBrush x:Key="InfoBorderBrush" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="InfoTextBrush" Color="#60A5FA"/>

        <!-- 极简 4px 现代细线胶囊滚动条 (1:1 还原概念图右侧细滚动条) -->
        <Style x:Key="MinimalScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Rectangle Fill="#525F75" RadiusX="2.5" RadiusY="2.5" Width="5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource MinimalScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶栏极简微型图标按钮样式 (自适应白天/夜间透明底色) -->
        <Style x:Key="TopIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶栏关闭按钮专属样式 (悬浮平滑变红) -->
        <Style x:Key="CloseIconButtonStyle" TargetType="Button" BasedOn="{StaticResource TopIconButtonStyle}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C4101E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主窗口毛玻璃圆角容器 (1:1 还原概念图深邃亚克力外框) -->
    <Border x:Name="MainBorder"
            Background="#EB181C24" 
            BorderBrush="{DynamicResource WindowBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="16" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.65" Color="Black"/>
        </Border.Effect>

        <Grid Margin="16,10,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 顶栏极简微型控制行 -->
                <RowDefinition Height="Auto"/> <!-- 1. 居中流线型搜索框 -->
                <RowDefinition Height="Auto"/> <!-- 2. 胶囊分类选择器 -->
                <RowDefinition Height="*"/>    <!-- 3. 双列卡片网格列表 -->
                <RowDefinition Height="Auto"/> <!-- 4. 底部快捷指南 -->
            </Grid.RowDefinitions>

            <!-- 顶栏极简微型控制行 (完全消除粗大标题，保留缩小与关闭) -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧纯净拖拽区 -->
                <Rectangle Grid.Column="0" Fill="Transparent"/>

                <!-- 右侧极小幽灵控制组 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnQuickTheme" 
                            Content="🌙" 
                            Style="{StaticResource TopIconButtonStyle}"
                            Click="BtnQuickTheme_Click" 
                            ToolTip="切换白天明亮 / 夜间暗黑主题"
                            Margin="0,0,3,0"/>

                    <Button x:Name="BtnToggleSettings" 
                            Content="⚙" 
                            Style="{StaticResource TopIconButtonStyle}"
                            Click="BtnToggleSettings_Click" 
                            ToolTip="偏好设置与本地存储路径"
                            Margin="0,0,4,0"/>

                    <Button x:Name="BtnMinimizeWindow" 
                            Content="─" 
                            Style="{StaticResource TopIconButtonStyle}"
                            Click="BtnMinimizeWindow_Click" 
                            ToolTip="最小化窗口到任务栏 (缩小界面)"
                            Margin="0,0,3,0"/>

                    <Button x:Name="BtnCloseWindow" 
                            Content="✕" 
                            Style="{StaticResource CloseIconButtonStyle}"
                            Click="BtnCloseWindow_Click" 
                            ToolTip="关闭窗口 (收起到后台系统托盘，Alt+V 随时唤起)"/>
                </StackPanel>
            </Grid>

            <!-- 1. 居中流线型搜索框 (1:1 还原概念图) -->
            <Border x:Name="SearchBorder"
                    Grid.Row="1" 
                    Background="{DynamicResource SearchBgBrush}" 
                    BorderBrush="{DynamicResource SearchBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Margin="0,0,0,12" 
                    Height="40"
                    Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchInputBox" 
                             Grid.Column="0" 
                             Style="{x:Null}"
                             Background="Transparent" 
                             BorderThickness="0" 
                             Foreground="{DynamicResource TitleTextBrush}" 
                             CaretBrush="{DynamicResource TitleTextBrush}"
                             FontSize="13.5" 
                             VerticalAlignment="Center"
                             Padding="0,2"
                             TextChanged="SearchInputBox_TextChanged"
                             KeyDown="SearchInputBox_KeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="Transparent" BorderThickness="0">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Search history..." 
                               Grid.Column="0" 
                               Foreground="{DynamicResource SubTextBrush}" 
                               FontSize="13.5" 
                               IsHitTestVisible="False" 
                               VerticalAlignment="Center" 
                               Margin="2,0,0,0"/>

                    <TextBlock Grid.Column="1" Text="🔍" FontSize="13" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="6,0,2,0"/>
                </Grid>
            </Border>

            <!-- 2. 胶囊分类选择器 (1:1 还原概念图 All, Text, Images, Code, Starred) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
                <Button x:Name="TabAll" Content="📋  All" Tag="all" Click="TabCategory_Click" Margin="0,0,8,0" Padding="14,5" Background="#FF0078D4" Foreground="White" BorderThickness="0" FontSize="11.5" FontWeight="SemiBold">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabText" Content="≡  Text" Tag="Text" Click="TabCategory_Click" Margin="0,0,8,0" Padding="14,5" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource SubTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11.5">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabImages" Content="🖼  Images" Tag="Image" Click="TabCategory_Click" Margin="0,0,8,0" Padding="14,5" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource SubTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11.5">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabCode" Content="&lt;/&gt;  Code" Tag="Code" Click="TabCategory_Click" Margin="0,0,8,0" Padding="14,5" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource SubTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11.5">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabStarred" Content="⭐  Starred" Tag="pinned" Click="TabCategory_Click" Margin="0,0,8,0" Padding="14,5" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource SubTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11.5">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
            </StackPanel>

            <!-- 3. 双列卡片网格列表 (1:1 还原概念图双列排版与选中高亮发光) -->
            <Grid Grid.Row="3">
                <ListBox x:Name="CardsListBox" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single"
                          MouseDoubleClick="CardsListBox_MouseDoubleClick"
                          KeyDown="CardsListBox_KeyDown">
                    
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="5,5,5,5"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardBorder" 
                                                Background="{DynamicResource CardBgBrush}" 
                                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="12" 
                                                Padding="14,12" 
                                                MinHeight="140"
                                                MaxHeight="170"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- 1:1 概念图左上角第一张卡片：Fluent 蓝色外围微发光光晕 -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0078D4"/>
                                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5"/>
                                                <Setter TargetName="CardBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#0078D4" Opacity="0.55"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0078D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- 卡片顶栏：图标与角标 -->
                                    <RowDefinition Height="*"/>    <!-- 卡片主体：代码/图片/文本 -->
                                </Grid.RowDefinitions>

                                <!-- 卡片顶栏 (1:1 概念图：左侧类型微图标，右侧快捷序号[2]或三点菜单···) -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧类型微图标 (概念图精髓：代码{ / 图片🖼 / 文本❝ / 剪贴板📋) -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 代码卡片专属金黄色大括号 { -->
                                        <TextBlock Text="{}{" Foreground="#F59E0B" FontWeight="Bold" FontSize="14" FontFamily="Cascadia Code, Consolas"
                                                   Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}" 
                                                   Margin="0,-2,4,0"/>

                                        <!-- 图片卡片专属相框图标 🖼 -->
                                        <TextBlock Text="🖼" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" 
                                                   Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" 
                                                   Margin="0,0,4,0"/>

                                        <!-- 文本卡片专属浅灰色双引号 ❝ -->
                                        <TextBlock Text="❝" Foreground="{DynamicResource SubTextBrush}" FontSize="14" FontWeight="Bold" 
                                                   Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" 
                                                   Margin="0,-4,4,0"/>
                                    </StackPanel>

                                    <!-- 中间来源轻字提示 (低调融入) -->
                                    <TextBlock Grid.Column="1" Text="{Binding SourceApp}" Foreground="{DynamicResource SubTextBrush}" FontSize="9.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.5" Margin="4,0,0,0"/>

                                    <!-- 右侧快捷键角标 [1], [2] 与三点菜单 ··· (1:1 概念图) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 快捷角标 [2], [3] (概念图右侧同款) -->
                                        <Border Background="Transparent" Margin="0,0,5,0"
                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding DisplayBadge}" Foreground="{DynamicResource SubTextBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- 概念图右上角经典三点交互 ··· -->
                                        <Button Content="···" Tag="{Binding Id}" Click="ItemMenu_Click" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" FontSize="12" Cursor="Hand" ToolTip="快捷菜单 (置顶/复制/删除)" Opacity="0.8"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 卡片主体 (1:1 概念图呈现) -->
                                <Grid Grid.Row="1">
                                    <!-- 1. 代码卡片：真实 JSON/代码编辑器高亮质感 (1:1 还原概念图左上角) -->
                                    <Border Background="{DynamicResource CodeBgBrush}" CornerRadius="8" Padding="10,8" 
                                            Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}">
                                        <TextBlock helpers:CodeHighlighter.HighlightCode="{Binding Content}"
                                                   FontFamily="Cascadia Code, Consolas, Courier New" 
                                                   Foreground="{DynamicResource CodeTextBrush}" 
                                                   FontSize="11" 
                                                   LineHeight="16"
                                                   MaxHeight="95"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <!-- 2. 图片卡片：居中圆角桌面截图/缩略图预览 (1:1 还原概念图右上角) -->
                                    <Border Background="{DynamicResource CodeBgBrush}" CornerRadius="8" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{Binding ImagePreview}" MaxHeight="90" MaxWidth="240" Stretch="Uniform"/>
                                    </Border>

                                    <!-- 3. 纯文本卡片：优雅多行引语段落排版 (1:1 还原概念图左下角) -->
                                    <Border Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Content}" 
                                                   Foreground="{DynamicResource CardTextBrush}" 
                                                   FontSize="11.5" 
                                                   MaxHeight="95"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   LineHeight="17"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 4. 浮层设置面板 (1:1 还原概念图右下角 Settings 浮层) -->
                <Border x:Name="SettingsOverlayCard" 
                        Visibility="Collapsed" 
                        Background="{DynamicResource CardBgBrush}" 
                        BorderBrush="{DynamicResource WindowBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="14" 
                        Width="450" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Bottom" 
                        Margin="0,0,10,10" 
                        Padding="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.6" Color="Black"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- 顶栏与关闭设置 -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="⚙ Settings" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TitleTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="✕" Click="BtnCloseSettingsOverlay_Click" Background="Transparent" Foreground="{DynamicResource SubTextBrush}" BorderThickness="0" FontSize="12" HorizontalAlignment="Right" Cursor="Hand"/>
                        </Grid>

                        <!-- 自选存储路径 (1:1 还原概念图 Local Storage Path) -->
                        <TextBlock Text="Local Storage Path:" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0">
                                <TextBox x:Name="TxtSettingsStoragePath" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource CardTextBrush}" BorderThickness="0" Padding="8,5" FontSize="11.5"/>
                            </Border>
                            <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseStorage_Click" Background="#263142" Foreground="White" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,5" FontSize="11.5" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </Grid>

                        <!-- 本地状态提示卡片 (1:1 还原概念图蓝色圆圈信息提示) -->
                        <Border Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtStorageStatusInfo" 
                                       Text="ℹ Local SQLite status is active, 100% offline and stored at your local disk." 
                                       Foreground="{DynamicResource InfoTextBrush}" 
                                       FontSize="11" 
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- 主题与透明度调节 -->
                        <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🎨 界面外观与背景透明度：" Foreground="#0078D4" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RadioThemeDark" Grid.Column="0" GroupName="ThemeGroup" Content="🌙 暗黑夜间模式" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="ThemeRadio_Changed"/>
                                    <RadioButton x:Name="RadioThemeLight" Grid.Column="1" GroupName="ThemeGroup" Content="☀️ 白天明亮模式" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="ThemeRadio_Changed"/>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="透明度:" Foreground="{DynamicResource SubTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider x:Name="SliderOpacity" Grid.Column="1" Minimum="0.55" Maximum="1.00" Value="0.92" SmallChange="0.05" LargeChange="0.10" ValueChanged="SliderOpacity_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtOpacityValue" Grid.Column="2" Text="92%" Foreground="{DynamicResource CardTextBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 窗口关闭动作偏好 -->
                        <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="点击窗口右上角 [✕ 关闭] 时的动作：" Foreground="#0078D4" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                <RadioButton x:Name="RadioCloseMinimize" GroupName="CloseActionGroup" Content="最小化到系统托盘 (继续在后台常驻监听)" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Margin="0,0,0,4" Checked="CloseActionRadio_Changed"/>
                                <RadioButton x:Name="RadioCloseExit" GroupName="CloseActionGroup" Content="直接彻底退出 ClipVault 程序" Foreground="{DynamicResource CardTextBrush}" FontSize="11" Checked="CloseActionRadio_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- 底部维护按钮 -->
                        <Grid>
                            <Button Content="🛑 彻底退出程序" Click="BtnDirectExit_Click" Background="Transparent" Foreground="#F87171" BorderThickness="0" FontSize="11" HorizontalAlignment="Left" Cursor="Hand"/>
                            <Button Content="完成" Click="BtnCloseSettingsOverlay_Click" Background="#FF0078D4" Foreground="White" BorderThickness="0" Padding="16,5" FontSize="11.5" HorizontalAlignment="Right" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. 底部快捷键指南 -->
            <Grid Grid.Row="4" Margin="2,6,2,0">
                <TextBlock Text="[Alt+1~9] 数字秒贴  •  [Enter] 贴入  •  [↑↓] 导航  •  [Del] 删除  •  [Esc] 隐藏" 
                           Foreground="{DynamicResource SubTextBrush}" FontSize="10.5"/>
                <TextBlock x:Name="ToastText" Text="✓ 已贴入光标位置" Foreground="#34D399" FontSize="10.5" HorizontalAlignment="Right" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
