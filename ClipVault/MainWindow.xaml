<ui:FluentWindow x:Class="ClipVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="ClipVault - 剪贴板管理与本地隐私中心" 
        Height="650" Width="960"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 标题栏 -->
            <RowDefinition Height="*"/>    <!-- 主体 -->
        </Grid.RowDefinitions>

        <!-- 1. Fluent 原生标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="ClipVault - 剪贴板管理与本地隐私中心" Icon="{ui:SymbolIcon Symbol=ClipboardPaste24}" />

        <!-- 2. 主体选项卡容器 -->
        <TabControl Grid.Row="1" Margin="16,4,16,16" Background="Transparent" BorderThickness="0">
            
            <!-- 选项卡 1：历史与收藏深度管理 -->
            <TabItem Header="📋 历史与收藏记录" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/> <!-- 左侧卡片列表 -->
                        <ColumnDefinition Width="*"/>   <!-- 右侧大预览面板 -->
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：搜索 + 列表 -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 搜索与筛选 -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <ui:TextBox x:Name="MainSearchBox" 
                                        PlaceholderText="搜索历史内容或来源..." 
                                        Icon="{ui:SymbolIcon Symbol=Search24}"
                                        TextChanged="MainSearchBox_TextChanged"/>
                        </Grid>

                        <!-- 卡片列表 -->
                        <Border Grid.Row="1" Background="#16181E" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10">
                            <ListBox x:Name="MainHistoryList" 
                                     Background="Transparent" 
                                     BorderThickness="0"
                                     SelectionChanged="MainHistoryList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayBadge}" Foreground="#0078D4" FontWeight="Bold" Margin="0,0,6,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Summary}" Foreground="#EEE" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding SourceApp}" Foreground="#777" FontSize="10" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding FormattedTime}" Foreground="#666" FontSize="10"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="⭐" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" Foreground="#F59E0B" FontSize="11" Margin="4,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Border>
                    </Grid>

                    <!-- 右侧：详情查看与操作 -->
                    <Border Grid.Column="1" Background="#16181E" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- 元信息 -->
                                <RowDefinition Height="*"/>    <!-- 详情内容区 -->
                                <RowDefinition Height="Auto"/> <!-- 操作按钮栏 -->
                            </Grid.RowDefinitions>

                            <!-- 元数据信息栏 -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock x:Name="DetailHeaderTitle" Text="请选择左侧条目查看详情" FontSize="15" FontWeight="Bold" Foreground="#FFF"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="DetailMetaApp" Text="来源应用: -" Foreground="#888" FontSize="11" Margin="0,0,16,0"/>
                                    <TextBlock x:Name="DetailMetaTime" Text="捕获时间: -" Foreground="#888" FontSize="11" Margin="0,0,16,0"/>
                                    <TextBlock x:Name="DetailMetaChars" Text="字符/字节: -" Foreground="#888" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 详情内容展现 -->
                            <Border Grid.Row="1" Background="#101216" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <Grid>
                                        <!-- 文本/代码展示 -->
                                        <TextBox x:Name="DetailContentText" 
                                                 IsReadOnly="True" 
                                                 TextWrapping="Wrap" 
                                                 Background="Transparent" 
                                                 Foreground="#DCDCDC" 
                                                 BorderThickness="0" 
                                                 FontFamily="Consolas, Cascadia Code, Microsoft YaHei UI" 
                                                 FontSize="12"/>
                                        <!-- 图片展示 -->
                                        <Image x:Name="DetailContentImage" 
                                               Visibility="Collapsed" 
                                               Stretch="Uniform" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <!-- 操作按钮组 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnDetailCopy" Content="📋 复制到剪贴板" Click="BtnDetailCopy_Click" Margin="0,0,8,0" Padding="14,6"/>
                                <Button x:Name="BtnDetailPin" Content="⭐ 置顶切换" Click="BtnDetailPin_Click" Margin="0,0,8,0" Padding="14,6"/>
                                <Button x:Name="BtnDetailDelete" Content="🗑️ 删除记录" Click="BtnDetailDelete_Click" Padding="14,6" Foreground="#F87171"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 选项卡 2：本地存储与隐私配置 (核心卖点) -->
            <TabItem Header="⚙️ 本地存储与隐私设置" FontSize="13" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        
                        <!-- 核心区域：用户自选本地存储路径 -->
                        <Border Background="#16181E" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📁 本地数据存储路径 (User-Defined Local Storage)" FontSize="15" FontWeight="Bold" Foreground="#FFF" Margin="0,0,0,6"/>
                                <TextBlock Text="所有剪贴板历史与图片均完全保存在用户指定的本地硬盘中。如果选择保存在 OneDrive / 坚果云 同步目录下，即可实现全自动跨设备私有同步。" 
                                           Foreground="#888" FontSize="12" TextWrapping="Wrap"/>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="StoragePathTextBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnBrowseStoragePath" Grid.Column="1" Content="📂 更改保存目录..." Click="BtnBrowseStoragePath_Click" Padding="14,6"/>
                                </Grid>

                                <CheckBox x:Name="ChkAutoMigrate" Content="更改目录时自动将现有历史记录与缓存图片迁移至新位置" IsChecked="True" FontSize="12" Margin="0,4,0,0"/>

                                <!-- 存储健康状态卡片 -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#111317" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="SQLite 数据库" Foreground="#888" FontSize="11"/>
                                            <TextBlock x:Name="TxtDbSize" Text="0 MB" Foreground="#0078D4" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="TxtDbCounts" Text="0 条记录" Foreground="#AAA" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#111317" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="本地媒体缓存" Foreground="#888" FontSize="11"/>
                                            <TextBlock x:Name="TxtImgSize" Text="0 MB" Foreground="#10B981" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="TxtImgCounts" Text="0 张图片" Foreground="#AAA" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#111317" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="隐私安全级别" Foreground="#888" FontSize="11"/>
                                            <TextBlock Text="100% 离线" Foreground="#F59E0B" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock Text="零网络连接 • 无遥测" Foreground="#AAA" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 隐私安全与自动清洗规则 -->
                        <Border Background="#16181E" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🛡️ 隐私防护与过滤黑名单" FontSize="15" FontWeight="Bold" Foreground="#FFF" Margin="0,0,0,10"/>
                                
                                <CheckBox x:Name="ChkIgnorePassword" 
                                          Content="智能识别并自动忽略密码管理器窗口 (1Password, Bitwarden, KeePass, LastPass 等复制内容不计入历史)" 
                                          IsChecked="True" FontSize="12" Margin="0,0,0,8"/>

                                <CheckBox x:Name="ChkStartWithWindows" 
                                          Content="开机自动启动后台常驻" 
                                          FontSize="12" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="历史记录最大保留条数：" VerticalAlignment="Center" Foreground="#AAA" FontSize="12"/>
                                    <ComboBox x:Name="CmbMaxHistory" Width="120" Margin="10,0,0,0">
                                        <ComboBoxItem Content="500 条"/>
                                        <ComboBoxItem Content="1000 条" IsSelected="True"/>
                                        <ComboBoxItem Content="2000 条"/>
                                        <ComboBoxItem Content="5000 条"/>
                                        <ComboBoxItem Content="不限制"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 危险操作与清空 -->
                        <Border Background="#16181E" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="⚠️ 数据维护" FontSize="15" FontWeight="Bold" Foreground="#F87171" Margin="0,0,0,8"/>
                                <TextBlock Text="清空操作将永久删除本地非置顶的剪贴板历史与图片缓存文件。" Foreground="#888" FontSize="12" Margin="0,0,0,10"/>
                                <Button Content="🗑️ 清空所有非置顶本地记录" Click="BtnClearAll_Click" Foreground="#F87171" HorizontalAlignment="Left" Padding="16,6"/>
                            </StackPanel>
                        </Border>

                        <!-- 保存配置按钮 -->
                        <Button x:Name="BtnSaveSettings" Content="💾 保存并应用全部设置" Click="BtnSaveSettings_Click" Padding="20,8" FontWeight="Bold" Background="#0078D4" Foreground="White" HorizontalAlignment="Right"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</ui:FluentWindow>
