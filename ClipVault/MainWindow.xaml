<Window x:Class="ClipVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="ClipVault"
        Width="780" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MouseDown="Window_MouseDown">

    <!-- 主窗口毛玻璃圆角容器 (还原概念图设计) -->
    <Border Background="#E6161922" 
            BorderBrush="#334050" 
            BorderThickness="1" 
            CornerRadius="18" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 顶栏标题与窗口控制按钮 -->
                <RowDefinition Height="Auto"/> <!-- 搜索框 -->
                <RowDefinition Height="Auto"/> <!-- 胶囊分类选择器 -->
                <RowDefinition Height="*"/>    <!-- 双列卡片网格列表 -->
                <RowDefinition Height="Auto"/> <!-- 底部状态提示 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶栏：软件标志 + 痛点1专用控制按钮（最小化到托盘 vs 退出） -->
            <Grid Grid.Row="0" Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：图标与标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="#FF0078D4" Margin="0,0,8,0">
                        <TextBlock Text="📋" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ClipVault" FontWeight="Bold" FontSize="14" Foreground="#FFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#25FFFFFF" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="Alt + V 随时唤醒" FontSize="10" Foreground="#85B7EB"/>
                    </Border>
                </StackPanel>

                <!-- 右侧：显式控制按钮组（解决痛点 1） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 设置切换按钮 -->
                    <Button x:Name="BtnToggleSettings" 
                            Content="⚙️ 设置" 
                            Click="BtnToggleSettings_Click" 
                            Background="#1F242E" 
                            Foreground="#CCC" 
                            BorderBrush="#334050" 
                            BorderThickness="1" 
                            Padding="10,4" 
                            FontSize="11" 
                            Margin="0,0,6,0" 
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- 显式最小化到托盘按钮 -->
                    <Button x:Name="BtnMinimizeToTray" 
                            Content="🗕 最小化到托盘" 
                            Click="BtnMinimizeToTray_Click" 
                            Background="#1F242E" 
                            Foreground="#93C5FD" 
                            BorderBrush="#334050" 
                            BorderThickness="1" 
                            Padding="10,4" 
                            FontSize="11" 
                            Margin="0,0,6,0" 
                            ToolTip="隐藏并保持在后台系统托盘常驻运行"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- 关闭窗口按钮 -->
                    <Button x:Name="BtnCloseWindow" 
                            Content="✕ 关闭" 
                            Click="BtnCloseWindow_Click" 
                            Background="#2A1B1E" 
                            Foreground="#F87171" 
                            BorderBrush="#44252A" 
                            BorderThickness="1" 
                            Padding="10,4" 
                            FontSize="11" 
                            ToolTip="根据您的设置执行：最小化到托盘或彻底退出"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. 居中流线型搜索框 (还原设计图：右侧带搜索放大镜) -->
            <Border Grid.Row="1" 
                    Background="#13161F" 
                    BorderBrush="#283242" 
                    BorderThickness="1" 
                    CornerRadius="14" 
                    Margin="0,0,0,12" 
                    Padding="12,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchInputBox" 
                             Grid.Column="0" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             Foreground="#FFF" 
                             FontSize="13" 
                             VerticalAlignment="Center"
                             Padding="0,4"
                             TextChanged="SearchInputBox_TextChanged"
                             KeyDown="SearchInputBox_KeyDown"/>

                    <TextBlock Text="Search history... (支持 1~9 数字键秒贴)" 
                               Grid.Column="0" 
                               Foreground="#556070" 
                               FontSize="13" 
                               IsHitTestVisible="False" 
                               VerticalAlignment="Center" 
                               Margin="2,0,0,0"
                               Visibility="{Binding Text.IsEmpty, ElementName=SearchInputBox, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Grid.Column="1" Text="🔍" FontSize="13" Foreground="#667790" VerticalAlignment="Center" Margin="6,0,2,0"/>
                </Grid>
            </Border>

            <!-- 3. 胶囊分类选择器 (All, Text, Images, Code, Starred) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="TabAll" Content="📋 All" Tag="all" Click="TabCategory_Click" Margin="0,0,6,0" Padding="14,6" Background="#FF0078D4" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabText" Content="📝 Text" Tag="Text" Click="TabCategory_Click" Margin="0,0,6,0" Padding="14,6" Background="#1D222C" Foreground="#99A4B5" BorderBrush="#2C3646" BorderThickness="1" FontSize="11">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabImages" Content="🖼️ Images" Tag="Image" Click="TabCategory_Click" Margin="0,0,6,0" Padding="14,6" Background="#1D222C" Foreground="#99A4B5" BorderBrush="#2C3646" BorderThickness="1" FontSize="11">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabCode" Content="&lt;/&gt; Code" Tag="Code" Click="TabCategory_Click" Margin="0,0,6,0" Padding="14,6" Background="#1D222C" Foreground="#99A4B5" BorderBrush="#2C3646" BorderThickness="1" FontSize="11">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
                <Button x:Name="TabStarred" Content="⭐ Starred" Tag="pinned" Click="TabCategory_Click" Margin="0,0,6,0" Padding="14,6" Background="#1D222C" Foreground="#99A4B5" BorderBrush="#2C3646" BorderThickness="1" FontSize="11">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                </Button>
            </StackPanel>

            <!-- 4. 双列卡片瀑布流网格 (还原概念图中的双列卡片布局) -->
            <Grid Grid.Row="3">
                <ListBox x:Name="CardsListBox" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single"
                         MouseDoubleClick="CardsListBox_MouseDoubleClick"
                         KeyDown="CardsListBox_KeyDown">
                    
                    <!-- 双列网格布局模板 -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardBorder" 
                                                Background="#181C25" 
                                                BorderBrush="#283242" 
                                                BorderThickness="1" 
                                                CornerRadius="12" 
                                                Padding="12"
                                                MinHeight="130"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0078D4"/>
                                                <Setter TargetName="CardBorder" Property="Background" Value="#222B3A"/>
                                                <Setter TargetName="CardBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#0078D4" Opacity="0.4"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#4C607C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- 卡片顶栏：快捷键徽标 + 来源与置顶 -->
                                    <RowDefinition Height="*"/>    <!-- 卡片主体：代码 / 图片 / 文本 -->
                                    <RowDefinition Height="Auto"/> <!-- 卡片底栏：时间戳与粘贴提示 -->
                                </Grid.RowDefinitions>

                                <!-- 卡片顶栏 -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 数字快捷键徽章 [1], [2]... -->
                                    <Border Grid.Column="0" 
                                            Background="#202836" 
                                            BorderBrush="#384860" 
                                            BorderThickness="1" 
                                            CornerRadius="5" 
                                            Padding="6,1" 
                                            Margin="0,0,6,0">
                                        <TextBlock Text="{Binding DisplayBadge}" Foreground="#60A5FA" FontWeight="Bold" FontSize="10"/>
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding SourceApp}" Foreground="#718096" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="⭐" Tag="{Binding Id}" Click="PinItem_Click" Background="Transparent" BorderThickness="0" FontSize="12" Margin="0,0,2,0" Cursor="Hand" ToolTip="置顶/取消置顶"/>
                                        <Button Content="🗑️" Tag="{Binding Id}" Click="DeleteItem_Click" Background="Transparent" BorderThickness="0" FontSize="11" Opacity="0.6" Cursor="Hand" ToolTip="删除"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 卡片主体 -->
                                <Grid Grid.Row="1" Margin="0,2,0,6">
                                    <!-- 1. 代码卡片：暗黑编辑器语法风格 -->
                                    <Border Background="#11141B" CornerRadius="8" Padding="8,6" 
                                            Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Content}" 
                                                   FontFamily="Consolas, Cascadia Code, Courier New" 
                                                   Foreground="#34D399" 
                                                   FontSize="11" 
                                                   MaxHeight="70"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <!-- 2. 图片卡片：圆角截图缩略图预览 -->
                                    <Border Background="#11141B" CornerRadius="8" Padding="3" HorizontalAlignment="Center"
                                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{Binding FullImagePath}" MaxHeight="75" MaxWidth="280" Stretch="Uniform"/>
                                    </Border>

                                    <!-- 3. 纯文本卡片：引语/摘要风格 -->
                                    <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="“" Foreground="#4A5568" FontSize="18" LineHeight="12" Margin="0,-4,0,0"/>
                                        <TextBlock Text="{Binding Content}" 
                                                   Foreground="#E2E8F0" 
                                                   FontSize="12" 
                                                   MaxHeight="60"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   LineHeight="16"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 卡片底栏 -->
                                <Grid Grid.Row="2" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding FormattedTime}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="Enter 粘贴 ↵" Foreground="#0078D4" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 5. 浮层设置面板 (还原设计图右下角的 Settings Panel) -->
                <Border x:Name="SettingsOverlayCard" 
                        Visibility="Collapsed" 
                        Background="#E6181C26" 
                        BorderBrush="#38465A" 
                        BorderThickness="1" 
                        CornerRadius="14" 
                        Width="440" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Bottom" 
                        Margin="0,0,10,10" 
                        Padding="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- 顶栏与关闭设置 -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="⚙️ Settings (本地存储与运行控制)" FontWeight="Bold" FontSize="13" Foreground="#FFF" VerticalAlignment="Center"/>
                            <Button Content="✕" Click="BtnCloseSettingsOverlay_Click" Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="12" HorizontalAlignment="Right" Cursor="Hand"/>
                        </Grid>

                        <!-- 自选存储路径 -->
                        <TextBlock Text="Local Storage Path (本地存储路径):" Foreground="#AAA" FontSize="11" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#11131A" BorderBrush="#334050" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0">
                                <TextBox x:Name="TxtSettingsStoragePath" IsReadOnly="True" Background="Transparent" Foreground="#EEE" BorderThickness="0" Padding="6,4" FontSize="11"/>
                            </Border>
                            <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseStorage_Click" Background="#FF0078D4" Foreground="White" BorderThickness="0" Padding="10,4" FontSize="11" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>

                        <!-- 解决痛点 1：窗口关闭动作偏好 -->
                        <Border Background="#13161F" BorderBrush="#263140" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="点击窗口右上角 [✕ 关闭] 时的动作：" Foreground="#93C5FD" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                <RadioButton x:Name="RadioCloseMinimize" GroupName="CloseActionGroup" Content="最小化到系统托盘 (继续在后台常驻监听)" Foreground="#DDD" FontSize="11" Margin="0,0,0,4" Checked="CloseActionRadio_Changed"/>
                                <RadioButton x:Name="RadioCloseExit" GroupName="CloseActionGroup" Content="直接彻底退出 ClipVault 程序" Foreground="#DDD" FontSize="11" Checked="CloseActionRadio_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- 本地状态提示卡片 (完全契合设计图中的 Blue Info Badge) -->
                        <Border Background="#162234" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtStorageStatusInfo" 
                                       Text="ℹ Local SQLite status is active, 100% offline and stored at your local disk." 
                                       Foreground="#60A5FA" 
                                       FontSize="11" 
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- 底部维护按钮 -->
                        <Grid>
                            <Button Content="🛑 彻底退出程序" Click="BtnDirectExit_Click" Background="Transparent" Foreground="#F87171" BorderThickness="0" FontSize="11" HorizontalAlignment="Left" Cursor="Hand"/>
                            <Button Content="完成" Click="BtnCloseSettingsOverlay_Click" Background="#FF0078D4" Foreground="White" BorderThickness="0" Padding="14,4" FontSize="11" HorizontalAlignment="Right" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. 底部快捷键指南 -->
            <Grid Grid.Row="4" Margin="4,8,4,0">
                <TextBlock Text="[1~9] 数字秒贴  •  [Enter] 贴入  •  [↑↓] 导航  •  [Del] 删除  •  [Esc] 隐藏" 
                           Foreground="#64748B" FontSize="11"/>
                <TextBlock x:Name="ToastText" Text="✓ 已贴入光标位置" Foreground="#34D399" FontSize="11" HorizontalAlignment="Right" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
