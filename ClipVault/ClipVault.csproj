<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>NU1701</NoWarn>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <AssemblyName>CopyBox</AssemblyName>
    <Product>CopyBox</Product>
    <AssemblyTitle>CopyBox</AssemblyTitle>
    <Version>2.2.1</Version>
    <FileVersion>2.2.1.0</FileVersion>
    <AssemblyVersion>2.2.1.0</AssemblyVersion>
    <Description>CopyBox - 现代化、100% 纯本地离线、高颜值的 Windows 剪贴板与效率抽屉助手</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 移除 Windows.Forms 和 System.Drawing 全局隐式命名空间，避免与 WPF 的 Application/Button/Brush/Color 冲突 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
